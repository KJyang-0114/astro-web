{
  "name": "kjyang-wbs-astro",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0 --port 3000",
    "astro": "astro",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "astro check --minimumFailingSeverity warning",
    "check": "npm run lint && npm run typecheck && npm run build && npm run verify:static",
    "check:fast": "node scripts/check-fast.mjs",
    "verify:site": "npm run build && node scripts/verify-site.mjs && node scripts/verify-resume-language.mjs && node scripts/verify-discovery.mjs",
    "verify:motion": "node scripts/verify-wire-art.mjs",
    "verify:studio": "npm run build && node scripts/verify-studio.mjs",
    "verify:seo": "npm run build && node scripts/verify-seo.mjs",
    "verify:static": "node scripts/verify-site.mjs && node scripts/verify-resume-language.mjs && node scripts/verify-discovery.mjs && node scripts/verify-studio.mjs && node scripts/verify-seo.mjs && node scripts/verify-wire-art.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "og-images": "node scripts/generate-og-images.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.0",
    "@fontsource/baloo-2": "^5.2.7",
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/geist-sans": "^5.2.5",
    "@fontsource/josefin-sans": "^5.2.8",
    "@fontsource/lexend": "^5.2.11",
    "@fontsource/noto-serif-tc": "^5.2.10",
    "@tailwindcss/vite": "^4.1.17",
    "astro": "^5.4.1",
    "gsap": "^3.15.0",
    "tailwindcss": "^4.1.17",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.180.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
