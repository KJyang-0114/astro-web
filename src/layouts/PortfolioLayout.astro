---
import "../styles/design-system.css";
import "../styles/portfolio.css";
import Navigation from "../components/portfolio/Navigation.astro";
import Footer from "../components/portfolio/Footer.astro";
interface Props {
  title: string;
  description: string;
  jsonLd?: object;
  noindex?: boolean;
  lang?: "zh-Hant" | "en";
  resumeLanguages?: boolean;
  // 有中英兩版的頁面：hreflang → 完整網址，兩頁要給同一組（含 x-default）。
  alternates?: Array<[string, string]>;
  ogType?: "website" | "profile" | "article";
}
const { title, description, jsonLd, noindex = false, lang = "zh-Hant", resumeLanguages = false, ogType = "website" } = Astro.props;
const alternates = resumeLanguages
  ? [
      ["zh-Hant", "https://kjyang0114.dev/resume"],
      ["en", "https://kjyang0114.dev/en/resume"],
      ["x-default", "https://kjyang0114.dev/resume"],
    ]
  : Astro.props.alternates ?? [];
const ogImage = "https://kjyang0114.dev/og-portfolio.png";
const ogImageAlt = "楊凱捷 KJyang：Human, then Code. AI、Web 與自動化作品。";
const canonical = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", "https://kjyang0114.dev").href;
---

<!doctype html>
<html lang={lang}>
  <head
    ><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width,initial-scale=1"
    /><meta name="color-scheme" content="light dark" /><title>
      {title}
    </title><meta name="description" content={description} />{!noindex && <link
      rel="canonical"
      href={canonical}
    />}<link rel="icon" href="/favicon-portfolio.svg" type="image/svg+xml" /><meta
      property="og:type"
      content={ogType}
    /><meta property="og:locale" content={lang === "en" ? "en_US" : "zh_TW"} /><meta
      property="og:site_name"
      content="KJyang"
    /><meta property="og:title" content={title} /><meta
      property="og:description"
      content={description}
    /><meta property="og:url" content={canonical} /><meta
      property="og:image"
      content={ogImage}
    /><meta property="og:image:type" content="image/png" />{<meta name="robots" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large"} />}<meta
      property="og:image:width"
      content="1200"
    /><meta property="og:image:height" content="630" /><meta
      property="og:image:alt"
      content={ogImageAlt}
    /><meta name="twitter:card" content="summary_large_image" /><meta
      name="twitter:title"
      content={title}
    /><meta name="twitter:description" content={description} /><meta
      name="twitter:image"
      content={ogImage}
    /><meta name="twitter:image:alt" content={ogImageAlt} />{
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
        />
      )
    }
    {alternates.map(([hreflang, href]) => <link rel="alternate" hreflang={hreflang} href={href} />)}
    <slot name="head" />
    </head
  ><body class="portfolio" id="top"
    ><a class="skip-link" href="#main">{lang === "en" ? "Skip to content" : "跳到內容"}</a><Navigation english={lang === "en"} /><main
      id="main"
    >
      <slot />
    </main><Footer english={lang === "en"} /></body>
</html>
