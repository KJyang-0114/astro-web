---
import StudioNav from "@components/StudioNav.astro";
import SiteShell from "@components/SiteShell.astro";
import { studioFacts } from "@data/studio";

const systems = [
  ["01", "Design and code", "I decide what goes on the first screen based on what your customers ask most, then write the code myself. No Wix or WordPress templates. Every site is tested on real phones and inside LINE's in-app browser."],
  ["02", "Booking and admin tools", "Online appointment requests, staff schedules and simple admin pages. I built one for Weilspa, a beauty spa with two branches: customers request a time slot, the owners confirm it from their phones."],
  ["03", "Launch and care", "I buy and set up the domain (registered in your name), DNS and HTTPS. After launch, send me a message on LINE when you need a price or photo changed."]
];

const demos = [
  ["Home Service", "A layout for repair and home-service businesses: quote request, service area, price guide and FAQ.", "/studio/en/demo/home-service"],
  ["Dental Clinic", "A layout for a small clinic: first-visit steps, treatment list, location and FAQ.", "/studio/en/demo/dental-clinic"]
];

const proof = [
  ["Prices are published", `A one-page site starts at ${studioFacts.startPrice}. The written quote lists every page, the timeline and what is not included.`],
  ["The domain is yours", "Domain and hosting accounts are registered in your name. The code uses common tools (Astro, Next.js) and comes with notes, so another developer can take it over."],
  ["No ranking promises", "Basic search setup is included, but nobody can guarantee Google rankings, and I won't."]
];

const launchChecks = ["Real phones", "LINE in-app browser", "Contact buttons", "Page titles", "Sitemap", "Domain", "HTTPS", "Auto deploy"];
---

<SiteShell
  title="KJyang Studio | Websites and Booking Systems for Small Businesses in Taiwan"
  description="Kai-Jie Yang, a high-school senior in New Taipei, Taiwan, designs, codes, launches and maintains websites and booking systems for small businesses. Based in northern Taiwan, works online. One-page sites from NT$18,000."
  canonicalPath="/studio/en"
  lang="en"
  alternates={[
    { hrefLang: "zh-Hant", href: "/studio" },
    { hrefLang: "en", href: "/studio/en" },
    { hrefLang: "x-default", href: "/studio/en" }
  ]}
>
  <main class="en-premium">
    <StudioNav />

    <section class="en-premium-hero">
      <div class="en-premium-wrap en-premium-hero-grid">
        <div class="en-premium-copy">
          <span>Kai-Jie Yang · New Taipei, Taiwan · works online</span>
          <h1>Websites and booking systems for small businesses, built by one person.</h1>
          <p>
            I'm Kai-Jie Yang, a high-school senior in New Taipei, Taiwan. I design, code, launch and maintain websites for small shops, studios and local services. I'm based in northern Taiwan and work online. One-page sites start at {studioFacts.startPrice}.
          </p>
          <div class="en-premium-actions">
            <a class="en-premium-btn primary" href="/studio/en/contact">Contact me</a>
            <a class="en-premium-btn secondary" href="/studio/en/services">View services</a>
          </div>
        </div>

        <aside class="en-premium-board" aria-label="Project system preview">
          <div class="en-premium-board-top">
            <span>What you get</span>
            <b>One person, start to finish</b>
          </div>
          <div class="en-premium-window">
            <div class="en-premium-window-title">
              <span></span><span></span><span></span>
              <small>studio / build / launch</small>
            </div>
            <div class="en-premium-window-body">
              <article>
                <small>Positioning</small>
                <b>What you do, where, and how much, on the first screen</b>
              </article>
              <article>
                <small>Contact</small>
                <b>LINE, phone and map buttons that work on phones</b>
              </article>
              <article>
                <small>Delivery</small>
                <b>Code, domain, HTTPS, updates after launch</b>
              </article>
            </div>
          </div>
          <div class="en-premium-mini">
            <span>Design</span>
            <span>Code</span>
            <span>Deploy</span>
          </div>
        </aside>
      </div>
    </section>

    <section class="en-premium-system">
      <div class="en-premium-wrap en-premium-section-head">
        <span>What I do</span>
        <h2>Design, code, launch and care, all done by me.</h2>
      </div>
      <div class="en-premium-wrap en-premium-system-grid">
        {systems.map(([num, title, text]) => (
          <article>
            <span>{num}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="en-premium-demos">
      <div class="en-premium-wrap en-premium-section-head light">
        <span>Demo directions</span>
        <h2>Two sample websites with fictional brands.</h2>
        <p>These businesses are made up and are not clients. They show how a layout can change by industry. My real projects are on the <a href="/studio/work">work page</a> (in Chinese).</p>
      </div>
      <div class="en-premium-wrap en-premium-demo-grid">
        {demos.map(([title, text, href]) => (
          <a class="en-premium-demo" href={href}>
            <div>
              <span>Sample website</span>
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
            <b>Open demo</b>
          </a>
        ))}
      </div>
    </section>

    <section class="en-premium-proof">
      <div class="en-premium-wrap en-premium-proof-grid">
        <div>
          <span>How I work</span>
          <h2>Clear prices, your own accounts, no ranking promises.</h2>
          <p>You talk directly to the person who builds the site. My own site runs on a Mac mini with Docker behind Cloudflare and deploys automatically through GitHub Actions, and I look after client sites the same way.</p>
        </div>
        <div class="en-premium-proof-list">
          {proof.map(([title, text]) => (
            <article>
              <b>{title}</b>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="en-premium-launch">
      <div class="en-premium-wrap en-premium-launch-panel">
        <div>
          <span>Launch checklist</span>
          <h2>What I check before a site goes live.</h2>
        </div>
        <ul>
          {launchChecks.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="en-premium-final">
      <div class="en-premium-wrap en-premium-final-grid">
        <div>
          <span>Next step</span>
          <h2>Send me your shop name or current website.</h2>
          <p>I'll take a look for free and reply with 3 things you could change right away, and which plan would fit. Chinese or English is fine.</p>
        </div>
        <div class="en-premium-actions">
          <a class="en-premium-btn primary" href="/studio/en/contact">Contact me</a>
          <a class="en-premium-btn secondary dark" href="/studio/en/pricing">View pricing</a>
        </div>
      </div>
    </section>
  </main>
</SiteShell>
