---
import StudioNav from "@components/StudioNav.astro";
import SiteShell from "@components/SiteShell.astro";
import { studioContact } from "@data/studio";
---

<SiteShell title="Contact | KJyang Studio" description="Contact Kai-Jie Yang on LINE or by email about a website or booking system for your small business. LINE is checked daily from 10:00 to 22:00." canonicalPath="/studio/en/contact" lang="en">
  <main class="studio-en-v2 en-subpage">
    <StudioNav />
    <section class="en-v2-hero en-page-hero">
      <div class="en-v2-wrap en-v2-hero-grid">
        <div class="en-v2-copy">
          <span class="en-v2-kicker">Contact</span>
          <h1>Send me your shop name or website first.</h1>
          <p>Tell me what your business does and send your current website or Instagram. I'll look at it for free and reply with 3 things you could change right away. I check LINE every day from 10:00 to 22:00; how fast I reply depends on whether I'm free at the time. Email: {studioContact.email}</p>
          <div class="en-v2-actions">
            <a class="en-v2-btn en-v2-btn-primary" href={studioContact.lineUrl}>LINE contact</a>
            <a class="en-v2-btn en-v2-btn-secondary" href="/studio/en/demo">View demos</a>
          </div>
        </div>
        <div class="line-contact-card studio-real-contact">
          <div class="line-qr"><img src={studioContact.lineQr} alt="LINE QR code for Kai-Jie Yang" /></div>
          <div><b>LINE ID</b><strong>{studioContact.lineId}</strong><p>LINE is the fastest way to reach me. Send links or screenshots.</p></div>
        </div>
      </div>
    </section>
  </main>
</SiteShell>
