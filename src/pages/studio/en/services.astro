---
import StudioNav from "@components/StudioNav.astro";
import SiteShell from "@components/SiteShell.astro";
---

<SiteShell
  title="Services | KJyang Studio"
  description="Kai-Jie Yang designs, codes, launches and maintains websites and booking systems for small businesses in Taiwan. Based in northern Taiwan, works online."
  canonicalPath="/studio/en/services"
  lang="en"
  alternates={[
    { hrefLang: "zh-Hant", href: "/studio/services" },
    { hrefLang: "en", href: "/studio/en/services" },
    { hrefLang: "x-default", href: "/studio/en/services" }
  ]}
>
  <main class="studio-en-v2 en-subpage">
    <StudioNav />
    <section class="en-v2-hero en-page-hero">
      <div class="en-v2-wrap en-v2-hero-grid">
        <div class="en-v2-copy">
          <span class="en-v2-kicker">Services</span>
          <h1>Websites, booking systems, hosting and care.</h1>
          <p>I'm one person, based in northern Taiwan and working online. I design and code the site myself, set up the domain and hosting, and keep it running after launch. One-page sites start at NT$18,000 and take about 2 to 3 weeks.</p>
        </div>
        <div class="en-service-stack">
          {["Website design", "Frontend code, no templates", "Online booking and admin pages", "Domain, hosting and HTTPS", "Updates after launch"].map((item) => <b>{item}</b>)}
        </div>
      </div>
    </section>
  </main>
</SiteShell>
