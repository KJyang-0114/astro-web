---
import { studioPageMeta } from "@data/seo";
import StudioNav from "@components/StudioNav.astro";
import SiteShell from "@components/SiteShell.astro";
import { absoluteStudioUrl, founderPerson, studioOrganizationId } from "@data/seo";
import { fitChecks, studioBeliefs } from "@data/trust";
import { studioContact, studioFacts } from "@data/studio";
import { realCases } from "@data/cases";

const schema = [{
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: "關於楊凱捷與 KJyang Studio",
  url: absoluteStudioUrl("/studio/about"),
  inLanguage: "zh-Hant",
  mainEntity: founderPerson,
  about: { "@id": studioOrganizationId }
}];
---
<SiteShell title={studioPageMeta["/studio/about"].title} description={studioPageMeta["/studio/about"].description} canonicalPath="/studio/about" schema={schema} breadcrumbs={[["KJyang Studio", "/studio"], ["關於我", "/studio/about"]]}>
  <main class="studio-index s-case">
    <StudioNav />
    <header class="s-wrap s-case-hero">
      <p class="s-eyebrow">關於我</p>
      <h1>我是楊凱捷，KJyang Studio 只有我一個人</h1>
      <p class="s-lead">鶯歌工商資訊科高三。我自學寫網站和架主機，做過完全遠端的軟體開發工作。現在一邊上學，一邊幫小店做網站和預約系統。</p>
    </header>
    <div class="s-wrap s-case-body">
      <div>
        <section>
          <h2>為什麼接案</h2>
          <p>幫 Weilspa 做預約系統的時候，我發現兩位老闆最在意的是每天少回幾則 LINE、改價格不用等人，網站漂不漂亮反而排在後面。小店需要的通常是一個講得清楚、價格公開、做完還找得到的人，這件事我做得到。</p>
          <p>學生身份我不打算藏。你找我，得到的是比較彈性的時間、公開的價格，還有直接跟寫程式的人講話。代價是我還在上學，訊息不一定馬上回，但每天上午 10 點到晚上 10 點之間會看。</p>
        </section>
        <section>
          <h2>我做過的</h2>
          {realCases.map((c) => <p><a class="s-link" href={`/studio/work/${c.slug}`}>{c.name}</a>：{c.kind}。{c.status}。</p>)}
          <p>另外，我在一家教育科技公司做過完全遠端的軟體開發，負責前端、後端和 AI 功能串接。細節可以看<a class="s-link" href="/resume">我的履歷</a>。</p>
        </section>
        <section>
          <h2>適不適合找我</h2>
          {fitChecks.map(([t, d]) => <p><b>{t}：</b>{d}</p>)}
        </section>
      </div>
      <aside class="s-side">
        <h2>我會寫進報價單的事</h2>
        <ul>{studioBeliefs.map((b) => <li><b>{b.title}</b>：{b.text}</li>)}</ul>
        <h2>怎麼找我</h2>
        <p class="s-fine">LINE ID {studioContact.lineId}・電話 {studioContact.phone}<br />{studioFacts.reply}<br />{studioFacts.area}</p>
        <a class="s-btn s-btn-primary" href={studioContact.lineUrl} data-cta="about-line">LINE 傳給我</a>
      </aside>
    </div>
  </main>
</SiteShell>
