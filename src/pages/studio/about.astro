---
import StudioNav from "@components/StudioNav.astro";
import SiteShell from "@components/SiteShell.astro";
import { absoluteStudioUrl } from "@data/seo";
import { fitChecks, studioBeliefs } from "@data/trust";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    name: "About KJyang Studio",
    url: absoluteStudioUrl("/studio/about"),
    inLanguage: "zh-Hant",
    about: {
      "@type": "Organization",
      name: "KJyang Studio",
      url: absoluteStudioUrl("/studio")
    }
  }
];
---

<SiteShell
  title="關於 KJyang Studio | 網站設計、代碼與部署"
  description="KJyang Studio 是小型網站工作室，主打網站設計、前端代碼編寫、部署上線、主機設定與後續維護。"
  canonicalPath="/studio/about"
  schema={schema}
>
  <main class="studio-index">
    <StudioNav />

    <section class="about-hero">
      <div class="wrap about-hero-grid">
        <div>
          <span>About KJyang Studio</span>
          <h1>設計的細節，和上線之後。</h1>
        </div>
        <p>
          我是楊凱捷，KJyang Studio 由我負責設計與開發。從內容整理、視覺細節，到網站製作、部署與後續維護，希望每個階段都清楚、有交代。
        </p>
      </div>
    </section>

    <section class="belief-section">
      <div class="wrap belief-grid">
        {studioBeliefs.map((item, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h2>{item.title}</h2>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="fit-section">
      <div class="wrap fit-grid">
        <div>
          <span>Fit check</span>
          <h2>先確認彼此的期待。</h2>
          <p>一起確認需求、預算與時間，讓設計和交付都有共同的方向。</p>
        </div>
        <div>
          {fitChecks.map(([title, text]) => (
            <article>
              <b>{title}</b>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="studio-final-cta">
      <div class="wrap">
        <span>Start with context</span>
        <h2>先傳目前狀況，不用一開始就講很完整。</h2>
        <p>可以先傳行業、目前網站、參考風格、預算範圍和想做的頁面。我會先判斷適合哪種方案。</p>
        <div class="action-row">
          <a class="btn studio-index-primary" href="/studio/contact">聯絡 KJyang Studio</a>
          <a class="btn studio-index-secondary" href="/studio/work">看作品案例</a>
        </div>
      </div>
    </section>
  </main>
</SiteShell>
