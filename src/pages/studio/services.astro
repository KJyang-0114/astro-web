---
import { studioPageMeta } from "@data/seo";
import StudioNav from "@components/StudioNav.astro";
import SiteShell from "@components/SiteShell.astro";
import { absoluteStudioUrl, studioOrganizationId } from "@data/seo";
import { studioContact, studioFacts, studioServices } from "@data/studio";
import { servicePages } from "@data/trust";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "小店網站與預約系統製作",
    description: "楊凱捷一人接案：網站設計、前端製作、網域與主機設定、線上預約與後台、上線後維護。一頁式網站 NT$18,000 起。",
    url: absoluteStudioUrl("/studio/services"),
    "@id": `${absoluteStudioUrl("/studio/services")}#service`,
    provider: { "@id": studioOrganizationId },
    areaServed: studioFacts.areaServed,
    serviceType: studioServices.map((s) => s.title),
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "服務項目",
      itemListElement: servicePages.map((s) => ({
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: s.title,
          description: s.description,
          url: absoluteStudioUrl(`/studio/services/${s.slug}`)
        }
      }))
    }
  }
];
---
<SiteShell title={studioPageMeta["/studio/services"].title} description={studioPageMeta["/studio/services"].description} canonicalPath="/studio/services" schema={schema} breadcrumbs={[["KJyang Studio", "/studio"], ["服務", "/studio/services"]]}>
  <main class="studio-index s-case">
    <StudioNav />
    <header class="s-wrap s-case-hero">
      <p class="s-eyebrow">服務</p>
      <h1>我可以幫你做的事</h1>
      <p class="s-lead">從決定首頁放什麼、寫程式、買網域，到上線後改價格換照片，都是我一個人做。你不用分別找設計師、工程師和主機商。</p>
      <ul class="s-hero-facts">
        <li><b>{studioFacts.startPrice} 起</b>一頁式網站</li>
        <li><b>{studioFacts.onePageWeeks}</b>資料給齊後上線</li>
        <li><b>{studioFacts.areaShort}</b>每天 {studioFacts.replyShort} 看 LINE</li>
      </ul>
    </header>

    <section class="s-wrap s-section" aria-labelledby="what-title">
      <div class="s-head"><p class="s-eyebrow">我做的部分</p><h2 id="what-title">一個網站從頭到尾的 5 件事</h2></div>
      <ul class="s-svc-list">
        {studioServices.map((s) => <li><b>{s.title}</b><p>{s.text}</p></li>)}
      </ul>
    </section>

    <section class="s-wrap s-section" aria-labelledby="pick-title">
      <div class="s-head"><p class="s-eyebrow">看你現在的情況</p><h2 id="pick-title">你是哪一種？</h2></div>
      <div class="s-svc-links">
        {servicePages.map((s) => (
          <a class="s-case-card" href={`/studio/services/${s.slug}`}>
            <h3>{s.title}</h3>
            <p>{s.description}</p>
            <b>看我會怎麼做 →</b>
          </a>
        ))}
      </div>
      <p class="s-more-link"><a href="/studio/work/spa-booking-system">需要線上預約？看我幫 Weilspa 做的預約與排班系統 →</a></p>
    </section>

    <section class="s-wrap s-cta-band">
      <h2>不確定是哪一種也沒關係</h2>
      <p>{studioFacts.freeCheck}</p>
      <div class="s-actions">
        <a class="s-btn s-btn-primary" href={studioContact.lineUrl} data-cta="services-line">LINE 傳店名給我</a>
        <a class="s-btn" href="/studio/pricing">看價格和包含什麼</a>
      </div>
    </section>
  </main>
</SiteShell>
