---
import { studioPageMeta } from "@data/seo";
import StudioNav from "@components/StudioNav.astro";
import SiteShell from "@components/SiteShell.astro";
import { studioContact, studioFacts } from "@data/studio";
import { absoluteStudioUrl, studioOrganizationId } from "@data/seo";

const schema = [{
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "聯絡楊凱捷（KJyang Studio）",
  url: absoluteStudioUrl("/studio/contact"),
  inLanguage: "zh-Hant",
  about: { "@id": studioOrganizationId }
}];
---

<SiteShell title={studioPageMeta["/studio/contact"].title} description={studioPageMeta["/studio/contact"].description} canonicalPath="/studio/contact" schema={schema} breadcrumbs={[["KJyang Studio", "/studio"], ["聯絡", "/studio/contact"]]}>
  <main class="studio-index">
    <StudioNav />
    <section class="studio-contact-page">
      <div class="wrap contact-grid">
        <div>
          <span>聯絡我</span>
          <h1>傳這三樣給我就好</h1>
          <ol class="s-plan-list"><li>店名</li><li>現在的網站、IG 或 Google 地圖連結（沒有也沒關係）</li><li>你最想解決的一件事，例如「客人一直問價格」</li></ol>
          <p>{studioFacts.freeCheck}</p>
          <p>{studioFacts.reply}。{studioFacts.area}。</p>
          <aside class="line-contact-card studio-real-contact">
            <div class="line-qr" aria-label="KJyang Studio LINE QR code">
              <img src={studioContact.lineQr} alt="KJyang Studio LINE QR code" width="900" height="900" loading="lazy" />
            </div>
            <div>
              <b>LINE / PHONE</b>
              <strong>{studioContact.lineId}</strong>
              <p>電話：{studioContact.phone}（上課時間可能接不到，留言或傳 LINE 比較快）<br />Email：<a href={`mailto:${studioContact.email}`}>{studioContact.email}</a></p>
            </div>
          </aside>
          <div class="action-row">
            <a class="btn studio-index-primary" href={studioContact.lineUrl} data-cta="contact-line">LINE 聯絡</a>
            <a class="btn studio-index-secondary" href={`tel:${studioContact.phone}`}>電話聯絡</a>
          </div>
        </div>
        <form class="contact-form" data-line-url={studioContact.lineUrl}><p>不想自己打字的話：填好按「複製需求」，再打開 LINE 貼上送出。這個表單不會自動寄出。</p>
          <label class="field">
            姓名 / 店名
            <input name="name" autocomplete="name" />
          </label>
          <label class="field">
            網站、IG 或地圖連結
            <input name="industry" />
          </label>
          <label class="field">
            預算區間
            <select name="budget">
              <option>還不確定</option><option>NT$18,000 - 28,000</option>
              <option>NT$35,000 - 58,000</option>
              <option>需要預約或其他功能</option>
            </select>
          </label>
          <label class="field">
            最想解決的事
            <textarea name="message" rows="5" required maxlength="3000"></textarea>
          </label>
          <button class="btn studio-index-primary" type="button">複製需求</button>
        </form>
      </div>
    </section>
  </main>
</SiteShell>
