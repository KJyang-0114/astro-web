---
import { studioPageMeta } from "@data/seo";
import StudioNav from "@components/StudioNav.astro";
import SiteShell from "@components/SiteShell.astro";
import { studioContact, studioFacts, studioProcess } from "@data/studio";
---
<SiteShell title={studioPageMeta["/studio/process"].title} description={studioPageMeta["/studio/process"].description} canonicalPath="/studio/process" breadcrumbs={[["KJyang Studio", "/studio"], ["流程", "/studio/process"]]}>
  <main class="studio-index s-case">
    <StudioNav />
    <header class="s-wrap s-case-hero">
      <p class="s-eyebrow">流程</p>
      <h1>從傳 LINE 到網站上線，會經過 5 步</h1>
      <p class="s-lead">一頁式網站大約 {studioFacts.onePageWeeks}，多頁網站 {studioFacts.multiPageWeeks}。時間從你把資料給齊那天開始算，最常卡住的是照片和價目。</p>
    </header>
    <section class="s-wrap s-section"><ol class="s-steps">{studioProcess.map(([n, t, d]) => <li><span>{n}</span><div><b>{t}</b><p>{d}</p></div></li>)}</ol></section>
    <section class="s-wrap s-section" aria-labelledby="handover">
      <div class="s-head"><p class="s-eyebrow">交接</p><h2 id="handover">上線那天你會拿到</h2></div>
      <dl class="s-kv">
        <div><dt>網域帳號</dt><dd>登記在你名下，密碼你自己保管。</dd></div>
        <div><dt>程式碼</dt><dd>放在你可以存取的 GitHub，換人接手也看得懂。</dd></div>
        <div><dt>改內容說明</dt><dd>一份簡單文件：要改價格、換照片時找誰、怎麼做。</dd></div>
        <div><dt>流量統計</dt><dd>幫你開好 Google Search Console 和流量統計，看得到有多少人搜到你。</dd></div>
      </dl>
    </section>
    <section class="s-wrap s-cta-band">
      <h2>第一步是免費的</h2>
      <p>{studioFacts.freeCheck}</p>
      <div class="s-actions"><a class="s-btn s-btn-primary" href={studioContact.lineUrl} data-cta="process-line">LINE 傳店名給我</a><a class="s-btn" href="/studio/pricing">看價格</a></div>
    </section>
  </main>
</SiteShell>
