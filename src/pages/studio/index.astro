---
import SiteShell from "@components/SiteShell.astro";
import StudioNav from "@components/StudioNav.astro";
import { buildStudioSchemas } from "@data/seo";
import { studioPlans } from "@data/studio";
---
<SiteShell title="小商家網站設計與製作｜一頁式、品牌網站 — KJyang Studio" description="為小商家與工作室整理內容、設計品牌網站，從手機版面、聯絡入口到部署與維護。查看完整設計範例、費用與合作流程。" canonicalPath="/studio" schema={buildStudioSchemas().filter(entry => entry["@type"] !== "FAQPage")} alternates={[{hrefLang:"zh-Hant",href:"/studio"},{hrefLang:"en",href:"/studio/en"},{hrefLang:"x-default",href:"/studio"}]}>
<StudioNav /><main class="atelier-home">

    <section class="hero" aria-labelledby="hero-title">
      <div class="introduction">
        <div class="kicker"><span class="short-rule"></span>網站設計與開發 <span class="kicker-en">/ INDEPENDENT STUDIO</span></div>
        <h1 id="hero-title"><span>讓品牌，</span><span class="indent">有自己的</span><span>樣子<span class="full-stop">。</span></span></h1>
        <div class="intro-note"><span class="note-index">01 —</span><p>好看的第一眼，清楚的每一步。<br>把你的特色，做成真正好用的網站。</p></div>
        <a class="explore" href="#work">看設計，也看細節 <span aria-hidden="true">↗</span></a>
        <div class="signature"><svg viewBox="0 0 70 40" aria-hidden="true"><path d="M4 26C11 5 25 1 28 10S17 38 15 31 38 4 41 9 25 34 34 30 53 2 59 9 43 32 66 19"/></svg><span>由想法，到上線。<br>每一步，都好好對待。</span></div>
      </div>
      <div class="gallery" id="work" tabindex="-1" aria-label="概念網站展示">
        <div class="gallery-heading"><span>SELECTED DIRECTIONS</span><span class="gallery-tag">設計探索 / 2026</span></div>
        <div class="artboard" data-project="interior">
          <span class="edge-label" aria-hidden="true">FORM / FUNCTION / FEELING</span>
          <div class="website">
            <div class="website-nav"><span id="sample-brand">岩序<span class="sample-english">YAN XU</span></span><span class="website-menu" id="sample-menu">作品　 關於　 聯絡 ↗</span></div>
            <div class="website-image"><img id="sample-image" src="/demo-assets/interior-hero.png" alt="室內設計概念素材：住宅與材質" width="1600" height="900"><span class="image-index" aria-hidden="true">01</span><span id="sample-category">RESIDENTIAL / INTERIOR</span></div>
            <div class="website-editorial"><div><span class="sample-eyebrow" id="sample-eyebrow">空間裡，留下生活。</span><h2 id="sample-title">日常，自有風景。</h2></div><p id="sample-copy">一道光、一種材質。<br>慢慢靠近，喜歡的生活。</p><span class="editorial-arrow" aria-hidden="true">↗</span></div>
            <div class="website-bottom"><span id="sample-bottom">品牌網站概念</span><span id="sample-bottom-end">SCROLL TO EXPLORE ↓</span></div>
          </div>
          <span class="crop-mark top" aria-hidden="true"></span><span class="crop-mark bottom" aria-hidden="true"></span>
        </div>
        <a id="concept-link" href="/studio/demo/interior-design" class="gallery-caption"><div><span class="caption-index" id="caption-index">01</span><h3 id="caption-title">岩序室內設計</h3><span class="concept">概念設計</span></div><span id="caption-type">空間 · 品牌形象</span></a>
        <div class="gallery-bottom"><div class="project-tabs" role="group" aria-label="選擇概念作品"><button type="button" data-select="0" aria-pressed="true">01 <span>空間</span></button><button type="button" data-select="1" aria-pressed="false">02 <span>診所</span></button><button type="button" data-select="2" aria-pressed="false">03 <span>冷氣</span></button></div><span class="gallery-footnote">點作品名稱，探索完整網站 ↗</span></div>
        <span class="sr-only" id="gallery-status" aria-live="polite" aria-atomic="true">第 1 件，共 3 件：岩序室內設計</span>
      </div>
    </section>
    <section class="approach" id="approach"><div class="section-heading"><span>THE WAY WE WORK</span><span>設計與工程，都有照顧到。</span></div><div class="approach-grid"><h2>外在有美感，<br>裡面有安排。</h2><div class="approach-details"><p>從內容整理、視覺設計，到網站製作與上線。<br>先看懂你的需求，再找到適合的呈現。</p><ol><li><span>01</span><b>找出特色</b><small>釐清受眾與內容</small></li><li><span>02</span><b>形成樣子</b><small>版面、細節與互動</small></li><li><span>03</span><b>好好上線</b><small>製作、測試與後續照顧</small></li></ol></div></div></section>

<section class="approach"><div class="section-heading"><span>A PLACE TO START</span><span>依需求，選擇適合的規模。</span></div><div class="atelier-plans">{studioPlans.map((plan,i)=><a href="/studio/pricing"><span>0{i+1}</span><h2>{plan.nameZh}</h2><strong>{plan.price}</strong><p>{plan.text}</p><span>查看方案與交付範圍 ↗</span></a>)}</div></section>
<section class="approach"><div class="approach-grid"><h2>先聊清楚，<br/>再開始設計。</h2><div class="approach-details"><p>帶著你的服務、參考網站或一個還沒成形的想法都可以。先一起整理受眾、內容與預算，再確認範圍與時程。</p><a class="explore" href="/studio/process">了解完整合作流程 ↗</a><a class="explore" href="/studio/contact">討論你的網站 ↗</a></div></div></section>
</main><script>import "../../scripts/studio-gallery.js";</script></SiteShell>
