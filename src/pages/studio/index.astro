---
import { studioPageMeta } from "@data/seo";
import SiteShell from "@components/SiteShell.astro";
import StudioNav from "@components/StudioNav.astro";
import BookingMock from "@components/studio/BookingMock.astro";
import { buildStudioSchemas, studioFaq } from "@data/seo";
import { studioContact, studioFacts, studioPlans, studioProcess } from "@data/studio";
import { studioBeliefs } from "@data/trust";
import { realCases } from "@data/cases";
---
<SiteShell title={studioPageMeta["/studio"].title} description={studioPageMeta["/studio"].description} canonicalPath="/studio" schema={buildStudioSchemas()}>
<StudioNav />
<main class="studio-index s-home">
  <section class="s-hero" aria-labelledby="hero-title">
    <div class="s-hero-copy">
      <p class="s-eyebrow">楊凱捷・一人接案・{studioFacts.areaShort}</p>
      <h1 id="hero-title">幫小店做客人看得懂、<br />找得到你的網站</h1>
      <p class="s-lead">我幫北部的小店、工作室做網站和線上預約系統。設計、寫程式、上線、之後改價格換照片，都是我自己來，傳 LINE 找的就是做網站的人。</p>
      <ul class="s-hero-facts">
        <li><b>{studioFacts.startPrice} 起</b>一頁式網站</li>
        <li><b>{studioFacts.onePageWeeks}</b>資料給齊後上線</li>
        <li><b>{studioFacts.replyShort}</b>每天看 LINE</li>
      </ul>
      <div class="s-actions">
        <a class="s-btn s-btn-primary" href={studioContact.lineUrl} data-cta="hero-line">LINE 傳店名，免費看一次</a>
        <a class="s-btn" href="/studio/pricing" data-cta="hero-pricing">看價格和包含什麼</a>
      </div>
      <p class="s-fine">傳店名、網站或 IG，我回你 3 個可以馬上改的地方。看完不用付錢。</p>
    </div>
    <div class="s-hero-visual">
      <BookingMock />
      <p class="s-note">我幫 Weilspa 做的預約流程（示意畫面、示範資料）</p>
    </div>
  </section>

  <section class="s-wrap s-section" aria-labelledby="work-title">
    <div class="s-head"><p class="s-eyebrow">真實作品</p><h2 id="work-title">做過的東西，都可以點進去看</h2></div>
    <div class="s-cases">
      {realCases.map((c) => (
        <a class="s-case-card" href={`/studio/work/${c.slug}`}>
          <small>{c.kind}</small>
          <h3>{c.name}</h3>
          <p>{c.summary}</p>
          <span class="s-case-status">{c.status}</span>
          <b>看怎麼做的 →</b>
        </a>
      ))}
    </div>
    <p class="s-more-link"><a href="/studio/work">另外還有 4 個不同產業的設計範例 →</a></p>
  </section>

  <section class="s-wrap s-section s-me" aria-labelledby="me-title">
    <div class="s-head"><p class="s-eyebrow">關於我</p><h2 id="me-title">我是楊凱捷，鶯歌工商資訊科高三</h2></div>
    <div class="s-me-grid">
      <div>
        <p>我自學寫網站和架主機，做過完全遠端的軟體開發工作，也一直在經營自己的網站。接案是因為我發現很多店家其實不需要很貴的網站公司，需要的是一個講得清楚、找得到、做完不會消失的人。</p>
        <p>學生的好處是時間彈性、價格合理、你問什麼我都會直接回答。我知道你可能擔心「做完之後找不到人」，所以下面這四件事我都寫進報價單：</p>
        <a class="s-link" href="/studio/about">更多關於我 →</a>
      </div>
      <ul class="s-promises">{studioBeliefs.map((b) => <li><b>{b.title}</b><p>{b.text}</p></li>)}</ul>
    </div>
  </section>

  <section class="s-wrap s-section" aria-labelledby="price-title">
    <div class="s-head"><p class="s-eyebrow">價格</p><h2 id="price-title">價格寫在這裡，報價單也會寫清楚</h2></div>
    <div class="s-plans">
      {studioPlans.map((plan) => (
        <article class="s-plan">
          <h3>{plan.nameZh}</h3>
          <strong>{plan.price}</strong>
          <p>{plan.text}</p>
          <p class="s-plan-weeks">大約 {plan.weeks}</p>
          <ul>{plan.includes.slice(0, 4).map((i) => <li>{i}</li>)}</ul>
        </article>
      ))}
    </div>
    <p class="s-more-link"><a href="/studio/pricing">看完整的包含／不包含、維護月費 →</a></p>
  </section>

  <section class="s-wrap s-section" aria-labelledby="process-title">
    <div class="s-head"><p class="s-eyebrow">流程</p><h2 id="process-title">找我做網站，會經過這 5 步</h2></div>
    <ol class="s-steps">{studioProcess.map(([n, t, d]) => <li><span>{n}</span><div><b>{t}</b><p>{d}</p></div></li>)}</ol>
  </section>

  <section class="s-wrap s-section" aria-labelledby="faq-title">
    <div class="s-head"><p class="s-eyebrow">常見問題</p><h2 id="faq-title">大家常問我的</h2></div>
    <div class="s-faq">{studioFaq.map((f) => <details><summary>{f.question}</summary><p>{f.answer}</p></details>)}</div>
  </section>

  <section class="s-wrap s-cta-band">
    <h2>先傳店名給我就好</h2>
    <p>{studioFacts.freeCheck}</p>
    <div class="s-actions">
      <a class="s-btn s-btn-primary" href={studioContact.lineUrl} data-cta="bottom-line">LINE 傳給我</a>
      <a class="s-btn" href="/studio/contact" data-cta="bottom-contact">其他聯絡方式</a>
    </div>
  </section>
</main>
</SiteShell>
