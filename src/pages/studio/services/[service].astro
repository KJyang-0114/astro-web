---
import StudioNav from "@components/StudioNav.astro";
import SiteShell from "@components/SiteShell.astro";
import { absoluteStudioUrl, studioOrganizationId } from "@data/seo";
import { maintenancePlans, studioContact, studioFacts } from "@data/studio";
import { getServicePage, servicePages } from "@data/trust";

export function getStaticPaths() {
  return servicePages.map((service) => ({
    params: { service: service.slug }
  }));
}

const service = getServicePage(Astro.params.service ?? "");
const careFrom = maintenancePlans[0][1].replace(" / month", "");
const priceText =
  service.slug === "website-maintenance"
    ? `維護月費 ${careFrom} 起，包含主機、HTTPS、備份和每月 2 次小修改。不買月費也可以，要改的時候再單次報價。`
    : service.slug === "deployment-hosting"
      ? "要看你的程式是什麼、想放在哪裡，所以我會先看過檔案再報價。網域和主機帳號都開在你名下。"
      : `一頁式網站 ${studioFacts.startPrice} 起，大約 ${studioFacts.onePageWeeks}；多頁網站大約 ${studioFacts.multiPageWeeks}。付款是${studioFacts.payment}。`;
const others = servicePages.filter((s) => s.slug !== service.slug);
const pageUrl = absoluteStudioUrl(`/studio/services/${service.slug}`);
// 有公開價格的服務才寫 Offer；部署上線要先看過檔案才報價，不寫價格。
const startPrice = Number(studioFacts.startPrice.replace(/\D/g, ""));
const careFromNumber = Number(careFrom.replace(/\D/g, ""));
const offer =
  service.slug === "local-business-website" || service.slug === "website-redesign"
    ? { "@type": "Offer", url: absoluteStudioUrl("/studio/pricing"), priceCurrency: "TWD", priceSpecification: { "@type": "PriceSpecification", priceCurrency: "TWD", minPrice: startPrice } }
    : service.slug === "website-maintenance"
      ? { "@type": "Offer", url: absoluteStudioUrl("/studio/pricing"), priceCurrency: "TWD", priceSpecification: { "@type": "UnitPriceSpecification", priceCurrency: "TWD", price: careFromNumber, unitCode: "MON", unitText: "月" } }
      : undefined;
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: service.title,
    description: service.metaDescription,
    url: pageUrl,
    provider: { "@id": studioOrganizationId },
    areaServed: studioFacts.areaServed,
    availableLanguage: ["zh-Hant", "en"],
    ...(offer ? { offers: offer } : {})
  }
];
---
<SiteShell title={`${service.title}｜北部小店・一人接案 — KJyang Studio`} description={service.metaDescription} canonicalPath={`/studio/services/${service.slug}`} schema={schema} breadcrumbs={[["KJyang Studio", "/studio"], ["服務", "/studio/services"], [service.title, `/studio/services/${service.slug}`]]}>
  <main class="studio-index s-case">
    <StudioNav />
    <header class="s-wrap s-case-hero">
      <a class="s-back" href="/studio/services">← 所有服務</a>
      <p class="s-eyebrow">服務・{studioFacts.areaShort}</p>
      <h1>{service.title}</h1>
      <p class="s-lead">{service.description}</p>
    </header>

    <div class="s-wrap s-case-body">
      <div>
        <section>
          <h2>做完之後</h2>
          <p>{service.promise}</p>
        </section>
        <section>
          <h2>實際會遇到的情況</h2>
          <p class="s-scenario">{service.scenario}</p>
        </section>
        <section>
          <h2>費用</h2>
          <p>{priceText}實際金額我會在報價單上逐項寫清楚，你同意了才開始。</p>
        </section>
      </div>
      <aside class="s-side">
        <h2>包含哪些</h2>
        <ul>{service.includes.map((item) => <li>{item}</li>)}</ul>
        <h2>其他服務</h2>
        <ul>{others.map((o) => <li><a href={`/studio/services/${o.slug}`}>{o.title}</a></li>)}</ul>
      </aside>
    </div>

    <section class="s-wrap s-cta-band">
      <h2>先傳店名給我就好</h2>
      <p>{studioFacts.freeCheck}</p>
      <div class="s-actions">
        <a class="s-btn s-btn-primary" href={studioContact.lineUrl} data-cta={`service-${service.slug}-line`}>LINE 傳給我</a>
        <a class="s-btn" href="/studio/pricing">看價格和包含什麼</a>
      </div>
    </section>
  </main>
</SiteShell>
