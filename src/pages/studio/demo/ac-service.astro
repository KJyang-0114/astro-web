---
import SiteShell from "@components/SiteShell.astro";
import DemoNotice from "@components/DemoNotice.astro";
import { buildSchemas, getDemo } from "@data/demos";
import { studioContact } from "@data/studio";

const demo = getDemo("ac-service");
const lineUrl = studioContact.lineUrl;

const dispatch = [
  ["LINE 照片", "先看機型、室外機、管線、排水"],
  ["急件判斷", "不冷、漏水、跳電先排優先順序"],
  ["現場條件", "高樓、架台、銅管長度先講清楚"],
  ["完工交付", "冷房、排水、噪音、保固逐項確認"]
];

const studioWins = [
  ["急件 CTA 很近", "手機第一屏、底部固定列、表單都能直接 LINE 或電話。"],
  ["價格疑慮先處理", "把清洗、安裝、檢測的判斷方式寫清楚，客戶更願意傳照片。"],
  ["搜尋內容完整", "地區、服務、品牌、FAQ 與正式站產業 schema 都能整理好。"],
  ["交付後有人顧", "VPS、SSL、備份、監控、維護由 KJyang Studio 接住。"]
];
---

<SiteShell title={demo.seoTitle} description={demo.metaDescription} canonicalPath={`/studio/demo/${demo.slug}`} schema={buildSchemas(demo)} noindex>
  <main class="hvac-page">
    <nav class="site-nav hvac-nav">
      <a class="brand" href="/studio/demo">安峰冷氣工程</a>
      <div class="nav-links">
        <a href="#services">服務</a>
        <a href="#dispatch">流程</a>
        <a href="#prices">價格</a>
        <a href="#contact">LINE</a>
      </div>
    </nav>
    <DemoNotice />

    <section class="hvac-hero">
      <div class="wrap hvac-hero-grid">
        <div class="hvac-copy">
          <span class="hvac-kicker">台北 / 新北冷氣急件調度</span>
          <h1>冷氣不冷，先用 LINE 判斷能不能今天處理</h1>
          <p>{demo.subhead}</p>
          <div class="action-row">
            <a class="btn hvac-primary" href={lineUrl}>{demo.primaryCta}</a>
            <a class="btn hvac-secondary" href="#contact">{demo.secondaryCta}</a>
          </div>
        </div>

        <div class="hvac-console" aria-label="冷氣服務調度看板">
          <div class="console-top">
            <span>LIVE QUOTE BOARD</span>
            <b>{demo.hours}</b>
          </div>
          <img src={demo.heroImage} alt="冷氣師傅檢查室內機" />
          <div class="console-card">
            <b>今日詢價要拍</b>
            <div>
              <span>室內機</span>
              <span>室外機</span>
              <span>排水</span>
              <span>電源</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="hvac-ticker" aria-label="服務信任資訊">
      <div class="wrap hvac-ticker-track">
        {demo.trust.map((item) => <span>{item}</span>)}
        <span>{demo.serviceArea}</span>
        <span>{demo.phone}</span>
      </div>
    </section>

    <section class="hvac-services" id="services">
      <div class="wrap hvac-section-head">
        <span>SERVICE MENU</span>
        <h2>把客戶最急的問題，拆成可理解的服務選項</h2>
      </div>
      <div class="wrap hvac-service-board">
        {demo.services.map((service, index) => (
          <article>
            <b>{String(index + 1).padStart(2, "0")}</b>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="hvac-dispatch" id="dispatch">
      <div class="wrap hvac-dispatch-grid">
        <div>
          <span class="hvac-kicker">BOOKING SYSTEM</span>
          <h2>不是等客戶亂問，是讓他照流程給資料</h2>
          <p>冷氣行最需要快。網站先讓客戶知道要拍什麼、會怎麼估價、哪些情況會加價，電話和 LINE 就會變有效率。</p>
        </div>
        <div class="dispatch-stack">
          {dispatch.map(([title, text], index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <b>{title}</b>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="hvac-prices" id="prices">
      <div class="wrap hvac-price-grid">
        <div class="price-lead">
          <span>PRICE GUIDE</span>
          <h2>{demo.pricingTitle}</h2>
          <p>先說明價格形成方式，不假裝線上秒報所有狀況。這種誠實反而讓客戶放心。</p>
        </div>
        {demo.pricing.map((item) => (
          <article>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="hvac-studio">
      <div class="wrap hvac-studio-grid">
        <h2>這頁不是漂亮而已，是幫冷氣行少漏掉詢價</h2>
        <div>
          {studioWins.map(([title, text]) => (
            <article>
              <b>{title}</b>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="faq-section hvac-faq" id="faq">
      <div class="wrap faq-grid">
        <div>
          <h2 class="section-title">報價前常見問題</h2>
          <p class="section-copy">FAQ 先回答價格、保固、清洗時間和當天維修，減少重複溝通。</p>
        </div>
        <div class="faq-list">
          {demo.faq.map((item) => (
            <details>
              <summary>{item.title}</summary>
              <p>{item.text}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="contact-section hvac-contact" id="contact">
      <div class="wrap contact-grid">
        <div>
          <h2 class="section-title">拍照片，今天先抓可施工時間</h2>
          <p class="section-copy">此區為範例聯絡設計。想做類似網站請聯絡 KJyang Studio：{studioContact.phone} · LINE {studioContact.lineId}</p>
          <div class="action-row">
            <a class="btn hvac-primary" href={lineUrl}>聯絡 KJyang Studio</a>
            <button class="btn hvac-secondary fake-phone" type="button">電話按鈕示意</button>
          </div>
          <aside class="line-contact-card">
            <div class="line-qr" aria-label="KJyang Studio LINE QR code">
              <img src={studioContact.lineQr} alt="KJyang Studio LINE QR code" loading="lazy" />
            </div>
            <div>
              <b>KJYANG STUDIO LINE</b>
              <strong>{studioContact.lineId}</strong>
              <p>此 demo 不接受冷氣預約。想做類似網站，可傳目前網站或參考風格。</p>
            </div>
          </aside>
        </div>
        <form class="contact-form">
          <label class="field">
            姓名
            <input name="name" autocomplete="name" />
          </label>
          <label class="field">
            需求
            <select name="service">
              <option>冷氣安裝</option>
              <option>冷氣清洗</option>
              <option>冷氣維修</option>
              <option>移機汰換</option>
            </select>
          </label>
          <label class="field">
            現場狀況
            <textarea name="message" rows="4"></textarea>
          </label>
          <button class="btn hvac-primary" type="button">複製需求並開 LINE</button>
        </form>
      </div>
    </section>

    <div class="mobile-cta" aria-label="手機快速聯絡">
      <a href="#contact">電話</a>
      <a href={lineUrl}>LINE 諮詢</a>
    </div>
  </main>
</SiteShell>
