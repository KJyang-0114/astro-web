---
import SiteShell from "@components/SiteShell.astro";
import DemoNotice from "@components/DemoNotice.astro";
import { buildSchemas, getDemo } from "@data/demos";
import { studioContact } from "@data/studio";

const demo = getDemo("dental-clinic");
const lineUrl = studioContact.lineUrl;

const chapters = [
  ["先安心", "看診前知道時間、位置、初診流程，不用到現場才問。"],
  ["再檢查", "醫師先說明狀況、治療選項、費用方向和下一步。"],
  ["後追蹤", "複診、照護提醒、療程安排都能被清楚承接。"]
];

const studioWins = [
  ["預約入口不藏", "桌機、手機、頁尾、固定 CTA 都能快速預約。"],
  ["信任資訊完整", "醫師、環境、初診、FAQ、營業時間、地圖整合在一頁。"],
  ["搜尋能讀懂", "診療項目、FAQ、地址與服務區域能整理成正式站可用結構。"],
  ["診所不用管主機", "SSL、VPS、備份、監控、維護與小改文案一起處理。"]
];
---

<SiteShell title={demo.seoTitle} description={demo.metaDescription} canonicalPath={`/studio/demo/${demo.slug}`} schema={buildSchemas(demo)} noindex>
  <main class="clinic-page">
    <nav class="site-nav clinic-nav">
      <a class="brand" href="/studio/demo">晴禾牙醫診所</a>
      <div class="nav-links">
        <a href="#treatments">診療</a>
        <a href="#journey">初診</a>
        <a href="#faq">FAQ</a>
        <a href="#contact">預約</a>
      </div>
    </nav>
    <DemoNotice />

    <section class="clinic-hero">
      <div class="wrap clinic-hero-grid">
        <div class="clinic-copy">
          <span class="clinic-kicker">{demo.serviceArea}</span>
          <h1>讓第一次看牙，也像走進有安排的流程</h1>
          <p>{demo.subhead}</p>
          <div class="action-row">
            <a class="btn clinic-primary" href="#contact">{demo.primaryCta}</a>
            <a class="btn clinic-secondary" href="#treatments">{demo.secondaryCta}</a>
          </div>
        </div>
        <div class="clinic-visual">
          <img src={demo.heroImage} alt="晴禾牙醫診所明亮診療空間" />
          <aside>
            <span>OPEN HOURS</span>
            <b>{demo.hours}</b>
            <p>預約制看診，初診先檢查與說明治療選項。</p>
          </aside>
        </div>
      </div>
    </section>

    <section class="clinic-trust">
      <div class="wrap clinic-trust-grid">
        {demo.trust.map((item) => (
          <article>
            <b>{item}</b>
            <p>降低病患不確定感，讓預約更容易發生。</p>
          </article>
        ))}
      </div>
    </section>

    <section class="clinic-treatments" id="treatments">
      <div class="wrap clinic-section-head">
        <span>TREATMENTS</span>
        <h2>診療不是清單，是病患做決定前的信任路徑</h2>
      </div>
      <div class="wrap clinic-treatment-grid">
        {demo.services.map((service) => (
          <article>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="clinic-journey" id="journey">
      <div class="wrap clinic-journey-grid">
        <div class="journey-copy">
          <span>FIRST VISIT</span>
          <h2>初診流程先講清楚，櫃台和病患都省力</h2>
        </div>
        <div class="journey-chapters">
          {chapters.map(([title, text]) => (
            <article>
              <b>{title}</b>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
      <div class="wrap clinic-process">
        {demo.process.map((step, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="clinic-studio">
      <div class="wrap clinic-studio-grid">
        <div>
          <span>LOCAL WEBSITE STUDIO</span>
          <h2>診所網站要讓人安心預約，不只是看起來乾淨</h2>
        </div>
        <div>
          {studioWins.map(([title, text]) => (
            <article>
              <b>{title}</b>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="clinic-proof">
      <div class="wrap clinic-proof-grid">
        <h2>{demo.proofTitle}</h2>
        {demo.proof.map((item) => (
          <article>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="faq-section clinic-faq" id="faq">
      <div class="wrap faq-grid">
        <div>
          <h2 class="section-title">預約前常見問題</h2>
          <p class="section-copy">把時間、資料、停車、自費項目先講清楚，預約阻力就少。</p>
        </div>
        <div class="faq-list">
          {demo.faq.map((item) => (
            <details>
              <summary>{item.title}</summary>
              <p>{item.text}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="contact-section clinic-contact" id="contact">
      <div class="wrap contact-grid">
        <div>
          <h2 class="section-title">留下希望時段，櫃台協助確認</h2>
          <p class="section-copy">此區為範例聯絡設計。想做類似網站請聯絡 KJyang Studio：{studioContact.phone} · LINE {studioContact.lineId}</p>
          <div class="action-row">
            <button class="btn clinic-secondary fake-phone" type="button">電話按鈕示意</button>
            <a class="btn clinic-primary" href={lineUrl}>LINE 詢問網站</a>
          </div>
          <aside class="line-contact-card">
            <div class="line-qr" aria-label="KJyang Studio LINE QR code">
              <img src={studioContact.lineQr} alt="KJyang Studio LINE QR code" loading="lazy" />
            </div>
            <div>
              <b>KJYANG STUDIO LINE</b>
              <strong>{studioContact.lineId}</strong>
              <p>此 demo 不接受牙醫預約。想做類似網站，可傳目前網站或參考風格。</p>
            </div>
          </aside>
        </div>
        <form class="contact-form">
          <label class="field">
            姓名
            <input name="name" autocomplete="name" />
          </label>
          <label class="field">
            希望時段
            <input name="time" />
          </label>
          <label class="field">
            症狀或需求
            <textarea name="message" rows="4"></textarea>
          </label>
          <button class="btn clinic-primary" type="button">複製需求並開 LINE</button>
        </form>
      </div>
    </section>

    <div class="mobile-cta" aria-label="手機快速預約">
      <a href="#contact">電話</a>
      <a href={lineUrl}>LINE 諮詢</a>
    </div>
  </main>
</SiteShell>
