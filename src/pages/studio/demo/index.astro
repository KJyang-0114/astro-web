---
import StudioNav from "@components/StudioNav.astro";
import DemoNotice from "@components/DemoNotice.astro";
import SiteShell from "@components/SiteShell.astro";
import { demos } from "@data/demos";
---

<SiteShell title="設計範例｜4 個虛構品牌的網站 — KJyang Studio" description="室內設計、牙醫診所、冷氣、補習班 4 個虛構品牌的範例網站，用來示範不同產業的版面。店名和內容都是編的，不是客戶。" canonicalPath="/studio/demo" noindex>
  <main class="studio-index">
    <StudioNav />
    <DemoNotice />
    <section class="studio-index-demos page-hero-offset">
      <div class="wrap studio-showcase-head">
        <span>設計範例・虛構品牌</span>
        <div><h1>4 個範例網站，店名都是我編的</h1>
        <p>這些不是客戶，也不能預約。我用它們示範室內設計、診所、冷氣、補習班的網站可以怎麼排。想看真的有人在用的作品，請到<a href="/studio/work">作品頁</a>。</p></div>
      </div>
      <div class="wrap studio-showcase-grid">
        {demos.map((demo, index) => (
          <a class:list={["studio-showcase-card", `showcase-${demo.theme}`]} href={`/studio/demo/${demo.slug}`}>
            <img src={demo.heroImage} alt={`${demo.businessName}（虛構品牌）範例網站的示意照片`} loading={index === 0 ? "eager" : "lazy"} />
            <div>
              <span>{demo.industry}</span>
              <h3>{demo.businessName}</h3>
              <p>{demo.headline}</p>
              <b>打開範例網站 ↗</b>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</SiteShell>
