---
import SiteShell from "@components/SiteShell.astro";
import DemoNotice from "@components/DemoNotice.astro";
import { buildSchemas, getDemo } from "@data/demos";
import { studioContact } from "@data/studio";

const demo = getDemo("interior-design");
const lineUrl = studioContact.lineUrl;

const projects = [
  ["小宅收納", "櫃體深度、門片比例、動線壓迫感一次處理。", "wide"],
  ["老屋翻新", "水電、漏水、牆地狀況先排查，再談風格。", "tall"],
  ["親子住宅", "清潔、安全、收納、成長彈性放進同一套配置。", "normal"],
  ["品牌商空", "門面、展示、客流、收銀路徑服務同一個銷售目標。", "image"],
  ["局部改造", "廚房、玄關、工作區也能做出明確變化。", "normal"]
];

const delivery = [
  ["看得見", "大圖、作品分類、預算方向，先讓客戶相信審美。"],
  ["問得到", "LINE、電話、表單、FAQ、服務區域，手機上不用找。"],
  ["交得出", "SEO meta、正式站 schema、SSL、VPS、備份、監控。"]
];

const proof = [
  "網站不是做完丟給業主。網域歸客戶，主機、SSL、備份、監控、維護由我們處理。",
  "每一個 demo 都能拆成可交付 SOP：設計、內容、表單、部署、維護，不靠臨場硬改。"
];
---

<SiteShell title={demo.seoTitle} description={demo.metaDescription} canonicalPath={`/studio/demo/${demo.slug}`} schema={buildSchemas(demo)} noindex>
  <main class="interior-page pro-interior">
    <nav class="site-nav pro-nav">
      <a class="brand" href="/studio/demo">岩序室內設計</a>
      <div class="nav-links">
        <a href="#work">作品</a>
        <a href="#system">交付</a>
        <a href="#faq">FAQ</a>
        <a href="#contact">諮詢</a>
      </div>
    </nav>
    <DemoNotice />

    <section class="pro-hero">
      <div class="wrap pro-hero-grid">
        <div class="pro-hero-copy">
          <h1>
            <span>空間設計</span>
            <span>不只效果圖</span>
          </h1>
          <p>先把作品、預算、流程和落地條件說清楚，讓諮詢從第一眼就有質感。</p>
          <div class="action-row">
            <a class="btn pro-primary" href="#contact">預約設計諮詢</a>
            <a class="btn pro-secondary" href="#work">看作品路徑</a>
          </div>
        </div>
        <figure class="pro-hero-art">
          <img src={demo.heroImage} alt="高雄住宅室內設計作品空間" />
          <figcaption>
            <b>網站交付重點</b>
            <span>作品集 · 預算分流 · 手機 CTA · SEO 結構 · 代管維護</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="pro-strip">
      <div class="wrap pro-strip-grid">
        {delivery.map(([title, text]) => (
          <article>
            <h2>{title}</h2>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="pro-work" id="work">
      <div class="wrap">
        <header class="pro-section-head">
          <h2>作品先說服，內容再成交</h2>
          <p>Portfolio Grid 讓客戶先被畫面吸住，再用每張作品回答實際問題。</p>
        </header>
        <div class="pro-masonry">
          {projects.map(([title, text, kind], index) => (
            <article class={`pro-project project-${kind}`}>
              <div class="project-media"></div>
              <div class="project-copy">
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="pro-system" id="system">
      <div class="wrap pro-system-grid">
        <div>
          <h2>讓客戶覺得錢花得值得</h2>
        </div>
        <div class="system-panel">
          <p>
            設計感不是多放幾張卡片。它是從第一屏、作品分類、預算文字、表單和交付承諾形成同一套體驗。
          </p>
          <div class="system-rail">
            <span>Design</span>
            <span>Content</span>
            <span>Deploy</span>
            <span>Maintain</span>
          </div>
        </div>
      </div>
    </section>

    <section class="pro-proof">
      <div class="wrap pro-proof-grid">
        {proof.map((item) => (
          <blockquote>{item}</blockquote>
        ))}
      </div>
    </section>

    <section class="faq-section pro-faq" id="faq">
      <div class="wrap faq-grid">
        <div>
          <h2 class="section-title">諮詢前常見問題</h2>
          <p class="interior-copy">FAQ 先處理平面圖、預算、老屋翻新和只設計不施工等關鍵問題。</p>
        </div>
        <div class="faq-list">
          {demo.faq.map((item) => (
            <details>
              <summary>{item.title}</summary>
              <p>{item.text}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="contact-section interior-contact pro-contact" id="contact">
      <div class="wrap contact-grid">
        <div>
          <h2 class="section-title">帶著平面圖和預算，先聊能不能落地</h2>
          <p class="section-copy">
            此區為範例聯絡設計。想做類似網站請聯絡 KJyang Studio：{studioContact.phone} · LINE {studioContact.lineId}
          </p>
          <div class="action-row">
            <button class="btn interior-primary fake-phone" type="button">電話按鈕示意</button>
            <a class="btn interior-secondary light" href={lineUrl}>LINE 詢問網站</a>
          </div>
          <aside class="line-contact-card">
            <div class="line-qr" aria-label="KJyang Studio LINE QR code">
              <img src={studioContact.lineQr} alt="KJyang Studio LINE QR code" loading="lazy" />
            </div>
            <div>
              <b>KJYANG STUDIO LINE</b>
              <strong>{studioContact.lineId}</strong>
              <p>此 demo 不接受室內設計預約。想做類似網站，可傳目前網站或參考風格。</p>
            </div>
          </aside>
        </div>
        <form class="contact-form light-form">
          <label class="field">
            姓名
            <input name="name" autocomplete="name" />
          </label>
          <label class="field">
            空間類型
            <select name="space">
              <option>新成屋</option>
              <option>老屋翻新</option>
              <option>商業空間</option>
              <option>局部改造</option>
            </select>
          </label>
          <label class="field">
            坪數、預算與時程
            <textarea name="message" rows="4"></textarea>
          </label>
          <button class="btn interior-primary" type="button">複製需求並開 LINE</button>
        </form>
      </div>
    </section>

    <div class="mobile-cta" aria-label="手機快速諮詢">
      <a href="#contact">電話</a>
      <a href={lineUrl}>LINE 諮詢</a>
    </div>
  </main>
</SiteShell>
