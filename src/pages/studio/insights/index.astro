---
import StudioNav from "@components/StudioNav.astro";
import SiteShell from "@components/SiteShell.astro";
import { insightPosts } from "@data/insights";
import { absoluteStudioUrl, founderPerson } from "@data/seo";
import { studioContact, studioFacts } from "@data/studio";

const description = "小店網站多少錢、要不要做網站、LINE 預約和預約系統差在哪、手機第一屏放什麼、上線之後怎麼維護。楊凱捷用自己做過的案子寫的 6 篇文章。";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "文章",
    description,
    url: absoluteStudioUrl("/studio/insights"),
    inLanguage: "zh-Hant",
    author: founderPerson,
    mainEntity: {
      "@type": "ItemList",
      itemListElement: insightPosts.map((post, index) => ({
        "@type": "ListItem",
        position: index + 1,
        url: absoluteStudioUrl(`/studio/insights/${post.slug}`),
        name: post.title
      }))
    }
  }
];
---
<SiteShell title="文章｜小店網站的價格、預約、手機版與維護 — KJyang Studio" description={description} canonicalPath="/studio/insights" schema={schema}>
  <main class="studio-index s-case">
    <StudioNav />
    <header class="s-wrap s-case-hero">
      <p class="s-eyebrow">文章</p>
      <h1>開店的人常問我的幾件事</h1>
      <p class="s-lead">做網站之前，老闆最常問的是多少錢、到底要不要做、預約要不要上網。我把回答寫成下面 6 篇，裡面的例子都是我自己做過的案子。</p>
    </header>
    <section class="s-wrap s-section" aria-labelledby="posts">
      <div class="s-head"><h2 id="posts">全部文章</h2></div>
      <ol class="s-posts">
        {insightPosts.map((post) => (
          <li>
            <a href={`/studio/insights/${post.slug}`}>
              <small>{post.category}・<time datetime={post.date}>{post.date}</time></small>
              <h3>{post.title}</h3>
              <p>{post.summary}</p>
            </a>
          </li>
        ))}
      </ol>
    </section>
    <section class="s-wrap s-cta-band">
      <h2>想直接問你的店？</h2>
      <p>{studioFacts.freeCheck}</p>
      <div class="s-actions">
        <a class="s-btn s-btn-primary" href={studioContact.lineUrl} data-cta="insights-line">LINE 傳店名給我</a>
        <a class="s-btn" href="/studio/pricing">看價格</a>
      </div>
    </section>
  </main>
</SiteShell>
