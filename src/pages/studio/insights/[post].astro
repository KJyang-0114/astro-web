---
import StudioNav from "@components/StudioNav.astro";
import SiteShell from "@components/SiteShell.astro";
import { buildInsightSchemas, getInsightPost, insightPosts } from "@data/insights";
import { studioContact, studioFacts } from "@data/studio";
import { realCases } from "@data/cases";
import { servicePages } from "@data/trust";

export function getStaticPaths() {
  return insightPosts.map((post) => ({
    params: { post: post.slug }
  }));
}

const post = getInsightPost(Astro.params.post ?? "");
const others = insightPosts.filter((item) => item.slug !== post.slug);
const paragraphs = (body: string) => body.split(/\n\n+/);
const isList = (text: string) => /^(?:\d+\.|-) /m.test(text) && text.split("\n").every((line) => /^(?:\d+\.|-) /.test(line));
const listItems = (text: string) => text.split("\n").map((line) => line.replace(/^(?:\d+\.|-) /, ""));
const ordered = (text: string) => /^\d+\. /.test(text);
// 相關頁面的連結文字直接用目標頁的名稱。
const labelFor = (path: string) => {
  if (path === "/studio/pricing") return "價格：每個方案包含什麼、維護月費";
  const service = servicePages.find((s) => path === `/studio/services/${s.slug}`);
  if (service) return `服務：${service.title}`;
  const real = realCases.find((c) => path === `/studio/work/${c.slug}`);
  if (real) return `真實作品：${real.name}`;
  const insight = insightPosts.find((p) => path === `/studio/insights/${p.slug}`);
  if (insight) return insight.title;
  throw new Error(`Unknown related path: ${path}`);
};
const related = post.related.map((path) => ({ path, label: labelFor(path) }));
---
<SiteShell title={`${post.title} — KJyang Studio`} description={post.description} canonicalPath={`/studio/insights/${post.slug}`} schema={buildInsightSchemas(post)} ogType="article" article={{ published: post.date, modified: post.updated ?? post.date, section: post.category }}>
  <main class="studio-index s-case">
    <StudioNav />
    <article>
      <header class="s-wrap s-case-hero">
        <a class="s-back" href="/studio/insights">← 所有文章</a>
        <p class="s-eyebrow">{post.category}・<time datetime={post.date}>{post.date}</time>・{studioFacts.owner}</p>
        <h1>{post.title}</h1>
        <p class="s-lead">{post.summary}</p>
      </header>
      <div class="s-wrap s-case-body">
        <div class="s-article">
          {post.sections.map((section) => (
            <section>
              <h2>{section.title}</h2>
              {paragraphs(section.body).map((text) =>
                isList(text)
                  ? ordered(text)
                    ? <ol>{listItems(text).map((item) => <li>{item}</li>)}</ol>
                    : <ul>{listItems(text).map((item) => <li>{item}</li>)}</ul>
                  : <p>{text}</p>
              )}
            </section>
          ))}
        </div>
        <aside class="s-side">
          <h2>重點</h2>
          <ul>{post.takeaways.map((item) => <li>{item}</li>)}</ul>
          <h2>相關頁面</h2>
          <ul class="s-side-links">{related.map((item) => <li><a href={item.path}>{item.label}</a></li>)}</ul>
          <h2>其他文章</h2>
          <ul class="s-side-links">{others.map((item) => <li><a href={`/studio/insights/${item.slug}`}>{item.title}</a></li>)}</ul>
        </aside>
      </div>
    </article>
    <section class="s-wrap s-section" aria-labelledby="faq">
      <div class="s-head"><p class="s-eyebrow">常見問題</p><h2 id="faq">還有人問過</h2></div>
      <div class="s-faq">
        {post.faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
    <section class="s-wrap s-cta-band">
      <h2>想知道你的店適合怎麼做？</h2>
      <p>{studioFacts.freeCheck}</p>
      <div class="s-actions">
        <a class="s-btn s-btn-primary" href={studioContact.lineUrl} data-cta={`insight-${post.slug}-line`}>LINE 傳店名給我</a>
        <a class="s-btn" href="/studio/pricing">看價格</a>
      </div>
    </section>
  </main>
</SiteShell>
