---
import Layout from '../layouts/Layout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "AI 探索 — KJyang",
  "description": "從基礎概念到未來展望，一次搞懂人工智慧。",
  "url": "https://kjyang0114.dev/ai",
  "author": { "@type": "Person", "name": "楊凱捷", "alternateName": "KJyang" }
};

const abilities = [
  { icon: "👁️", title: "圖像識別", desc: "瞬間識別照片中的物體、人臉、文字" },
  { icon: "💬", title: "語言理解", desc: "理解人類語言，進行對話和翻譯" },
  { icon: "📊", title: "數據分析", desc: "從大量數據中發現規律和趨勢" },
  { icon: "🎨", title: "創作輔助", desc: "協助寫作、繪畫、音樂創作" },
  { icon: "🤖", title: "自動化", desc: "自動執行重複性任務" },
  { icon: "🧩", title: "問題解決", desc: "分析複雜問題並提供解決方案" },
];

const limitations = [
  { title: "不是萬能的", desc: "AI 需要大量數據訓練，在沒有足夠數據的領域表現有限" },
  { title: "缺乏真正的情感", desc: "AI 可以模擬情感反應，但不具備真正的感情和同理心" },
  { title: "倫理判斷困難", desc: "在複雜的道德和倫理問題上，AI 難以做出完美判斷" },
  { title: "無法解釋所有決策", desc: "某些 AI 系統的決策過程如「黑盒子」般難以解釋" },
];

const myths = [
  { myth: "AI 會取代所有人類工作", fact: "AI 更多是協助人類，創造新的工作機會" },
  { myth: "AI 有自己的意識和想法", fact: "AI 是按程序運行，沒有真正的自我意識" },
  { myth: "AI 總是 100% 準確", fact: "AI 會犯錯，需要人類監督和驗證" },
];

const timeline = [
  { year: "1950s", title: "AI 概念誕生", desc: "圖靈測試 — AI 之父艾倫·圖靈提出機器思考的可能性" },
  { year: "1980s", title: "專家系統興起", desc: "第一波 AI 商業化應用" },
  { year: "2010s", title: "深度學習革命", desc: "神經網路技術突破，圖像識別準確率大幅提升" },
  { year: "2020s", title: "大語言模型時代", desc: "ChatGPT 等工具讓 AI 進入普通人的生活" },
];

const future = [
  { icon: "🎓", title: "個人化教育", desc: "AI 將為每個人提供量身定制的學習體驗" },
  { icon: "🏥", title: "醫療革命", desc: "精準診斷和個人化治療方案" },
  { icon: "🌱", title: "環境保護", desc: "智慧城市和可持續發展解決方案" },
  { icon: "🤝", title: "人機協作", desc: "AI 成為人類最好的工作夥伴" },
];

const guidelines = [
  { icon: "🛡️", title: "保護隱私", desc: "使用 AI 時要注意個人隱私和數據安全" },
  { icon: "🔍", title: "批判思考", desc: "不盲目相信 AI 的結果，保持獨立思考" },
  { icon: "🤝", title: "人機協作", desc: "將 AI 視為工具和夥伴，而非替代品" },
  { icon: "📚", title: "持續學習", desc: "AI 技術快速發展，保持學習新知的態度" },
];
---

<Layout
  title="AI 探索 — KJyang | 從基礎到未來的 AI 完整指南"
  description="從基礎概念到未來展望，一次搞懂人工智慧。AI 能做什麼、有什麼限制、常見迷思破解、發展歷程與未來方向。"
  jsonLd={jsonLd}
>

  <!-- Hero -->
  <section class="pt-32 pb-16">
    <div class="section-container">
      <div class="animate-on-scroll inline-flex items-center gap-2 px-4 py-2 rounded-full bg-brand/10 border border-brand/20 text-brand text-sm font-medium mb-8">
        <span class="w-2 h-2 rounded-full bg-brand animate-pulse"></span>
        AI 探索
      </div>
      <h1 class="animate-on-scroll delay-1 text-4xl sm:text-5xl font-black mb-6">
        探索 <span class="text-gradient">AI</span> 宇宙
      </h1>
      <p class="animate-on-scroll delay-2 text-lg text-zinc-400 max-w-2xl leading-relaxed">
        從基礎概念到未來展望，一次搞懂人工智慧到底在紅什麼。
      </p>
    </div>
  </section>

  <!-- 01 AI 基礎概念 -->
  <section class="py-16" aria-label="AI 基礎概念">
    <div class="section-container">
      <div class="flex items-center gap-4 mb-8">
        <span class="animate-on-scroll text-sm font-mono text-brand bg-brand/10 border border-brand/20 px-3 py-1 rounded-full">01</span>
        <h2 class="animate-on-scroll text-2xl sm:text-3xl font-bold">AI 基礎概念</h2>
      </div>
      <p class="animate-on-scroll delay-1 text-zinc-400 mb-10 max-w-2xl">什麼是人工智慧？</p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="animate-on-scroll delay-1 p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800/50">
          <span class="text-3xl mb-4 block">🧠</span>
          <h3 class="text-lg font-semibold text-zinc-100 mb-2">簡單來說</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">
            AI 就像一個超級聰明的助手，能夠學習、思考和解決問題。想像一下，如果你的電腦突然會思考了！
          </p>
        </div>
        <div class="animate-on-scroll delay-2 p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800/50">
          <span class="text-3xl mb-4 block">⚙️</span>
          <h3 class="text-lg font-semibold text-zinc-100 mb-2">技術角度</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">
            AI 是讓機器模擬人類智慧的技術，包括機器學習、深度學習、自然語言處理等多個領域。
          </p>
        </div>
        <div class="animate-on-scroll delay-3 p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800/50">
          <span class="text-3xl mb-4 block">💡</span>
          <h3 class="text-lg font-semibold text-zinc-100 mb-2">生活應用</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">
            從手機的語音助手到推薦系統，AI 已經悄悄融入我們的日常生活中。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 AI 的超能力 -->
  <section class="py-16" aria-label="AI 的能力">
    <div class="section-container">
      <div class="flex items-center gap-4 mb-8">
        <span class="animate-on-scroll text-sm font-mono text-brand bg-brand/10 border border-brand/20 px-3 py-1 rounded-full">02</span>
        <h2 class="animate-on-scroll text-2xl sm:text-3xl font-bold">AI 能做什麼</h2>
      </div>
      <p class="animate-on-scroll delay-1 text-zinc-400 mb-10 max-w-2xl">目前 AI 已經能做到的事情。</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {abilities.map((a, i) => (
          <div class={`animate-on-scroll delay-${(i % 4) + 1} p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800/50 hover:border-brand/30 transition-all duration-300`}>
            <span class="text-2xl mb-3 block">{a.icon}</span>
            <h3 class="text-base font-semibold text-zinc-200 mb-2">{a.title}</h3>
            <p class="text-zinc-400 text-sm leading-relaxed">{a.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 03 AI 的限制 -->
  <section class="py-16" aria-label="AI 的限制">
    <div class="section-container">
      <div class="flex items-center gap-4 mb-8">
        <span class="animate-on-scroll text-sm font-mono text-brand bg-brand/10 border border-brand/20 px-3 py-1 rounded-full">03</span>
        <h2 class="animate-on-scroll text-2xl sm:text-3xl font-bold">AI 的限制</h2>
      </div>
      <p class="animate-on-scroll delay-1 text-zinc-400 mb-10 max-w-2xl">AI 不是萬能的，了解它的邊界很重要。</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {limitations.map((l, i) => (
          <div class={`animate-on-scroll delay-${(i % 4) + 1} flex items-start gap-4 p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800/50`}>
            <span class="text-xl mt-0.5 flex-shrink-0">⚠️</span>
            <div>
              <h3 class="text-base font-semibold text-zinc-200 mb-2">{l.title}</h3>
              <p class="text-zinc-400 text-sm leading-relaxed">{l.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 04 迷思破解 -->
  <section class="py-16" aria-label="迷思破解">
    <div class="section-container">
      <div class="flex items-center gap-4 mb-8">
        <span class="animate-on-scroll text-sm font-mono text-brand bg-brand/10 border border-brand/20 px-3 py-1 rounded-full">04</span>
        <h2 class="animate-on-scroll text-2xl sm:text-3xl font-bold">迷思破解</h2>
      </div>
      <p class="animate-on-scroll delay-1 text-zinc-400 mb-10 max-w-2xl">常見的 AI 誤解，一次澄清。</p>

      <div class="space-y-4">
        {myths.map((m, i) => (
          <div class={`animate-on-scroll delay-${(i % 4) + 1} p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800/50`}>
            <div class="flex items-center gap-3 mb-3 text-red-400">
              <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
              <span class="text-sm font-medium"><strong>迷思：</strong>{m.myth}</span>
            </div>
            <div class="flex items-center gap-3 text-green-400">
              <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <span class="text-sm font-medium"><strong>實際：</strong>{m.fact}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 05 發展歷程 -->
  <section class="py-16" aria-label="AI 發展歷程">
    <div class="section-container">
      <div class="flex items-center gap-4 mb-8">
        <span class="animate-on-scroll text-sm font-mono text-brand bg-brand/10 border border-brand/20 px-3 py-1 rounded-full">05</span>
        <h2 class="animate-on-scroll text-2xl sm:text-3xl font-bold">AI 發展歷程</h2>
      </div>

      <div class="relative pl-8 border-l-2 border-zinc-800 space-y-10">
        {timeline.map((t, i) => (
          <div class={`animate-on-scroll delay-${(i % 4) + 1} relative`}>
            <div class="absolute -left-[calc(2rem+5px)] top-1.5 w-3 h-3 rounded-full bg-brand border-2 border-zinc-950" aria-hidden="true"></div>
            <span class="text-xs font-mono text-brand uppercase tracking-wider">{t.year}</span>
            <h3 class="text-lg font-semibold text-zinc-100 mt-1 mb-2">{t.title}</h3>
            <p class="text-zinc-400 text-sm leading-relaxed">{t.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 06 未來展望 -->
  <section class="py-16" aria-label="未來展望">
    <div class="section-container">
      <div class="flex items-center gap-4 mb-8">
        <span class="animate-on-scroll text-sm font-mono text-brand bg-brand/10 border border-brand/20 px-3 py-1 rounded-full">∞</span>
        <h2 class="animate-on-scroll text-2xl sm:text-3xl font-bold">未來展望</h2>
      </div>
      <p class="animate-on-scroll delay-1 text-zinc-400 mb-10 max-w-2xl">AI 的明天會是什麼樣子？</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {future.map((f, i) => (
          <div class={`animate-on-scroll delay-${(i % 4) + 1} p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800/50 hover:border-accent/30 transition-all duration-300 text-center`}>
            <span class="text-3xl mb-4 block">{f.icon}</span>
            <h3 class="text-base font-semibold text-zinc-200 mb-2">{f.title}</h3>
            <p class="text-zinc-400 text-sm leading-relaxed">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 使用須知 -->
  <section class="py-16" aria-label="AI 使用須知">
    <div class="section-container">
      <h2 class="animate-on-scroll text-2xl sm:text-3xl font-bold mb-10 text-center">使用 AI 的注意事項</h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {guidelines.map((g, i) => (
          <div class={`animate-on-scroll delay-${(i % 4) + 1} p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800/50 text-center`}>
            <span class="text-3xl mb-4 block">{g.icon}</span>
            <h3 class="text-base font-semibold text-zinc-200 mb-2">{g.title}</h3>
            <p class="text-zinc-400 text-sm leading-relaxed">{g.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>
