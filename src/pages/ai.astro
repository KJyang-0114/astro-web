---
import PortfolioLayout from "../layouts/PortfolioLayout.astro";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "AI 探索 — KJyang",
  description: "從基礎概念到未來展望，一次搞懂人工智慧。",
  url: "https://kjyang0114.dev/ai",
  author: { "@type": "Person", name: "楊凱捷", alternateName: "KJyang" },
};

const abilities = [
  {
    icon: "👁️",
    title: "圖像識別",
    desc: "辨識影像中的物體、特徵與文字，效果取決於模型與輸入品質",
  },
  { icon: "💬", title: "語言理解", desc: "處理語言，協助對話、摘要和翻譯" },
  { icon: "📊", title: "數據分析", desc: "從大量數據中發現規律和趨勢" },
  { icon: "🎨", title: "創作輔助", desc: "協助寫作、繪畫、音樂創作" },
  { icon: "🤖", title: "自動化", desc: "自動執行重複性任務" },
  { icon: "🧩", title: "問題解決", desc: "分析複雜問題並提供解決方案" },
];

const limitations = [
  {
    title: "不是萬能的",
    desc: "訓練資料、設計與使用情境都會影響表現，換到不熟悉的任務時尤其需要核對",
  },
  {
    title: "缺乏真正的情感",
    desc: "AI 可以生成像是理解情緒的回應；這不等同於人的情感經驗",
  },
  {
    title: "倫理判斷困難",
    desc: "在複雜的道德和倫理問題上，AI 難以做出完美判斷",
  },
  {
    title: "無法解釋所有決策",
    desc: "某些 AI 系統的決策過程如「黑盒子」般難以解釋",
  },
];

const myths = [
  {
    myth: "AI 會取代所有人類工作",
    fact: "不同任務受到的影響不同，不能直接推論所有工作都會被取代或保留",
  },
  {
    myth: "AI 有自己的意識和想法",
    fact: "流暢對話不能證明自我意識；使用時應依可驗證的能力與限制評估",
  },
  { myth: "AI 總是 100% 準確", fact: "AI 會犯錯，需要人類監督和驗證" },
];

const timeline = [
  {
    year: "1950s",
    title: "AI 概念誕生",
    desc: "圖靈測試 — 艾倫·圖靈討論機器思考與模仿遊戲",
  },
  {
    year: "1980s",
    title: "專家系統興起",
    desc: "以知識規則協助特定領域的判斷",
  },
  {
    year: "2010s",
    title: "深度學習革命",
    desc: "神經網路技術突破，圖像識別準確率大幅提升",
  },
  {
    year: "2020s",
    title: "大語言模型時代",
    desc: "ChatGPT 等工具讓 AI 進入普通人的生活",
  },
];

const future = [
  {
    icon: "🎓",
    title: "個人化教育",
    desc: "探索依學習進度調整內容與練習的可能性",
  },
  {
    icon: "🏥",
    title: "醫療革命",
    desc: "研究如何協助醫療人員整理資料與提供判讀線索",
  },
  { icon: "🌱", title: "環境保護", desc: "智慧城市和可持續發展解決方案" },
  {
    icon: "🤝",
    title: "人機協作",
    desc: "探索人與工具如何分工、核對與共同完成任務",
  },
];

const guidelines = [
  { icon: "🛡️", title: "保護隱私", desc: "使用 AI 時要注意個人隱私和數據安全" },
  { icon: "🔍", title: "批判思考", desc: "不盲目相信 AI 的結果，保持獨立思考" },
  { icon: "🤝", title: "人機協作", desc: "將 AI 視為工具和夥伴，而非替代品" },
  {
    icon: "📚",
    title: "持續學習",
    desc: "AI 技術快速發展，保持學習新知的態度",
  },
];
---

<PortfolioLayout
  title="AI 入門筆記 — KJyang"
  description="從 AI 基礎概念、應用、限制與常見迷思開始，理解工具，再練習核對與使用。"
  jsonLd={jsonLd}
  ><div class="ai-page">
    <header class="page-heading">
      <span class="micro">LEARNING NOTES / AI</span><h1>
        理解工具，<br />才知道怎麼用。
      </h1><p>
        給剛開始接觸 AI 的人。從基礎概念、應用到限制，<br
        />建立一個能繼續提問的起點。
      </p>
    </header><div class="reading-layout">
      <nav class="chapter-nav" aria-label="文章章節">
        <a href="#chapter-1"><span>01</span>基礎概念</a><a href="#chapter-2"
          ><span>02</span>能做什麼</a
        ><a href="#chapter-3"><span>03</span>有哪些限制</a><a href="#chapter-4"
          ><span>04</span>常見迷思</a
        ><a href="#chapter-5"><span>05</span>發展歷程</a><a href="#chapter-6"
          ><span>06</span>未來方向</a
        ><a href="#chapter-7"><span>07</span>使用注意事項</a>
      </nav><article class="reading-body">
        <section id="chapter-1">
          <span class="micro">01 / FOUNDATIONS</span><h2>AI 基礎概念</h2><p>
            人工智慧是一組讓電腦執行辨識、預測、生成與決策等任務的方法。機器學習、深度學習、自然語言處理，是其中常見的領域。
          </p><p>
            從語音助手、推薦系統，到現在的對話工具，AI
            已經出現在許多日常流程裡。不同系統的能力與限制也不同。
          </p>
        </section><section id="chapter-2">
          <span class="micro">02 / AI NOTES</span><h2>AI 能做什麼</h2><div
            class="note-grid"
          >
            {
              abilities.map((item) => (
                <div>
                  <>
                    <h3>{item.title}</h3>
                    <p>{item.desc}</p>
                  </>
                </div>
              ))
            }
          </div>
        </section><section id="chapter-3">
          <span class="micro">03 / AI NOTES</span><h2>AI 的限制</h2><div
            class="note-grid"
          >
            {
              limitations.map((item) => (
                <div>
                  <>
                    <h3>{item.title}</h3>
                    <p>{item.desc}</p>
                  </>
                </div>
              ))
            }
          </div>
        </section><section id="chapter-4">
          <span class="micro">04 / QUESTIONS</span><h2>常見迷思</h2>{
            myths.map((item) => (
              <details>
                <>
                  <summary>
                    {item.myth}
                    <span aria-hidden="true">＋</span>
                  </summary>
                  <p>{item.fact}</p>
                </>
              </details>
            ))
          }
        </section><section id="chapter-5">
          <span class="micro">05 / HISTORY</span><h2>AI 發展歷程</h2><div
            class="timeline"
          >
            {
              timeline.map((item) => (
                <article>
                  <>
                    <span>{item.year}</span>
                    <h3>{item.title}</h3>
                    <p>{item.desc}</p>
                  </>
                </article>
              ))
            }
          </div>
        </section><section id="chapter-6">
          <span class="micro">06 / POSSIBILITIES</span><h2>未來方向</h2><p>
            以下是持續探索的方向，並非每一項都已成熟或能保證效果。
          </p><div class="note-grid">
            {
              future.map((item) => (
                <div>
                  <>
                    <h3>{item.title}</h3>
                    <p>{item.desc}</p>
                  </>
                </div>
              ))
            }
          </div>
        </section><section id="chapter-7">
          <span class="micro">07 / IN PRACTICE</span><h2>
            使用 AI 的注意事項
          </h2><div class="note-grid">
            {
              guidelines.map((item) => (
                <div>
                  <>
                    <h3>{item.title}</h3>
                    <p>{item.desc}</p>
                  </>
                </div>
              ))
            }
          </div><a class="text-link" href="/projects"
            >看看我怎麼把 AI 放進作品 ↗</a>
        </section><section class="reading-sources">
          <h2>繼續閱讀</h2><p>
            這份筆記整理入門概念，並不取代各工具的使用文件。
          </p><a
            class="text-link"
            href="https://www.ibm.com/think/topics/artificial-intelligence"
            >IBM / Artificial intelligence ↗</a
          ><a
            class="text-link"
            href="https://www.nist.gov/itl/ai-risk-management-framework"
            >NIST / AI Risk Management Framework ↗</a>
        </section>
      </article>
    </div>
  </div></PortfolioLayout
>
