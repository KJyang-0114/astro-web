---
import Layout from '../layouts/Layout.astro';
---

<Layout title="AI 跨星際快線 - KJyang" description="搭乘知識快車，探索 AI 宇宙，從基礎概念到未來展望的完整旅程">
  <div class="ai-page">
    <!-- 英雄區 - 跨星際高鐵駕駛艙 -->
    <section class="hero-section">
      <div class="stars-background"></div>
      <div class="speed-lines"></div>
      <div class="hero-content">
        <div class="destination-board">
          <h1 class="destination-title">
            <i class="fas fa-rocket"></i>
            探索 AI 宇宙
          </h1>
          <p class="destination-subtitle">下一站，智慧未來</p>
          <div class="journey-info">
            <span class="journey-text">搭乘知識快車，穿越 AI 迷霧，抵達理解彼岸</span>
          </div>
        </div>
        <div class="control-panel">
          <div class="speed-indicator">
            <span class="speed-label">學習速度</span>
            <span class="speed-value">∞ 光速</span>
          </div>
          <div class="route-map">
            <span class="route-label">路線</span>
            <span class="route-value">基礎 → 應用 → 未來</span>
          </div>
        </div>
      </div>
      <div class="scroll-indicator">
        <i class="fas fa-chevron-down"></i>
        <span>開始旅程</span>
      </div>
    </section>

    <!-- 主要內容區 - 車站系統 -->
    <section class="stations-section">
      <div class="stations-container">
        
        <!-- 第一站：AI 是什麼？ -->
        <div class="station" data-station="1">
          <div class="station-header">
            <div class="station-number">01</div>
            <h2 class="station-title">AI 基礎概念站</h2>
            <p class="station-subtitle">什麼是人工智慧？</p>
          </div>
          <div class="station-content">
            <div class="concept-cards">
              <div class="concept-card">
                <i class="fas fa-brain"></i>
                <h3>簡單來說</h3>
                <p>AI 就像一個超級聰明的助手，能夠學習、思考和解決問題。想像一下，如果你的電腦突然會思考了！</p>
              </div>
              <div class="concept-card">
                <i class="fas fa-cogs"></i>
                <h3>技術角度</h3>
                <p>AI 是讓機器模擬人類智慧的技術，包括機器學習、深度學習、自然語言處理等多個領域。</p>
              </div>
              <div class="concept-card">
                <i class="fas fa-lightbulb"></i>
                <h3>生活應用</h3>
                <p>從手機的語音助手到推薦系統，AI 已經悄悄融入我們的日常生活中。</p>
              </div>
            </div>
          </div>
        </div>

        <!-- 第二站：AI 的超能力 -->
        <div class="station" data-station="2">
          <div class="station-header">
            <div class="station-number">02</div>
            <h2 class="station-title">AI 超能力展示站</h2>
            <p class="station-subtitle">AI 能做什麼？</p>
          </div>
          <div class="station-content">
            <div class="abilities-grid">
              <div class="ability-item">
                <i class="fas fa-eye"></i>
                <h4>圖像識別</h4>
                <p>瞬間識別照片中的物體、人臉、文字</p>
              </div>
              <div class="ability-item">
                <i class="fas fa-comments"></i>
                <h4>語言理解</h4>
                <p>理解人類語言，進行對話和翻譯</p>
              </div>
              <div class="ability-item">
                <i class="fas fa-chart-line"></i>
                <h4>數據分析</h4>
                <p>從大量數據中發現規律和趨勢</p>
              </div>
              <div class="ability-item">
                <i class="fas fa-paint-brush"></i>
                <h4>創作輔助</h4>
                <p>協助寫作、繪畫、音樂創作</p>
              </div>
              <div class="ability-item">
                <i class="fas fa-robot"></i>
                <h4>自動化</h4>
                <p>自動執行重複性任務</p>
              </div>
              <div class="ability-item">
                <i class="fas fa-puzzle-piece"></i>
                <h4>問題解決</h4>
                <p>分析複雜問題並提供解決方案</p>
              </div>
            </div>
          </div>
        </div>

        <!-- 第三站：AI 的邊界 -->
        <div class="station" data-station="3">
          <div class="station-header">
            <div class="station-number">03</div>
            <h2 class="station-title">AI 邊界警示站</h2>
            <p class="station-subtitle">AI 有什麼限制？</p>
          </div>
          <div class="station-content">
            <div class="limitations-list">
              <div class="limitation-item">
                <i class="fas fa-exclamation-triangle"></i>
                <h4>不是萬能的</h4>
                <p>AI 需要大量數據訓練，在沒有足夠數據的領域表現有限</p>
              </div>
              <div class="limitation-item">
                <i class="fas fa-heart"></i>
                <h4>缺乏真正的情感</h4>
                <p>AI 可以模擬情感反應，但不具備真正的感情和同理心</p>
              </div>
              <div class="limitation-item">
                <i class="fas fa-balance-scale"></i>
                <h4>倫理判斷困難</h4>
                <p>在複雜的道德和倫理問題上，AI 難以做出完美判斷</p>
              </div>
              <div class="limitation-item">
                <i class="fas fa-question-circle"></i>
                <h4>無法解釋所有決策</h4>
                <p>某些 AI 系統的決策過程如「黑盒子」般難以解釋</p>
              </div>
            </div>
          </div>
        </div>

        <!-- 第四站：破解 AI 迷思 -->
        <div class="station" data-station="4">
          <div class="station-header">
            <div class="station-number">04</div>
            <h2 class="station-title">迷思破解站</h2>
            <p class="station-subtitle">常見誤解澄清</p>
          </div>
          <div class="station-content">
            <div class="myths-container">
              <div class="myth-item">
                <div class="myth-false">
                  <i class="fas fa-times-circle"></i>
                  <strong>迷思：</strong>AI 會取代所有人類工作
                </div>
                <div class="myth-true">
                  <i class="fas fa-check-circle"></i>
                  <strong>實際：</strong>AI 更多是協助人類，創造新的工作機會
                </div>
              </div>
              <div class="myth-item">
                <div class="myth-false">
                  <i class="fas fa-times-circle"></i>
                  <strong>迷思：</strong>AI 有自己的意識和想法
                </div>
                <div class="myth-true">
                  <i class="fas fa-check-circle"></i>
                  <strong>實際：</strong>AI 是按程序運行，沒有真正的自我意識
                </div>
              </div>
              <div class="myth-item">
                <div class="myth-false">
                  <i class="fas fa-times-circle"></i>
                  <strong>迷思：</strong>AI 總是 100% 準確
                </div>
                <div class="myth-true">
                  <i class="fas fa-check-circle"></i>
                  <strong>實際：</strong>AI 會犯錯，需要人類監督和驗證
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 第五站：AI 發展時刻表 -->
        <div class="station" data-station="5">
          <div class="station-header">
            <div class="station-number">05</div>
            <h2 class="station-title">時空軌跡站</h2>
            <p class="station-subtitle">AI 發展歷程</p>
          </div>
          <div class="station-content">
            <div class="timeline">
              <div class="timeline-item">
                <div class="year">1950s</div>
                <div class="event">
                  <h4>AI 概念誕生</h4>
                  <p>圖靈測試，AI 之父艾倫·圖靈提出機器思考的可能性</p>
                </div>
              </div>
              <div class="timeline-item">
                <div class="year">1980s</div>
                <div class="event">
                  <h4>專家系統興起</h4>
                  <p>第一波 AI 商業化應用</p>
                </div>
              </div>
              <div class="timeline-item">
                <div class="year">2010s</div>
                <div class="event">
                  <h4>深度學習革命</h4>
                  <p>神經網路技術突破，圖像識別準確率大幅提升</p>
                </div>
              </div>
              <div class="timeline-item">
                <div class="year">2020s</div>
                <div class="event">
                  <h4>大語言模型時代</h4>
                  <p>ChatGPT 等工具讓 AI 進入普通人的生活</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 終點站：未來展望 -->
        <div class="station" data-station="6">
          <div class="station-header">
            <div class="station-number">∞</div>
            <h2 class="station-title">未來展望站</h2>
            <p class="station-subtitle">AI 的明天</p>
          </div>
          <div class="station-content">
            <div class="future-vision">
              <div class="vision-card">
                <i class="fas fa-graduation-cap"></i>
                <h4>個人化教育</h4>
                <p>AI 將為每個人提供量身定制的學習體驗</p>
              </div>
              <div class="vision-card">
                <i class="fas fa-heartbeat"></i>
                <h4>醫療革命</h4>
                <p>精準診斷和個人化治療方案</p>
              </div>
              <div class="vision-card">
                <i class="fas fa-leaf"></i>
                <h4>環境保護</h4>
                <p>智慧城市和可持續發展解決方案</p>
              </div>
              <div class="vision-card">
                <i class="fas fa-users"></i>
                <h4>人機協作</h4>
                <p>AI 成為人類最好的工作夥伴</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 乘車須知 -->
    <section class="guidelines-section">
      <div class="guidelines-container">
        <h2 class="guidelines-title">
          <i class="fas fa-info-circle"></i>
          乘車須知
        </h2>
        <div class="guidelines-content">
          <div class="guideline">
            <i class="fas fa-shield-alt"></i>
            <h4>保護隱私</h4>
            <p>使用 AI 時要注意個人隱私和數據安全</p>
          </div>
          <div class="guideline">
            <i class="fas fa-search"></i>
            <h4>批判思考</h4>
            <p>不盲目相信 AI 的結果，保持獨立思考</p>
          </div>
          <div class="guideline">
            <i class="fas fa-handshake"></i>
            <h4>人機協作</h4>
            <p>將 AI 視為工具和夥伴，而非替代品</p>
          </div>
          <div class="guideline">
            <i class="fas fa-book"></i>
            <h4>持續學習</h4>
            <p>AI 技術快速發展，保持學習新知的態度</p>
          </div>
        </div>
      </div>
    </section>
  </div>

  <style>
    /* 跨星際高鐵主題樣式 */
    .ai-page {
      position: relative;
      background: linear-gradient(135deg, #0f1419 0%, #1a1a2e 50%, #16213e 100%);
      min-height: 100vh;
    }

    /* 英雄區 - 駕駛艙設計 */
    .hero-section {
      position: relative;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      background: radial-gradient(ellipse at center, #0f1419 0%, #000814 100%);
    }

    .stars-background {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: 
        radial-gradient(2px 2px at 20px 30px, #00d4ff, transparent),
        radial-gradient(2px 2px at 40px 70px, #fff, transparent),
        radial-gradient(1px 1px at 90px 40px, #00ff88, transparent),
        radial-gradient(1px 1px at 130px 80px, #6a4c93, transparent),
        radial-gradient(2px 2px at 160px 30px, #00d4ff, transparent);
      background-repeat: repeat;
      background-size: 200px 100px;
      animation: starsMove 20s linear infinite;
    }

    .speed-lines {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: repeating-linear-gradient(
        90deg,
        transparent,
        transparent 100px,
        rgba(0, 212, 255, 0.1) 102px,
        rgba(0, 212, 255, 0.3) 103px,
        transparent 105px
      );
      animation: speedLines 2s linear infinite;
    }

    @keyframes starsMove {
      0% { transform: translateX(0) translateY(0); }
      100% { transform: translateX(-200px) translateY(-100px); }
    }

    @keyframes speedLines {
      0% { transform: translateX(-100px); }
      100% { transform: translateX(100px); }
    }

    .hero-content {
      position: relative;
      z-index: 10;
      text-align: center;
      max-width: 800px;
      padding: 2rem;
    }

    .destination-board {
      background: rgba(15, 20, 25, 0.9);
      backdrop-filter: blur(10px);
      border: 2px solid #00d4ff;
      border-radius: 20px;
      padding: 3rem 2rem;
      margin-bottom: 2rem;
      box-shadow: 0 0 50px rgba(0, 212, 255, 0.3);
    }

    .destination-title {
      font-size: 3.5rem;
      font-weight: 900;
      color: #00d4ff;
      margin-bottom: 1rem;
      text-shadow: 0 0 20px rgba(0, 212, 255, 0.5);
    }

    .destination-title i {
      margin-right: 1rem;
      animation: pulse 2s ease-in-out infinite;
    }

    .destination-subtitle {
      font-size: 1.5rem;
      color: #00ff88;
      margin-bottom: 1.5rem;
      font-weight: 600;
    }

    .journey-info {
      font-size: 1.1rem;
      color: #a0a0a0;
      font-style: italic;
    }

    .control-panel {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      margin-top: 2rem;
    }

    .speed-indicator, .route-map {
      background: rgba(15, 20, 25, 0.8);
      border: 1px solid #6a4c93;
      border-radius: 10px;
      padding: 1rem;
      text-align: center;
    }

    .speed-label, .route-label {
      display: block;
      color: #a0a0a0;
      font-size: 0.9rem;
      margin-bottom: 0.5rem;
    }

    .speed-value, .route-value {
      color: #00ff88;
      font-weight: bold;
      font-size: 1.1rem;
    }

    .scroll-indicator {
      position: absolute;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%);
      color: #00d4ff;
      text-align: center;
      animation: bounce 2s ease-in-out infinite;
    }

    .scroll-indicator i {
      font-size: 1.5rem;
      margin-bottom: 0.5rem;
      display: block;
    }

    /* 車站系統設計 */
    .stations-section {
      padding: 4rem 0;
      background: linear-gradient(180deg, #0f1419 0%, #1a1a2e 100%);
    }

    .stations-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    .station {
      margin-bottom: 4rem;
      background: rgba(30, 30, 30, 0.9);
      border-radius: 20px;
      overflow: hidden;
      border: 1px solid #333;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .station:hover {
      transform: translateY(-5px);
      box-shadow: 0 20px 40px rgba(0, 212, 255, 0.1);
    }

    .station-header {
      background: linear-gradient(135deg, #00d4ff 0%, #6a4c93 100%);
      padding: 2rem;
      color: white;
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    .station-number {
      background: rgba(255, 255, 255, 0.2);
      width: 60px;
      height: 60px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      font-weight: bold;
    }

    .station-title {
      font-size: 2rem;
      margin: 0;
      flex: 1;
    }

    .station-subtitle {
      color: rgba(255, 255, 255, 0.8);
      margin: 0;
      font-size: 1.1rem;
    }

    .station-content {
      padding: 2rem;
    }

    /* 概念卡片 */
    .concept-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.5rem;
    }

    .concept-card {
      background: rgba(0, 212, 255, 0.1);
      padding: 1.5rem;
      border-radius: 15px;
      border: 1px solid rgba(0, 212, 255, 0.3);
      text-align: center;
      transition: transform 0.3s ease;
    }

    .concept-card:hover {
      transform: scale(1.05);
    }

    .concept-card i {
      font-size: 2.5rem;
      color: #00d4ff;
      margin-bottom: 1rem;
    }

    .concept-card h3 {
      color: #00ff88;
      margin-bottom: 1rem;
    }

    /* 能力網格 */
    .abilities-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
    }

    .ability-item {
      background: rgba(0, 255, 136, 0.1);
      padding: 1.5rem;
      border-radius: 15px;
      border: 1px solid rgba(0, 255, 136, 0.3);
      text-align: center;
      transition: transform 0.3s ease;
    }

    .ability-item:hover {
      transform: translateY(-5px);
    }

    .ability-item i {
      font-size: 2rem;
      color: #00ff88;
      margin-bottom: 1rem;
    }

    .ability-item h4 {
      color: #00d4ff;
      margin-bottom: 0.5rem;
    }

    /* 限制列表 */
    .limitations-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.5rem;
    }

    .limitation-item {
      background: rgba(255, 107, 107, 0.1);
      padding: 1.5rem;
      border-radius: 15px;
      border: 1px solid rgba(255, 107, 107, 0.3);
      display: flex;
      align-items: flex-start;
      gap: 1rem;
    }

    .limitation-item i {
      color: #ff6b6b;
      font-size: 1.5rem;
      margin-top: 0.2rem;
    }

    .limitation-item h4 {
      color: #ff6b6b;
      margin-bottom: 0.5rem;
    }

    /* 迷思容器 */
    .myths-container {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .myth-item {
      background: rgba(106, 76, 147, 0.1);
      padding: 1.5rem;
      border-radius: 15px;
      border: 1px solid rgba(106, 76, 147, 0.3);
    }

    .myth-false {
      color: #ff6b6b;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .myth-true {
      color: #00ff88;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    /* 時間線 */
    .timeline {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      position: relative;
    }

    .timeline::before {
      content: '';
      position: absolute;
      left: 30px;
      top: 0;
      bottom: 0;
      width: 3px;
      background: linear-gradient(180deg, #00d4ff 0%, #6a4c93 100%);
    }

    .timeline-item {
      display: flex;
      align-items: flex-start;
      gap: 2rem;
    }

    .year {
      background: #00d4ff;
      color: #000;
      padding: 0.5rem 1rem;
      border-radius: 20px;
      font-weight: bold;
      min-width: 80px;
      text-align: center;
    }

    .event {
      flex: 1;
      background: rgba(0, 212, 255, 0.1);
      padding: 1.5rem;
      border-radius: 15px;
      border: 1px solid rgba(0, 212, 255, 0.3);
    }

    .event h4 {
      color: #00d4ff;
      margin-bottom: 0.5rem;
    }

    /* 未來願景 */
    .future-vision {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
    }

    .vision-card {
      background: rgba(0, 255, 136, 0.1);
      padding: 1.5rem;
      border-radius: 15px;
      border: 1px solid rgba(0, 255, 136, 0.3);
      text-align: center;
      transition: transform 0.3s ease;
    }

    .vision-card:hover {
      transform: scale(1.05);
    }

    .vision-card i {
      font-size: 2.5rem;
      color: #00ff88;
      margin-bottom: 1rem;
    }

    .vision-card h4 {
      color: #00d4ff;
      margin-bottom: 0.5rem;
    }

    /* 乘車須知 */
    .guidelines-section {
      background: rgba(0, 8, 20, 0.9);
      padding: 4rem 0;
      border-top: 1px solid #333;
    }

    .guidelines-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    .guidelines-title {
      text-align: center;
      font-size: 2.5rem;
      color: #00d4ff;
      margin-bottom: 3rem;
    }

    .guidelines-title i {
      margin-right: 1rem;
    }

    .guidelines-content {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2rem;
    }

    .guideline {
      background: rgba(30, 30, 30, 0.9);
      padding: 2rem;
      border-radius: 15px;
      border: 1px solid #333;
      text-align: center;
      transition: transform 0.3s ease;
    }

    .guideline:hover {
      transform: translateY(-5px);
      border-color: #00d4ff;
    }

    .guideline i {
      font-size: 2.5rem;
      color: #00ff88;
      margin-bottom: 1rem;
    }

    .guideline h4 {
      color: #00d4ff;
      margin-bottom: 1rem;
    }

    /* 響應式設計 */
    @media (max-width: 768px) {
      .destination-title {
        font-size: 2.5rem;
      }

      .control-panel {
        grid-template-columns: 1fr;
      }

      .concept-cards,
      .abilities-grid,
      .limitations-list,
      .future-vision,
      .guidelines-content {
        grid-template-columns: 1fr;
      }

      .station-header {
        flex-direction: column;
        text-align: center;
        gap: 1rem;
      }

      .station-title {
        font-size: 1.5rem;
      }

      .timeline::before {
        left: 15px;
      }

      .year {
        min-width: 60px;
      }

      .myth-false,
      .myth-true {
        flex-direction: column;
        align-items: flex-start;
      }
    }

    /* 動畫效果 */
    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.1); }
    }

    @keyframes bounce {
      0%, 20%, 50%, 80%, 100% { transform: translateX(-50%) translateY(0); }
      40% { transform: translateX(-50%) translateY(-10px); }
      60% { transform: translateX(-50%) translateY(-5px); }
    }

    /* 滾動觸發動畫 */
    .station {
      opacity: 0;
      transform: translateY(50px);
      transition: opacity 0.6s ease, transform 0.6s ease;
    }

    .station.visible {
      opacity: 1;
      transform: translateY(0);
    }
  </style>

  <script>
    // 滾動觸發動畫
    const stations = document.querySelectorAll('.station');
    
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const stationObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, observerOptions);

    stations.forEach(station => {
      stationObserver.observe(station);
    });

    // 平滑滾動到第一個車站
    const scrollIndicator = document.querySelector('.scroll-indicator');
    if (scrollIndicator) {
      scrollIndicator.addEventListener('click', () => {
        const firstStation = document.querySelector('.station');
        if (firstStation) {
          firstStation.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }

    // 星空背景交互效果
    const heroSection = document.querySelector('.hero-section');
    if (heroSection) {
      heroSection.addEventListener('mousemove', (e) => {
        const stars = document.querySelector('.stars-background') as HTMLElement;
        if (stars && e instanceof MouseEvent) {
          const x = (e.clientX / window.innerWidth) * 100;
          const y = (e.clientY / window.innerHeight) * 100;
          
          stars.style.transform = `translate(${x * 0.1}px, ${y * 0.1}px)`;
        }
      });
    }
  </script>
</Layout>
