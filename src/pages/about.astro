---
import Layout from '../layouts/Layout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "mainEntity": {
    "@type": "Person",
    "name": "楊凱捷",
    "alternateName": ["KJyang", "imw1nt0r"],
    "description": "鶯歌工商資訊科學生，全端開發者，AI 愛好者",
    "affiliation": { "@type": "EducationalOrganization", "name": "新北市立鶯歌工商", "department": { "@type": "EducationalOrganization", "name": "資訊科" } }
  }
};

const timeline = [
  {
    period: "現在",
    title: "鶯歌工商 · 資訊科",
    note: "課內學硬體和基礎，課外自己鑽研 AI 跟 Web 開發。兩邊加起來學得比較完整。",
  },
  {
    period: "一路以來",
    title: "從 HTML 到 LLM",
    note: "最早碰的是基本的 HTML CSS，然後學 JS，然後 React、Vue、Python，然後就掉進 AI 的坑了。學新技術對我來說不是負擔，比較像打電動解任務。",
  },
  {
    period: "接下來",
    title: "繼續挖更深",
    note: "AI 這條路還很長，我想做的不只是「會用 ChatGPT」，而是真的理解底層、能整合進產品的那種。",
  },
];
---

<Layout
  title="關於我 — KJyang | 鶯歌工商資訊科全端開發者"
  description="關於 KJyang — 鶯歌工商資訊科學生、全端開發者、AI 研究者。從 HTML 自學到 LLM 整合開發，也是 aespa 的忠實粉絲。"
  jsonLd={jsonLd}
>

  <section class="pt-32 pb-16 relative overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-30 pointer-events-none"></div>
    <div class="absolute top-0 right-0 w-96 h-96 bg-brand/10 rounded-full blur-[100px] pointer-events-none"></div>
    
    <div class="section-container relative z-10">
      <h1 class="animate-on-scroll text-5xl sm:text-6xl font-black mb-6 tracking-tight">
        關於我
      </h1>
      <p class="animate-on-scroll delay-1 text-xl text-zinc-400 max-w-2xl leading-relaxed font-medium">
        網路上叫 KJyang，IG 叫 <a href="https://www.instagram.com/imw1nt0r/" target="_blank" rel="noopener noreferrer" class="text-brand hover:text-brand-light transition-colors">@imw1nt0r</a>。鶯歌工商資訊科。
      </p>
    </div>
  </section>

  <!-- The Real Story -->
  <section class="py-16 relative" aria-label="我的故事">
    <div class="section-container">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">
        <div class="lg:col-span-3">
          <h2 class="animate-on-scroll text-3xl font-bold mb-8 flex items-center gap-3">
            <span class="w-2 h-8 bg-brand rounded-full"></span>
            我是誰
          </h2>
          <div class="animate-on-scroll delay-1 space-y-6 text-lg text-zinc-300 leading-relaxed">
            <p>
              高中生，讀鶯歌工商資訊科。但老實說在學校學的跟我自己在外面學的差蠻多的 — 
              學校教基礎，我自己研究比較前沿的東西。兩邊互補，我覺得這樣蠻好的。
            </p>
            <p>
              我最強的地方大概是<strong class="text-white font-semibold">學東西很快</strong>。
              不是那種天才型的快，是我很會利用工具。LLM 出來之後我的學習效率直接翻倍 — 
              遇到不懂的直接問，看文件看不懂就叫 AI 解釋，然後自己動手寫驗證。
              這套方法讓我可以短時間上手一個全新的框架或語言。
            </p>
            <p>
              技術面來說，我什麼都碰一點。前端 React、Vue 寫過，後端 Python FastAPI 也行，
              AI 方面從 Prompt Engineering 到強化學習都有在玩。
              最近比較專注在 <strong class="text-white font-semibold">LLM 的實際應用</strong> — 
              不是那種只會 call API 的，是真的有在想怎麼把 AI 整合進實際的產品流程裡面。
            </p>
            <p>
              寫 code 之外，我追 aespa。
              這個跟技術完全沒關係，但就是我的一部分啊。
            </p>
            <p>
              我老婆 winter 的舞台表現力真的沒話說，
              最愛的歌還是 Drama。我是 Dirty Work 時期入坑的，
              應該也算是比較新的 MY 了。
              有時候寫程式寫到累了，就去滑一下脆、看一下 aespa，整個心情又好了。
            </p>
          </div>
        </div>

        <aside class="lg:col-span-2">
          <div class="animate-on-scroll delay-2 p-8 rounded-3xl glass-card border border-white/5 sticky top-24">
            <h3 class="text-xl font-bold mb-8 text-zinc-100 flex items-center gap-2">
              <svg class="w-5 h-5 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
              基本資料
            </h3>
            <dl class="space-y-6">
              <div class="group">
                <dt class="text-xs font-mono text-zinc-500 uppercase tracking-wider mb-1 group-hover:text-brand transition-colors">暱稱</dt>
                <dd class="text-lg font-medium text-zinc-200">KJyang</dd>
              </div>
              <div class="w-full h-px bg-white/5"></div>
              <div class="group">
                <dt class="text-xs font-mono text-zinc-500 uppercase tracking-wider mb-1 group-hover:text-brand transition-colors">學校</dt>
                <dd class="text-lg font-medium text-zinc-200">鶯歌工商 · 資訊科</dd>
              </div>
              <div class="w-full h-px bg-white/5"></div>
              <div class="group">
                <dt class="text-xs font-mono text-zinc-500 uppercase tracking-wider mb-1 group-hover:text-brand transition-colors">擅長</dt>
                <dd class="text-lg font-medium text-zinc-200">AI / LLM 應用 · 全端開發</dd>
              </div>
              <div class="w-full h-px bg-white/5"></div>
              <div class="group">
                <dt class="text-xs font-mono text-zinc-500 uppercase tracking-wider mb-1 group-hover:text-brand transition-colors">主力語言</dt>
                <dd class="text-lg font-medium text-zinc-200">Python · TypeScript · Java</dd>
              </div>
              <div class="w-full h-px bg-white/5"></div>
              <div class="group">
                <dt class="text-xs font-mono text-zinc-500 uppercase tracking-wider mb-1 group-hover:text-brand transition-colors">追星</dt>
                <dd class="text-lg font-medium text-zinc-200 flex items-center gap-2">aespa 🖤 <span class="text-xs bg-zinc-800 px-2 py-0.5 rounded-full text-zinc-400">MY</span></dd>
              </div>
              <div class="w-full h-px bg-white/5"></div>
              <div class="group">
                <dt class="text-xs font-mono text-zinc-500 uppercase tracking-wider mb-1 group-hover:text-brand transition-colors">地點</dt>
                <dd class="text-lg font-medium text-zinc-200">新北市</dd>
              </div>
            </dl>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="py-20 relative" aria-label="學習歷程">
    <div class="absolute inset-0 bg-zinc-900/20 skew-y-3 transform origin-bottom-right"></div>
    <div class="section-container relative z-10">
      <h2 class="animate-on-scroll text-3xl font-bold mb-16 flex items-center gap-3">
        <span class="w-2 h-8 bg-accent rounded-full"></span>
        到目前為止
      </h2>

      <div class="relative max-w-3xl mx-auto">
        <div class="absolute left-4 top-0 bottom-0 w-px bg-gradient-to-b from-brand via-accent to-transparent" aria-hidden="true"></div>

        <div class="space-y-16">
          {timeline.map((item, i) => (
            <div class={`animate-on-scroll delay-${i + 1} relative pl-16 group`}>
              <div class="absolute left-1.5 top-2 w-5 h-5 rounded-full bg-zinc-950 border-4 border-brand group-hover:border-accent transition-colors shadow-[0_0_15px_rgba(99,102,241,0.5)]" aria-hidden="true"></div>
              <span class="inline-block px-3 py-1 mb-2 text-xs font-mono font-bold text-brand bg-brand/10 rounded-full group-hover:text-accent group-hover:bg-accent/10 transition-colors">{item.period}</span>
              <h3 class="text-2xl font-bold text-zinc-100 mb-3">{item.title}</h3>
              <p class="text-zinc-400 text-lg leading-relaxed">{item.note}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- What I Believe -->
  <section class="py-20" aria-label="我的想法">
    <div class="section-container">
      <h2 class="animate-on-scroll text-3xl font-bold mb-10 flex items-center gap-3">
        <span class="w-2 h-8 bg-zinc-600 rounded-full"></span>
        我怎麼看事情
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="animate-on-scroll delay-1 p-8 rounded-3xl glass-card border border-white/5 hover:bg-zinc-900/80 transition-colors">
          <h3 class="text-xl font-bold text-zinc-100 mb-4">工具用好就是實力</h3>
          <p class="text-zinc-400 leading-relaxed">
            有人覺得用 AI 輔助寫 code 是作弊。我覺得不是 — 
            知道怎麼問、怎麼驗證、怎麼整合，這本身就是一種能力。
            重點是你能不能交出東西。
          </p>
        </div>

        <div class="animate-on-scroll delay-2 p-8 rounded-3xl glass-card border border-white/5 hover:bg-zinc-900/80 transition-colors">
          <h3 class="text-xl font-bold text-zinc-100 mb-4">先做再說</h3>
          <p class="text-zinc-400 leading-relaxed">
            想太多不如直接開幹。遇到問題再解決。
            我大部分的專案都是「欸感覺可以做」然後就開始寫了，
            寫到一半發現比想像中複雜，但也因為已經開始了所以會想辦法做完。
          </p>
        </div>

        <div class="animate-on-scroll delay-3 p-8 rounded-3xl glass-card border border-white/5 hover:bg-zinc-900/80 transition-colors">
          <h3 class="text-xl font-bold text-zinc-100 mb-4">不設限</h3>
          <p class="text-zinc-400 leading-relaxed">
            前端、後端、AI、遊戲開發、甚至 iOS — 什麼有趣就學什麼。
            高中生的優勢就是時間還多，現在不多嘗試什麼時候試？
          </p>
        </div>

        <div class="animate-on-scroll delay-4 p-8 rounded-3xl glass-card border border-white/5 hover:bg-zinc-900/80 transition-colors">
          <h3 class="text-xl font-bold text-zinc-100 mb-4">開源是基本</h3>
          <p class="text-zinc-400 leading-relaxed">
            我的東西全部放 GitHub。一方面是給自己記錄，一方面是希望別人也能從中學到什麼。
            反正藏起來也不會比較值錢。
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20">
    <div class="section-container text-center">
      <div class="animate-on-scroll p-12 rounded-3xl bg-gradient-to-br from-brand/20 to-accent/20 border border-white/10 relative overflow-hidden">
        <div class="absolute inset-0 bg-grid opacity-20"></div>
        <h2 class="text-3xl font-bold mb-4 relative z-10">想看實際成果？</h2>
        <p class="text-zinc-300 mb-8 text-lg relative z-10">文字說再多不如直接看 code。</p>
        <a href="/projects" class="relative z-10 inline-flex items-center gap-2 px-8 py-4 bg-white text-zinc-950 font-bold rounded-full hover:scale-105 active:scale-95 transition-all shadow-xl shadow-white/10">
          作品集
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
    </div>
  </section>

</Layout>
