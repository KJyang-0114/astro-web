---
import PortfolioLayout from "../layouts/PortfolioLayout.astro";
import { person } from "../data/person";
const beliefs = [
  [
    "工具用好就是實力",
    "知道怎麼問、怎麼驗證、怎麼整合，本身就是能力。最終還是要能交出可用的東西。",
  ],
  [
    "先做再說",
    "很多作品從「感覺可以做」開始。先建立能操作的版本，再把遇到的問題一個個拆開。",
  ],
  ["不設限", "前端、後端、AI、遊戲與行動應用，遇到有趣的問題就試著學。"],
  [
    "開源是基本",
    "把作品與學習放上 GitHub，留下過程，也讓別人能讀懂、核對與延伸。",
  ],
];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://kjyang0114.dev/about#profile",
  url: "https://kjyang0114.dev/about",
  name: "關於楊凱捷 / KJyang",
  inLanguage: "zh-Hant",
  mainEntity: person,
};
---

<PortfolioLayout
  title="關於楊凱捷｜鶯歌工商資訊科的自學與開發經歷 — KJyang"
  description="我是楊凱捷（KJyang），就讀鶯歌工商資訊科。從 HTML 自學到 Python、Web 與 AI 整合，這裡記錄我的學習方式、公開作品與遠端開發經歷。"
  jsonLd={jsonLd}
>
  <div class="about-page">
    <span class="micro">ABOUT THE BUILDER</span><h1>
      先開始做。<br />再學會<span>負責。</span>
    </h1><div class="about-grid">
      <section>
        <h2>楊凱捷 / KJyang</h2><p>
          我是楊凱捷，也叫 KJyang，就讀鶯歌工商資訊科，住在新北市。學校教硬體與基礎，課外則自己研究
          AI 和 Web，兩邊互補。
        </p><p>
          從 HTML、CSS、JavaScript 開始，慢慢寫到 React、Vue、Python FastAPI 與
          LLM 應用。主力語言是
          Python、TypeScript、Java；比起列出更多工具，我更想理解它們怎麼接成真正可用的流程。
        </p><p>
          遇到不懂的地方，會用 LLM
          解釋文件、比較方案、建立初稿，再自己動手執行、讀錯誤、核對結果。工具能幫我更快開始，判斷與最後交付仍由我負責。
        </p><p>
          課外寫的程式，也放在這裡。像是從題目圖片開始的
          <a href="/projects/discord">Discord 解題機器人</a>、研究程式碼分析的
          <a href="/projects/sift">Sift</a>，以及用
          <a href="/projects/rl">2048 練習強化學習</a>。
          每個作品頁都保留實作方式、目前限制與原始碼，方便接著看下去。
        </p><a class="text-link" href="https://github.com/KJyang-0114"
          >在 GitHub 看我的紀錄 ↗</a>
      </section><div class="timeline">
        <article>
          <span>2024 / START</span><h3>從 AI 輔助開發開始</h3><p>
            使用 Claude 3.5，把想法做成可執行版本，也開始學習如何驗證 AI
            產生的結果。
          </p>
        </article><article>
          <span>2025 / DELIVERY</span><h3>理解交付的重量</h3><p>
            教育科技公司負責人透過個人網站主動聯絡。第一次面對
            NDA、成本、款項與交付邊界，讓我理解寫出程式與交付專案之間的距離。
          </p>
        </article><article>
          <span>NEXT / KEEP LEARNING</span><h3>繼續往裡面看</h3><p>
            想理解 AI 的底層與限制，也練習把模型放進真實產品流程，而不只停在 API
            呼叫。
          </p>
        </article>
      </div>
    </div><section class="beliefs">
      <span class="micro">HOW I THINK</span><h2>我怎麼看事情</h2><div>
        {
          beliefs.map(([title, text], i) => (
            <article>
              <>
                <span class="micro">0{i + 1}</span>
                <h3>{title}</h3>
                <p>{text}</p>
              </>
            </article>
          ))
        }
      </div>
    </section><section class="off-keyboard">
      <span class="micro">OFF THE KEYBOARD</span><div>
        <h2>aespa、Winter，<br />還有一首 Drama。</h2><p>
          Dirty Work 時期入坑的 MY。寫程式累了，會去看舞台、滑一下
          Threads，留一點跟技術無關的時間。這也是我的一部分。
        </p><a class="text-link" href="https://www.instagram.com/imw1nt0r/"
          >Instagram / @imw1nt0r ↗</a>
      </div>
    </section><a class="next-page" href="/projects"
      ><span>文字之外，看實際作品。</span><b>↗</b></a>
  </div>
</PortfolioLayout>
