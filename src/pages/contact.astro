---
import PortfolioLayout from "../layouts/PortfolioLayout.astro";
const contacts = [
  [
    "Discord",
    "kjyang",
    "聊技術、side project，或交流開發想法。",
    "https://discord.gg/sZbn6Dw3Bx",
  ],
  [
    "GitHub",
    "KJyang-0114",
    "讀原始碼、回報問題，或參與開源專案。",
    "https://github.com/KJyang-0114",
  ],
  [
    "Instagram",
    "@imw1nt0r",
    "日常、追星，以及偶爾的技術碎碎念。",
    "https://www.instagram.com/imw1nt0r/",
  ],
];
---

<PortfolioLayout
  title="聯絡 — KJyang"
  description="聊技術、AI / LLM、Web 或開源合作，透過 Discord、GitHub、Instagram 找到 KJyang。網站設計需求請從 Studio 開始。"
  ><div class="contact-page">
    <header class="page-heading">
      <span class="micro">LET’S TALK</span><h1>有想法，<br />就來聊。</h1><p>
        AI / LLM 應用、全端 Web、開源貢獻，或一個有趣的 side project。<br
        />選你習慣的平台，告訴我正在想什麼。
      </p>
    </header><div class="contact-links">
      {
        contacts.map(([name, handle, text, href], i) => (
          <a href={href} target="_blank" rel="noopener noreferrer">
            <>
              <span class="micro">
                0{i + 1} / {name}
              </span>
              <h2>{handle}</h2>
              <p>{text}</p>
              <span aria-hidden="true">↗</span>
            </>
          </a>
        ))
      }
    </div><section class="contact-business">
      <span class="micro">WEBSITE / BUSINESS INQUIRY</span><div>
        <h2>想為店家或工作室做網站？</h2><p>
          Studio 整理了設計服務、價格範圍、交付流程與 LINE
          聯絡方式，讓我們從需求開始。
        </p><a class="button-primary" href="/studio/contact">網站需求諮詢 ↗</a
        ><a class="text-link" href="/studio/pricing">先看價格</a>
      </div>
    </section>
  </div></PortfolioLayout
>
