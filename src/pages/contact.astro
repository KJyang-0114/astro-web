---
import Layout from '../layouts/Layout.astro';

const contacts = [
  {
    name: "GitHub",
    desc: "所有專案都在這",
    handle: "KJyang-0114",
    href: "https://github.com/KJyang-0114",
    icon: `<path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />`,
    hover: "hover:border-zinc-500",
  },
  {
    name: "Instagram",
    desc: "日常 + 追星 + 偶爾的技術碎碎念",
    handle: "@imw1nt0r",
    href: "https://www.instagram.com/imw1nt0r/",
    icon: `<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />`,
    hover: "hover:border-pink-500/30",
  },
  {
    name: "Discord",
    desc: "最快找到我的方式",
    handle: "kjyang",
    href: "https://discord.gg/sZbn6Dw3Bx",
    icon: `<path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286z" />`,
    hover: "hover:border-indigo-500/30",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "聯絡 KJyang",
  "url": "https://kjyang0114.dev/contact",
  "mainEntity": {
    "@type": "Person",
    "name": "楊凱捷",
    "alternateName": "KJyang",
    "sameAs": [
      "https://github.com/KJyang-0114",
      "https://www.instagram.com/imw1nt0r/",
      "https://discord.gg/sZbn6Dw3Bx"
    ]
  }
};
---

<Layout
  title="聯絡我 — KJyang | GitHub · Instagram · Discord"
  description="想找 KJyang 聊技術、合作專案？透過 GitHub、Instagram (@imw1nt0r) 或 Discord 都可以。"
  jsonLd={jsonLd}
>

  <section class="pt-32 pb-16">
    <div class="section-container">
      <h1 class="animate-on-scroll text-4xl sm:text-5xl font-black mb-6">
        找我
      </h1>
      <p class="animate-on-scroll delay-1 text-lg text-zinc-400 max-w-2xl leading-relaxed">
        想聊合作、聊技術都行。挑一個你習慣的平台丟訊息就好。
      </p>
    </div>
  </section>

  <section class="pb-20" aria-label="聯絡方式">
    <div class="section-container">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {contacts.map((c, i) => (
          <a
            href={c.href}
            target="_blank"
            rel="noopener noreferrer"
            class={`animate-on-scroll delay-${i + 1} group p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800/50 ${c.hover} transition-all duration-300 block`}
            aria-label={`透過 ${c.name} 聯絡`}
          >
            <div class="flex items-center gap-3 mb-4">
              <svg class="w-6 h-6 text-zinc-400 group-hover:text-zinc-100 transition-colors" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <Fragment set:html={c.icon} />
              </svg>
              <h2 class="text-lg font-semibold text-zinc-200">{c.name}</h2>
            </div>
            <p class="text-sm text-zinc-400 mb-3">{c.desc}</p>
            <p class="text-sm font-mono text-brand-light">{c.handle}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="pb-20" aria-label="合作意願">
    <div class="section-container">
      <div class="animate-on-scroll p-8 sm:p-12 rounded-3xl bg-zinc-900/30 border border-zinc-800/50">
        <div class="flex items-start gap-4 mb-6">
          <div class="w-3 h-3 mt-1.5 rounded-full bg-green-500 animate-pulse flex-shrink-0" aria-hidden="true"></div>
          <div>
            <h2 class="text-xl font-bold text-zinc-100 mb-2">可以合作</h2>
            <p class="text-zinc-400 leading-relaxed">
              如果你有以下類型的東西想一起做，可以聊聊：
            </p>
          </div>
        </div>
        
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 ml-7" role="list">
          <li class="flex items-center gap-2 text-zinc-300 text-sm">
            <svg class="w-4 h-4 text-brand flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            AI / LLM 相關應用
          </li>
          <li class="flex items-center gap-2 text-zinc-300 text-sm">
            <svg class="w-4 h-4 text-brand flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            全端 Web 開發
          </li>
          <li class="flex items-center gap-2 text-zinc-300 text-sm">
            <svg class="w-4 h-4 text-brand flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            開源專案貢獻
          </li>
          <li class="flex items-center gap-2 text-zinc-300 text-sm">
            <svg class="w-4 h-4 text-brand flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            有趣的 side project
          </li>
        </ul>
      </div>
    </div>
  </section>

</Layout>
