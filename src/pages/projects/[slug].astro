---
import PortfolioLayout from "../../layouts/PortfolioLayout.astro";
import { projects } from "../../data/projects";
import { projectFlows } from "../../data/project-flows";
import ProjectFlow from "../../components/portfolio/ProjectFlow.astro";
export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}
const { project } = Astro.props;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: project.title,
  description: project.description,
  codeRepository: project.github,
  programmingLanguage: project.tech,
  author: { "@type": "Person", name: "楊凱捷" },
};
---

<PortfolioLayout
  title={`${project.title} — KJyang 作品`}
  description={project.lead}
  jsonLd={jsonLd}
  ><article class="project-page">
    <a class="text-link" href={`/projects#${project.slug}`}>← 所有作品</a
    ><header class="project-header">
      <span class="micro">{project.category} / {project.status}</span><h1>
        {project.title}
      </h1><p>{project.lead}</p><div class="project-tags">
        {project.tags.map((tag) => <span>{tag}</span>)}
      </div><div class="hero-actions">
        <a
          class="button-primary"
          href={project.github}
          target="_blank"
          rel="noopener noreferrer">GitHub / 原始碼 ↗</a
        >{
          project.demo && (
            <a class="text-link" href={project.demo}>
              開啟網站 ↗
            </a>
          )
        }
      </div>
    </header><div class="project-story">
      <section>
        <h2>從什麼問題開始</h2><p>{project.description}</p><h2>
          做了哪些事
        </h2><ul>{project.build.map((text) => <li>{text}</li>)}</ul><h2>
          資料怎麼走
        </h2>{projectFlows[project.slug] ? <ProjectFlow nodes={projectFlows[project.slug]} slug={project.slug} /> : <ol class="flow-list">
          {project.flow.map((step) => <li>{step}</li>)}
        </ol>}
      </section><aside>
        <span class="micro">CURRENT STATE</span><h2>{project.status}</h2><p>
          閱讀作品時，也一起看目前的範圍。
        </p><ul>{project.limits.map((text) => <li>{text}</li>)}</ul>{
          project.slug === "nyx" && (
            <a
              class="text-link"
              href="https://github.com/Passer1072/RookieAI_yolov8"
            >
              上游來源 / RookieAI_yolov8 ↗
            </a>
          )
        }
      </aside>
    </div>{
      project.image && (
        <figure class="project-diagram">
          <>
            <img
              src={`/projects/${project.image}`}
              alt={`${project.title} 架構與流程圖`}
              loading="lazy"
            />
            <figcaption>
              專案 README 架構圖 · <a href={project.github}>查看原始說明 ↗</a>
            </figcaption>
          </>
        </figure>
      )
    }<a class="next-page" href="/contact"
      ><span>有相關想法，來聊聊。</span><b>↗</b></a>
  </article></PortfolioLayout
>
