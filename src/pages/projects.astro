---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

// 精心篩選的專業作品集 - 只保留最具代表性和完整度的專案
const projects = [
  {
    id: 1,
    name: 'AI 自動化內容創作系統',
    description: '整合 Grok API 的全自動化創作流程，能每日自動生成情感短文，轉換為精美圖片並一鍵發布至 Instagram。展現了 AI 應用、API 整合與自動化流程的完整技術能力。',
    tags: ['AI 應用', 'API 整合', '自動化', 'FastAPI'],
    github: null,
    demo: null
  },
  {
    id: 2,
    name: 'AI 程式學習輔助平台',
    description: '創新的教育科技專案，運用大型語言模型自動生成帶錯誤的程式碼供學生練習，並提供智能批改與反饋。前後端分離架構，支援教師管理與學生學習的完整流程。',
    tags: ['AI 教育', '全端開發', '教育科技', 'LLM'],
    github: null,
    demo: null
  },
  {
    id: 3,
    name: '深度強化學習訓練平台',
    description: '專業的 DQN 強化學習訓練環境，提供視覺化訓練過程、即時動畫回放、模型效能比較等功能。讓複雜的 AI 訓練過程變得直觀易懂。',
    tags: ['深度學習', '強化學習', '數據視覺化', 'AI 訓練'],
    github: null,
    demo: null
  },
  {
    id: 4,
    name: 'OnlineClipboard 協作平台',
    description: '支援多人即時同步的線上剪貼簿工具。採用現代化技術棧 (Vite + TypeScript + PWA)，讓跨裝置內容分享變得無縫便利。',
    tags: ['協作工具', 'TypeScript', 'PWA', '即時同步'],
    github: 'https://github.com/kjyang-0114/online-clipboard',
    demo: 'https://kjyang-0114.github.io/online-clipboard/'
  },
  {
    id: 5,
    name: 'BridgeMaster - Minecraft 優化模組',
    description: '為 Minecraft 開發的 Forge 模組，透過演算法優化遊戲內建橋操作，大幅提升建築效率。在開源社群獲得良好迴響，展現遊戲開發與演算法應用能力。',
    tags: ['遊戲開發', 'Java', '演算法優化', '開源專案'],
    github: 'https://github.com/KJyang-0114/BridgeMaster',
    demo: null
  },
  {
    id: 6,
    name: '個人網站 (本站)',
    description: '使用 Astro 框架打造的現代化個人網站，實現極致的載入速度、流暢的頁面轉換動畫，以及優秀的 SEO 表現。展現前端開發與 UI/UX 設計能力。',
    tags: ['Astro', '前端開發', 'UI/UX', '效能優化'],
    github: 'https://github.com/kjyang-0114/KJyang-website-astro',
    demo: '/'
  }
];
---

<Layout title="作品集 - KJyang" description="探索 KJyang 的精選專案作品集 - AI 應用、全端開發、遊戲開發等創新專案。">
  <div class="container">
    <header class="page-header">
      <h1 class="page-title">我的作品集</h1>
      <p class="page-subtitle">精選專案，展現從 AI 應用到全端開發的技術廣度與深度</p>
    </header>

    <div class="projects-grid">
      {projects.map(project => (
        <ProjectCard
          name={project.name}
          description={project.description}
          tags={project.tags}
          github={project.github}
          demo={project.demo}
        />
      ))}
    </div>
  </div>
</Layout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 5rem;
  }

  .page-title {
    font-size: 3.5rem;
    font-weight: 800;
    margin-bottom: 1.5rem;
    background: var(--primary-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 1.2;
  }

  .page-subtitle {
    font-size: 1.3rem;
    color: var(--text-muted);
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
    gap: 3rem;
    margin-top: 2rem;
  }

  @media (max-width: 768px) {
    .container {
      padding: 3rem 1rem;
    }

    .page-header {
      margin-bottom: 3rem;
    }

    .page-title {
      font-size: 2.8rem;
    }

    .page-subtitle {
      font-size: 1.1rem;
    }

    .projects-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 480px) {
    .page-title {
      font-size: 2.3rem;
    }
    
    .projects-grid {
      gap: 1.5rem;
    }
  }
</style>
