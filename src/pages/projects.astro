---
import PortfolioLayout from "../layouts/PortfolioLayout.astro";
import WireArt from "../components/portfolio/WireArt.astro";
import { projects } from "../data/projects";
const groups = [
  { key: "type", label: "領域", values: ["AI", "Web", "工具"] },
  {
    key: "tech",
    label: "語言",
    values: ["Python", "Go", "TypeScript", "JavaScript"],
  },
];
---

<PortfolioLayout
  title="作品集 — KJyang | Build · Verify · Deliver"
  description="從同學使用的 Discord 解題 Bot，到 Sift、2048 RL 與跨裝置工具。閱讀 KJyang 的作品、實作方式、目前狀態與 GitHub 原始碼。"
>
  <div class="work-page">
    <div class="page-heading">
      <span class="micro">PROJECTS / BUILD · VERIFY · DELIVER</span><h1>
        Selected<span>({String(projects.length).padStart(2, "0")})</span>
      </h1><p>
        每一個作品，都從一個問題開始。打開看看做了什麼、怎麼運作，以及還在探索的部分。
      </p>
    </div><div class="work-layout">
      <aside>
        <div class="filter-head">
          <span>篩選作品</span><button id="clear" type="button"
            >清除篩選 ↺</button>
        </div><div class="filters">
          {
            groups.map((group) => (
              <fieldset>
                <legend>{group.label}</legend>
                {group.values.map((value) => (
                  <label>
                    <input
                      type="checkbox"
                      data-filter={group.key}
                      value={value}
                    />
                    {value}
                  </label>
                ))}
              </fieldset>
            ))
          }
        </div><WireArt label="EXPERIMENTS IN ORDER" />
      </aside><section aria-label="作品索引">
        <div class="table-head">
          <span>/ NO.</span><span>/ PROJECT</span><span>/ FIELD</span>
        </div>{
          projects.map((project, index) => (
            <details
              class="work-row"
              id={project.slug}
              data-type={project.category}
              data-tech={project.tech}
            >
              <>
                <summary>
                  <>
                    <span class="row-num">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <h2>{project.title}</h2>
                    <span class="tag">{project.category}</span>
                    <span class="plus" aria-hidden="true">
                      ＋
                    </span>
                  </>
                </summary>
                <div class="work-detail">
                  <div>
                    <>
                      <span class="micro">{project.status}</span>
                      <p>{project.lead}</p>
                      <p>{project.description}</p>
                      <div class="flow">{project.flow.join(" → ")}</div>
                      <a class="text-link" href={`/projects/${project.slug}`}>
                        閱讀完整作品 ↗
                      </a>
                    </>
                  </div>
                  {project.image ? (
                    <img
                      src={`/projects/${project.image}`}
                      alt={`${project.title} 專案架構`}
                      loading="lazy"
                      width="1200"
                      height="760"
                    />
                  ) : (
                    <div class="type-art">
                      <span>{String(index + 1).padStart(2, "0")}</span>
                      <p>
                        {project.tech}
                        <br />
                        {project.category}
                      </p>
                    </div>
                  )}
                </div>
              </>
            </details>
          ))
        }<p class="empty" hidden>沒有符合條件的作品，試著調整領域或語言。</p><p
          class="result-count"
          role="status"
        >
          顯示 {projects.length} / {projects.length} 件作品
        </p>
      </section>
    </div>
  </div>
  <script>
    const inputs = [
      ...document.querySelectorAll<HTMLInputElement>("[data-filter]"),
    ];
    const rows = [...document.querySelectorAll<HTMLElement>(".work-row")];
    const update = () => {
      const selected = (key: string) =>
        inputs
          .filter((i) => i.checked && i.dataset.filter === key)
          .map((i) => i.value);
      const types = selected("type"),
        techs = selected("tech");
      let count = 0;
      rows.forEach((row) => {
        row.hidden = !!(
          (types.length && !types.includes(row.dataset.type!)) ||
          (techs.length && !techs.includes(row.dataset.tech!))
        );
        if (!row.hidden) count++;
      });
      document.querySelector(".result-count")!.textContent =
        `顯示 ${count} / ${rows.length} 件作品`;
      document.querySelector<HTMLElement>(".empty")!.hidden = count !== 0;
    };
    inputs.forEach((input) => input.addEventListener("change", update));
    document.querySelector("#clear")?.addEventListener("click", () => {
      inputs.forEach((i) => (i.checked = false));
      update();
    });
    const openHash = () => {
      const el = document.getElementById(location.hash.slice(1));
      if (el instanceof HTMLDetailsElement) {
        el.open = true;
        el.scrollIntoView({ block: "start" });
      }
    };
    openHash();
    window.addEventListener("hashchange", openHash);
  </script>
</PortfolioLayout>
