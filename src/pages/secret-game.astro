---
import Layout from '../layouts/Layout.astro';
---

<Layout title="秘密游戲 - 圈圈叉叉挑戰">
  <div class="game-container">
    <h1 class="game-title">無敵圈圈叉叉</h1>
    <p class="game-subtitle">你贏不了的圈圈叉叉</p>
    
    <div class="difficulty-badge">地獄難度</div>
    
    <div class="scoreboard">
      <div class="score player-score">
        <span>弱者（你）</span>
        <span id="player-score">0</span>
      </div>
      <div class="score ai-score">
        <span>AI大魔王</span>
        <span id="ai-score">0</span>
      </div>
    </div>
    
    <div class="game-board" id="game-board">
      <div class="cell" data-index="0"></div>
      <div class="cell" data-index="1"></div>
      <div class="cell" data-index="2"></div>
      <div class="cell" data-index="3"></div>
      <div class="cell" data-index="4"></div>
      <div class="cell" data-index="5"></div>
      <div class="cell" data-index="6"></div>
      <div class="cell" data-index="7"></div>
      <div class="cell" data-index="8"></div>
    </div>
    
    <div class="message" id="message">看你敢不敢開始，求虐嗎？</div>
    
    <button class="reset-button" id="reset-button">再給我一次機會</button>
    
    <div class="taunt-container" id="taunt-container">
      <p class="taunt-message"></p>
    </div>
    
    <a href="/" class="back-link">← 認輸了？逃回首頁吧</a>
    <a href="/gomoku-game" class="game-link">挑戰無敵五子棋 →</a>
  </div>
</Layout>

<style>
  .game-container {
    max-width: 600px;
    margin: 2rem auto;
    padding: 2rem;
    background: rgba(30, 30, 30, 0.8);
    border-radius: var(--border-radius);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    text-align: center;
  }
  
  .game-title {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .game-subtitle {
    color: var(--text-muted);
    margin-bottom: 2rem;
  }
  
  .scoreboard {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }
  
  .score {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.5rem 1.5rem;
    border-radius: var(--border-radius);
  }
  
  .player-score {
    background: rgba(59, 130, 246, 0.2);
    border: 1px solid var(--primary-color);
  }
  
  .ai-score {
    background: rgba(236, 72, 153, 0.2);
    border: 1px solid var(--secondary-color);
  }
  
  #player-score, #ai-score {
    font-size: 1.5rem;
    font-weight: bold;
  }
  
  .game-board {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 1fr);
    gap: 8px;
    margin: 2rem auto;
    width: 300px;
    height: 300px;
    position: relative;
    z-index: 1;
  }
  
  .cell {
    background: rgba(60, 60, 60, 0.6);
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    transition: all 0.2s ease;
    user-select: none;
    -webkit-user-select: none;
    position: relative;
    z-index: 2;
  }
  
  .cell:hover {
    background: rgba(80, 80, 80, 0.8);
    transform: scale(1.02);
    box-shadow: 0 0 10px rgba(100, 100, 100, 0.5);
  }
  
  .cell:active {
    transform: scale(0.98);
  }
  
  .cell.x::before {
    content: "X";
    color: var(--primary-color);
  }
  
  .cell.o::before {
    content: "O";
    color: var(--secondary-color);
  }
  
  .message {
    font-size: 1.2rem;
    height: 3rem;
    margin: 1rem 0;
    color: var(--text-color);
  }
  
  .reset-button {
    padding: 0.8rem 1.5rem;
    background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
    border: none;
    border-radius: var(--border-radius);
    color: white;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .reset-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
  }
  
  .taunt-container {
    margin-top: 2rem;
    min-height: 4rem;
    display: flex;
    justify-content: center;
    align-items: center;
    background: transparent;
  }
  
  .taunt-message {
    padding: 1rem;
    background: rgba(255, 0, 0, 0.1);
    border-left: 4px solid var(--secondary-color);
    border-radius: 4px;
    font-style: italic;
    text-align: left;
    max-width: 80%;
    transition: all 0.3s ease;
    opacity: 0;
    transform: translateY(10px);
  }
  
  .taunt-message.show {
    opacity: 1;
    transform: translateY(0);
  }
  
  .taunt-link {
    color: var(--secondary-color);
    text-decoration: underline;
    font-weight: bold;
    transition: color 0.2s ease;
  }
  
  .taunt-link:hover {
    color: var(--primary-color);
    text-decoration: underline;
  }
  
  .back-link {
    display: inline-block;
    margin-top: 2rem;
    color: var(--text-muted);
    transition: color 0.2s ease;
    text-decoration: none;
  }
  
  .back-link:hover {
    color: var(--primary-color);
  }
  
  .game-link {
    display: inline-block;
    margin-top: 2rem;
    margin-left: 1rem;
    color: var(--text-muted);
    transition: color 0.2s ease;
    text-decoration: none;
  }
  
  .game-link:hover {
    color: var(--secondary-color);
  }
  
  @keyframes celebrate {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }
  
  .cell.winning-cell {
    animation: celebrate 0.5s ease infinite;
    background: rgba(16, 185, 129, 0.2);
    border: 2px solid var(--accent-color);
  }
  
  .difficulty-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: linear-gradient(135deg, #ff4d4d, #cc0000);
    color: white;
    font-weight: bold;
    padding: 0.5rem 1rem;
    border-radius: var(--border-radius);
    box-shadow: 0 4px 10px rgba(204, 0, 0, 0.3);
    transform: rotate(10deg);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  
  @media (max-width: 600px) {
    .game-container {
      padding: 1rem;
      margin: 1rem;
    }
    
    .game-title {
      font-size: 1.8rem;
    }
    
    .game-board {
      width: 280px;
      height: 280px;
    }
    
    .cell {
      font-size: 2.5rem;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    console.log('游戲初始化開始...');
    
    // 獲取DOM元素
    const board = document.getElementById('game-board');
    const cells = document.querySelectorAll('.cell');
    const message = document.getElementById('message');
    const resetButton = document.getElementById('reset-button');
    const playerScoreElement = document.getElementById('player-score');
    const aiScoreElement = document.getElementById('ai-score');
    const tauntContainer = document.getElementById('taunt-container');
    const tauntMessage = document.querySelector('.taunt-message');
    
    console.log('找到元素:', { 
      board: !!board, 
      cells: cells.length, 
      message: !!message, 
      resetButton: !!resetButton,
      tauntContainer: !!tauntContainer
    });
    
    // 游戲狀態
    let currentBoard = Array(9).fill('');
    let currentPlayer = 'x';
    let gameActive = true;
    let playerScore = 0;
    let aiScore = 0;
    
    // 處理單元格點擊
    function handleCellClick(e) {
      const index = parseInt(this.getAttribute('data-index'));
      console.log(`點擊了單元格 ${index}`);
      
      if (currentBoard[index] !== '' || !gameActive || currentPlayer !== 'x') {
        console.log('無效點擊:', { 
          cellFilled: currentBoard[index] !== '', 
          gameActive, 
          currentPlayer 
        });
        
        // 無效點擊也嘲諷
        if (currentBoard[index] !== '' && message) {
          message.textContent = "這裡已經有棋子了，眼睛是用來看的，不是裝飾。";
        }
        
        return;
      }
      
      // 玩家落子
      makeMove(index, 'x');
      
      // 檢查游戲狀態
      if (checkGameState()) return;
      
      // AI回合
      setTimeout(() => {
        if (gameActive) {
          currentPlayer = 'o';
          if (message) {
            message.textContent = "AI正在思考...";
          }
          
          setTimeout(() => {
            const aiMove = getBestMove();
            console.log(`AI選擇了單元格: ${aiMove}`);
            makeMove(aiMove, 'o');
            checkGameState();
          }, 600);
        }
      }, 300);
    }
    
    // 落子
    function makeMove(index, player) {
      console.log(`在索引 ${index} 落子 ${player}`);
      currentBoard[index] = player;
      cells[index].classList.add(player);
      currentPlayer = player === 'x' ? 'o' : 'x';
    }
    
    // 檢查游戲狀態
    function checkGameState() {
      // 獲勝組合
      const winPatterns = [
        [0, 1, 2], [3, 4, 5], [6, 7, 8], // 行
        [0, 3, 6], [1, 4, 7], [2, 5, 8], // 列
        [0, 4, 8], [2, 4, 6]             // 對角線
      ];
      
      // 檢查獲勝
      for (const pattern of winPatterns) {
        const [a, b, c] = pattern;
        if (currentBoard[a] && currentBoard[a] === currentBoard[b] && currentBoard[a] === currentBoard[c]) {
          gameActive = false;
          highlightWinningCells(pattern);
          
          console.log(`獲勝者: ${currentBoard[a]}`);
          
          if (currentBoard[a] === 'x') {
            if (message) {
              message.textContent = "居然讓你贏了！絕對是我讓你的...";
            }
            playerScore++;
            if (playerScoreElement) {
              playerScoreElement.textContent = playerScore.toString();
            }
          } else if (currentBoard[a] === 'o') {
            if (message) {
              message.textContent = "哈哈！不出所料，AI贏了！還不認輸？";
            }
            aiScore++;
            if (aiScoreElement) {
              aiScoreElement.textContent = aiScore.toString();
            }
            showTaunt();
          }
          
          return true;
        }
      }
      
      // 檢查平局
      if (!currentBoard.includes('')) {
        gameActive = false;
        if (message) {
          message.textContent = "呵呵 平局? 其實這對你來說已經算是成功了...";
        }
        // 平局也顯示嘲諷
        showTaunt();
        return true;
      }
      
      // 更新訊息
      if (message) {
        message.textContent = currentPlayer === 'x' ? "輪到你了，反正你也不知道下哪..." : "AI正在計算如何擊敗你...";
      }
      return false;
    }
    
    // 高亮獲勝組合
    function highlightWinningCells(pattern) {
      pattern.forEach(index => {
        cells[index].classList.add('winning-cell');
      });
    }
    
    // 智能AI - Minimax算法
    function getBestMove() {
      // 移除3%隨機移動的可能性，保證AI每次都做出最佳選擇
      // 使用Minimax算法
      let bestScore = -Infinity;
      let bestMove = 0;
      
      for (let i = 0; i < 9; i++) {
        if (currentBoard[i] === '') {
          currentBoard[i] = 'o';
          let score = minimax(currentBoard, 0, false);
          currentBoard[i] = '';
          
          if (score > bestScore) {
            bestScore = score;
            bestMove = i;
          }
        }
      }
      
      console.log(`AI選擇了最佳位置: ${bestMove}，評分: ${bestScore}`);
      return bestMove;
    }
    
    // Minimax算法
    function minimax(board, depth, isMaximizing) {
      // 檢查游戲是否結束
      const winner = checkWinner(board);
      if (winner === 'o') return 100 - depth; // 增加AI獲勝的獎勵
      if (winner === 'x') return depth - 100; // 增加AI防止玩家獲勝的懲罰
      if (!board.includes('')) return 0;
      
      if (isMaximizing) {
        let bestScore = -Infinity;
        for (let i = 0; i < 9; i++) {
          if (board[i] === '') {
            board[i] = 'o';
            let score = minimax(board, depth + 1, false);
            board[i] = '';
            bestScore = Math.max(score, bestScore);
          }
        }
        return bestScore;
      } else {
        let bestScore = Infinity;
        for (let i = 0; i < 9; i++) {
          if (board[i] === '') {
            board[i] = 'x';
            let score = minimax(board, depth + 1, true);
            board[i] = '';
            bestScore = Math.min(score, bestScore);
          }
        }
        return bestScore;
      }
    }
    
    // 檢查獲勝者
    function checkWinner(board) {
      const winPatterns = [
        [0, 1, 2], [3, 4, 5], [6, 7, 8],
        [0, 3, 6], [1, 4, 7], [2, 5, 8],
        [0, 4, 8], [2, 4, 6]
      ];
      
      for (const pattern of winPatterns) {
        const [a, b, c] = pattern;
        if (board[a] && board[a] === board[b] && board[a] === board[c]) {
          return board[a];
        }
      }
      
      return null;
    }
    
    // 顯示嘲諷訊息
    function showTaunt() {
      const taunts = [
        "菜就多練，不好意思，這是事實。",
        "打不過我就別打了，自討苦吃而已。",
        "嘖嘖，這麼簡單的遊戲都贏不了嗎？",
        "你的技術簡直像我奶奶...但我奶奶玩得比你好。",
        "連小學生都能贏的遊戲，你怎麼就這麼特別？",
        "這麼爛還不投降，挺有毅力的嘛！",
        "輸了就輸了，別找藉口，菜是原罪。",
        "在我眼裡，你的落子就像隨機點擊一樣。",
        "你知道嗎？我用10%的實力就贏你了。",
        "要不要看教學影片？網路上一堆給小朋友看的。",
        "玩這麼久還是這麼菜，建議你換個遊戲試試。",
        "這不適合你，要不要玩剪刀石頭布試試？",
        "我都不好意思一直贏你...其實是挺好意思的。",
        "AI：1分，人類：0分，就像預期的那樣。",
        "我原以為會有挑戰，結果只是一場簡單的練習。",
        "AI玩家表示：不愧是人類，就是這麼簡單被擊敗。",
        "放棄吧！你永遠贏不了我的。",
        "圈圈叉叉都贏不了嗎？<a href='/gomoku-game' class='taunt-link'>那就試試五子棋</a>，挑戰更大的失敗！"
      ];
      
      const randomTaunt = taunts[Math.floor(Math.random() * taunts.length)];
      if (tauntMessage) {
        tauntMessage.textContent = '';
        tauntMessage.innerHTML = randomTaunt;
        tauntMessage.classList.add('show');
      }
    }
    
    // 初始化遊戲
    function initGame() {
      console.log('初始化遊戲');
      currentBoard = Array(9).fill('');
      currentPlayer = 'x';
      gameActive = true;
      
      // 移除所有棋子並重新添加點擊事件
      cells.forEach(cell => {
        cell.classList.remove('x', 'o', 'winning-cell');
        cell.removeEventListener('click', handleCellClick);
        cell.addEventListener('click', handleCellClick);
      });
      
      const startTaunts = [
        "看你敢不敢開始，求虐嗎？",
        "準備被虐了嗎？我連眼睛都不用睜開就能贏你。",
        "來吧，挑戰一下你不可能的勝利。",
        "只有勇敢的人才敢點下一步，但敢不敢不代表能贏。",
        "再輸一次？你真的不嫌丟臉嗎？"
      ];
      
      if (message) {
        const randomStartTaunt = startTaunts[Math.floor(Math.random() * startTaunts.length)];
        message.textContent = randomStartTaunt;
      }
      
      if (tauntMessage) {
        tauntMessage.textContent = '';
        tauntMessage.classList.remove('show');
      }
    }
    
    // 重置按鈕事件
    if (resetButton) {
      resetButton.addEventListener('click', initGame);
    }
    
    // 初始化遊戲
    initGame();
    console.log('遊戲初始化完成');
  });
</script> 