---
import PortfolioLayout from "../layouts/PortfolioLayout.astro";
import WireArt from "../components/portfolio/WireArt.astro";
import ExhibitScenes from "../components/portfolio/ExhibitScenes.astro";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "楊凱捷",
  alternateName: "KJyang",
  url: "https://kjyang0114.dev",
  sameAs: [
    "https://github.com/KJyang-0114",
    "https://www.instagram.com/imw1nt0r/",
  ],
};
---

<PortfolioLayout
  title="KJyang — Builds with Logic & Magic."
  description="我是 KJyang，鶯歌工商資訊科高三。用 AI、Web 與自動化做出能實際使用的系統；分享作品、驗證過程與網站設計服務。"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="hero-title">
      <span class="micro">AI × WEB × AUTOMATION / TAIWAN</span><h1>
        Human,<br />then <span>Code.</span>
      </h1><p class="identity">楊凱捷 <i>/</i> KJyang</p><p class="hero-role">Software Engineer</p><p class="hero-school">
        鶯歌工商資訊科高三 · 新北市
      </p>
    </div><div class="hero-note">
      <span class="micro">AI · WEB · AUTOMATION</span><h2>
        讓想法，<br />有真實的去處。
      </h2><p>
        AI 讓我開始做；錯誤讓我學會驗證；<br />真實交付讓我理解資訊管理。
      </p><div class="hero-actions">
        <a class="button-primary" href="/studio">網站服務 / Studio ↗</a><a
          class="text-link"
          href="/projects">看我做了什麼 ↗</a>
      </div>
    </div><div class="hero-art"><WireArt /></div><div class="hero-bottom">
      <span>把 AI、Web 與自動化，做成能實際操作的系統。</span><a href="/studio"
        >網站設計與開發 / Studio ↗</a
      ><span>01 — INTRODUCTION</span>
    </div>
  </section><section class="exhibit">
    <div class="exhibit-intro">
      <span class="micro">SELECTED SYSTEMS</span><h2>
        小系統。<br />真實的使用。
      </h2><p>
        從同學的一張題目圖片開始，<br />做出能解題、也能接續追問的工具。
      </p><a href="/projects#discord" class="text-link"
        >Discord 解題 Bot <span>↗</span></a>
    </div><div class="specimen"><ExhibitScenes /></div><div
      class="exhibit-select"
    >
      <span class="micro">SELECT A SYSTEM</span><button
        data-scene="bot"
        aria-pressed="true">01 <b>Discord Bot</b> ↗</button
      ><button data-scene="sift" aria-pressed="false">02 <b>Sift</b> ↗</button
      ><button data-scene="rl" aria-pressed="false">03 <b>2048 RL</b> ↗</button
      ><p class="proof-title" aria-live="polite">
        題目圖片 → 可追問的解答
      </p><small>互動示意 · 專案細節與原始碼見作品頁</small>
    </div>
  </section><a class="next-page" href="/projects"
    ><span>探索所有作品 <small>08 / SELECTED WORK</small></span><b>↗</b></a
  ><section class="home-method">
    <span class="micro">BUILD · VERIFY · DELIVER</span><h2>
      讓工具加速。<br />讓驗證把關。
    </h2><p>
      AI /
      LLM、前端、後端與部署，是我把想法做出來的工具。讀錯誤、核對資料、修改重測，才讓作品更接近真實需求。
    </p><a class="text-link" href="/about">我的開發方式 ↗</a><a
      class="text-link"
      href="/ai">AI 入門筆記 ↗</a>
  </section></PortfolioLayout
>
