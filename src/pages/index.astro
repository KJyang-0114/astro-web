---
import Layout from '../layouts/Layout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "dateModified": "2026-02-18",
  "mainEntity": {
    "@type": "Person",
    "name": "楊凱捷",
    "alternateName": ["KJyang", "kjyang", "imw1nt0r"],
    "url": "https://kjyang0114.dev",
    "jobTitle": "全端開發者",
    "description": "鶯歌工商資訊科，擅長用 AI 和新技術做有趣的東西",
    "knowsAbout": ["LLM", "AI", "Web Development", "Python", "React", "TypeScript", "Java", "強化學習"],
    "sameAs": [
      "https://github.com/KJyang-0114",
      "https://www.instagram.com/imw1nt0r/",
      "https://discord.gg/sZbn6Dw3Bx"
    ],
    "affiliation": {
      "@type": "EducationalOrganization",
      "name": "新北市立鶯歌工商",
      "alternateName": ["鶯歌工商", "YKVS"],
      "department": { "@type": "EducationalOrganization", "name": "資訊科" }
    }
  }
};

const techStack = [
  { name: "AI / LLM", items: ["Prompt Engineering", "Grok API", "LLM 整合應用", "強化學習", "AI Agent"], icon: "🧠" },
  { name: "前端", items: ["React", "Vue", "Astro", "TypeScript", "Tailwind CSS"], icon: "🖥️" },
  { name: "後端 & 工具", items: ["Python", "FastAPI", "Node.js", "Docker", "Git"], icon: "⚙️" },
  { name: "其他", items: ["Java", "Minecraft Forge", "Swift", "Linux"], icon: "🎮" },
];
---

<Layout
  title="KJyang — 鶯歌工商資訊科 | 全端開發 · AI 應用"
  description="KJyang，鶯歌工商資訊科。專注 AI / LLM 應用開發、全端 Web 架構。GitHub 13+ 開源專案。"
  jsonLd={jsonLd}
>

  <!-- Hero -->
  <section class="relative min-h-[90vh] flex items-center pt-20" aria-label="KJyang 首頁">
    <div class="section-container w-full">
      <div class="max-w-3xl">
        <div class="animate-on-scroll inline-flex items-center gap-2 px-4 py-2 rounded-full bg-brand/10 border border-brand/20 text-brand text-sm font-medium mb-8">
          <span class="w-2 h-2 rounded-full bg-brand animate-pulse"></span>
          鶯歌工商 · 資訊科
        </div>

        <h1 class="animate-on-scroll delay-1 text-4xl sm:text-5xl lg:text-6xl font-black leading-tight mb-6">
          Hey, 我是 <span class="text-gradient">KJyang</span>
        </h1>

        <p class="animate-on-scroll delay-2 text-xl sm:text-2xl text-zinc-300 mb-4 font-medium">
          寫全端、玩 AI、做有趣的東西。
        </p>

        <p class="animate-on-scroll delay-2 text-base sm:text-lg text-zinc-400 max-w-2xl mb-10 leading-relaxed">
          平常在研究怎麼用 LLM 和各種新技術搞事情，
          偶爾寫寫全端，偶爾改改 Minecraft mod。
          GitHub 上有 13+ 個開源專案，歡迎逛逛。
        </p>

        <div class="animate-on-scroll delay-3 flex flex-wrap gap-4">
          <a href="/projects" class="inline-flex items-center gap-2 px-6 py-3 bg-brand hover:bg-brand-dark text-white font-semibold rounded-lg transition-all duration-200 hover:shadow-lg hover:shadow-brand/25">
            看我做了什麼
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
          <a href="/about" class="inline-flex items-center gap-2 px-6 py-3 border border-zinc-700 hover:border-zinc-500 text-zinc-300 hover:text-zinc-100 font-semibold rounded-lg transition-all duration-200">
            更了解我
          </a>
          <a href="https://github.com/KJyang-0114" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 border border-zinc-700 hover:border-zinc-500 text-zinc-300 hover:text-zinc-100 font-semibold rounded-lg transition-all duration-200">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
            GitHub
          </a>
        </div>
      </div>
    </div>

    <div class="absolute top-0 right-0 w-1/2 h-full opacity-30 pointer-events-none" aria-hidden="true">
      <div class="absolute top-20 right-20 w-72 h-72 bg-brand/20 rounded-full blur-[120px]"></div>
      <div class="absolute bottom-20 right-40 w-56 h-56 bg-accent/20 rounded-full blur-[100px]"></div>
    </div>
  </section>

  <!-- What I Do -->
  <section class="py-20" aria-label="技術能力">
    <div class="section-container">
      <h2 class="animate-on-scroll text-3xl sm:text-4xl font-bold mb-4">
        我在搞什麼
      </h2>
      <p class="animate-on-scroll delay-1 text-zinc-400 mb-12 max-w-2xl">
        主力是 <strong class="text-zinc-200">AI / LLM 應用</strong> — 我很會利用 AI 工具來加速學習和開發。
        不只是會用，是真的有在研究怎麼整合進產品裡面。
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {techStack.map((group, i) => (
          <div class={`animate-on-scroll delay-${i + 1} p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800/50`}>
            <span class="text-2xl mb-3 block" aria-hidden="true">{group.icon}</span>
            <h3 class="text-lg font-semibold text-zinc-200 mb-4">{group.name}</h3>
            <div class="flex flex-wrap gap-2">
              {group.items.map(skill => (
                <span class="px-3 py-1.5 text-sm rounded-lg bg-zinc-800 text-zinc-300 border border-zinc-700/50">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Recent Stuff -->
  <section class="py-20" aria-label="最近在做的事">
    <div class="section-container">
      <h2 class="animate-on-scroll text-3xl sm:text-4xl font-bold mb-4">
        最近在忙的
      </h2>
      <p class="animate-on-scroll delay-1 text-zinc-400 mb-12 max-w-2xl">
        隨便挑幾個有在動的東西。完整的去 <a href="/projects" class="text-brand hover:text-brand-light underline underline-offset-4">作品集</a> 看。
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <article class="animate-on-scroll delay-1 group p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800/50 hover:border-purple-500/30 transition-all duration-300">
          <span class="px-3 py-1 text-xs font-mono rounded-full bg-purple-500/10 text-purple-400 border border-purple-500/20">AI</span>
          <h3 class="text-xl font-bold text-zinc-100 mt-4 mb-2 group-hover:text-brand transition-colors">Simple-2048-RL</h3>
          <p class="text-zinc-400 text-sm mb-4 leading-relaxed">
            用 DQN 訓練 AI 玩 2048。從環境建置到訓練 pipeline 全部自己刻，想試試看強化學習到底能不能打出高分。
          </p>
          <a href="https://github.com/KJyang-0114/Simple-2048-RL" target="_blank" rel="noopener noreferrer" class="text-sm text-zinc-500 hover:text-zinc-200 transition-colors font-mono">→ GitHub</a>
        </article>

        <article class="animate-on-scroll delay-2 group p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800/50 hover:border-cyan-500/30 transition-all duration-300">
          <span class="px-3 py-1 text-xs font-mono rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">工具</span>
          <h3 class="text-xl font-bold text-zinc-100 mt-4 mb-2 group-hover:text-brand transition-colors">Vox-Summary-Tool</h3>
          <p class="text-zinc-400 text-sm mb-4 leading-relaxed">
            錄音或丟音檔進去，Whisper 轉文字再用 GPT 整理成重點摘要。Flask + Docker 部署。
          </p>
          <a href="https://github.com/KJyang-0114/Vox-Summary-Tool" target="_blank" rel="noopener noreferrer" class="text-sm text-zinc-500 hover:text-zinc-200 transition-colors font-mono">→ GitHub</a>
        </article>

        <article class="animate-on-scroll delay-3 group p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800/50 hover:border-yellow-500/30 transition-all duration-300">
          <span class="px-3 py-1 text-xs font-mono rounded-full bg-yellow-500/10 text-yellow-400 border border-yellow-500/20">遊戲</span>
          <h3 class="text-xl font-bold text-zinc-100 mt-4 mb-2 group-hover:text-brand transition-colors">BridgeMaster</h3>
          <p class="text-zinc-400 text-sm mb-4 leading-relaxed">
            Minecraft Forge mod，自動幫你蓋橋。路徑演算法 + 遊戲開發的混血產物。
          </p>
          <a href="https://github.com/KJyang-0114/BridgeMaster" target="_blank" rel="noopener noreferrer" class="text-sm text-zinc-500 hover:text-zinc-200 transition-colors font-mono">→ GitHub</a>
        </article>

        <article class="animate-on-scroll delay-4 group p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800/50 hover:border-green-500/30 transition-all duration-300">
          <span class="px-3 py-1 text-xs font-mono rounded-full bg-green-500/10 text-green-400 border border-green-500/20">AI</span>
          <h3 class="text-xl font-bold text-zinc-100 mt-4 mb-2 group-hover:text-brand transition-colors">Nyx-Core</h3>
          <p class="text-zinc-400 text-sm mb-4 leading-relaxed">
            AI Vision Engine — 基於 YOLO 的物件偵測框架，支援 TensorRT 加速與 GUI 操作介面。5 人共同開發。
          </p>
          <a href="https://github.com/KJyang-0114/Nyx-Core" target="_blank" rel="noopener noreferrer" class="text-sm text-zinc-500 hover:text-zinc-200 transition-colors font-mono">→ GitHub</a>
        </article>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20" aria-label="聯絡方式">
    <div class="section-container">
      <div class="animate-on-scroll relative overflow-hidden rounded-3xl bg-gradient-to-br from-brand/10 to-accent/10 border border-brand/20 p-10 sm:p-16 text-center">
        <h2 class="text-3xl sm:text-4xl font-bold mb-4">
          聊聊？
        </h2>
        <p class="text-zinc-400 mb-8 max-w-lg mx-auto">
          想合作專案、聊技術、或有什麼有趣的想法，都歡迎找我。
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/contact" class="inline-flex items-center gap-2 px-8 py-4 bg-brand hover:bg-brand-dark text-white font-semibold rounded-xl transition-all duration-200 hover:shadow-lg hover:shadow-brand/25 text-lg">
            聯絡我
          </a>
          <a href="https://github.com/KJyang-0114" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-8 py-4 border border-zinc-700 hover:border-zinc-500 text-zinc-300 hover:text-zinc-100 font-semibold rounded-xl transition-all duration-200 text-lg">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
            GitHub
          </a>
        </div>

        <div class="absolute -top-10 -right-10 w-40 h-40 bg-brand/10 rounded-full blur-[60px]" aria-hidden="true"></div>
        <div class="absolute -bottom-10 -left-10 w-32 h-32 bg-accent/10 rounded-full blur-[50px]" aria-hidden="true"></div>
      </div>
    </div>
  </section>

</Layout>
