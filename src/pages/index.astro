---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = [
  {
    id: 1,
    name: '個人網站 (Astro 版)',
    description: '使用 Astro 框架開發的個人網站，具有更快的頁面載入速度和改進的使用者體驗。深色主題設計，完整的響應式布局。',
    tags: ['Astro', 'JavaScript', 'CSS', 'Static Site Generation', 'Open Source'],
    github: 'https://github.com/kjyang-0114/KJyang-website-astro',
    demo: null
  },
  {
    id: 2,
    name: 'BridgeMaster',
    description: '一個優化建橋控制和操作的Minecraft Forge模組 簡稱速疊',
    tags: ['Java', 'Game Development', 'Minecraft Mod', 'Open Source'],
    github: 'https://github.com/KJyang-0114/BridgeMaster',
    demo: null
  },
  {
    id: 14,
    name: 'OnlineClipboard',
    description: 'Vite+Tailwind+TypeScript 打造的線上剪貼簿/協作平台。',
    tags: [
      'Collaboration Tool',
      'TypeScript',
      'PWA',
      'Realtime Sync',
      'Open Source'
    ],
    github: 'https://github.com/kjyang-0114/online-clipboard',
    demo: 'https://kjyang-0114.github.io/online-clipboard/'
  }
];
---

<Layout title="首頁 - KJyang">
  <div class="smooth-wrapper">
    <section class="hero-section">
      <!-- 簡化的背景層 -->
      <div class="hero-bg">
        <div class="bg-gradient"></div>
      </div>
      
      <!-- 主要內容 -->
      <div class="hero-content">
        <div class="hero-text-container">
          <h1 class="hero-title">
            <span class="static-text">我是</span>
            <span class="highlight dynamic-text" id="dynamic-name">KJyang</span>
          </h1>
          <h2 class="hero-subtitle">
            <span class="subtitle-text" id="subtitle-text">一個用AI創造奇蹟的高中生</span>
          </h2>
          <p class="hero-description">
            <span class="description-text" id="description-text">代碼是我的超能力，Debug 是我的日常生活 🚀</span>
          </p>
          
          <div class="hero-specialties">
            <p class="specialty">專長：把簡單問題複雜化，然後優雅地解決它們 💻</p>
            <p class="specialty">熱愛在凌晨三點被靈感砸中，然後忘記睡覺</p>
            <p class="specialty">咖啡因驅動型開發者 - 一杯咖啡，一行代碼，無限可能！☕</p>
          </div>
          
          <div class="hero-links">
            <a href="/projects" class="primary-button">查看作品</a>
            <a href="/contact" class="secondary-button">聯絡我</a>
          </div>
        </div>
        
        <div class="hero-visual-container">
          <div class="profile-image" id="secret-game-trigger">
            <div class="profile-placeholder">
              <span class="profile-emoji">👨‍💻</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="projects-section">
      <div class="section-header">
        <h2 class="section-title">精選作品</h2>
        <div class="section-line"></div>
      </div>
      <div class="projects-grid">
        {projects.map((project, index) => (
          <div class="project-item" data-index={index}>
            <ProjectCard
              name={project.name}
              description={project.description}
              tags={project.tags}
              github={project.github}
              demo={project.demo}
            />
          </div>
        ))}
      </div>
      
      <div class="projects-cta">
        <a href="/projects" class="outline-button">
          查看所有作品 <i class="fas fa-arrow-right"></i>
        </a>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  
  // 註冊GSAP插件
  gsap.registerPlugin(ScrollTrigger);
  
  // 首頁小彩蛋 - 點擊頭像進入秘密游戲
  const secretGameTrigger = document.getElementById('secret-game-trigger');
  if (secretGameTrigger) {
    // 點擊次數計數器
    let clickCount = 0;
    const requiredClicks = 5; // 需要連續點擊5次才會觸發
    let clickTimer;
    
    // 添加游標為可點擊樣式
    secretGameTrigger.style.cursor = 'pointer';
    
    // 為了視覺反饋，添加懸停效果
    secretGameTrigger.addEventListener('mouseenter', () => {
      gsap.to(secretGameTrigger, {
        scale: 1.05,
        duration: 0.3,
        ease: 'power1.out'
      });
    });
    
    secretGameTrigger.addEventListener('mouseleave', () => {
      gsap.to(secretGameTrigger, {
        scale: 1,
        duration: 0.3,
        ease: 'power1.out'
      });
    });
    
    secretGameTrigger.addEventListener('click', () => {
      console.log('頭像被點擊了！計數：', clickCount + 1);
      clickCount++;
      
      // 清除先前的計時器
      if (clickTimer) {
        clearTimeout(clickTimer);
      }
      
      // 如果在2秒內完成了所需點擊次數，則觸發彩蛋
      if (clickCount >= requiredClicks) {
        console.log('觸發彩蛋！即將跳轉到秘密游戲');
        window.location.href = '/secret-game';
        clickCount = 0; // 重置計數器
        return;
      }
      
      // 如果這是第一次點擊，顯示提示
      if (clickCount === 1) {
        const tooltip = document.createElement('div');
        tooltip.className = 'secret-tooltip';
        tooltip.textContent = '繼續點擊...有驚喜！';
        document.body.appendChild(tooltip);
        
        // 獲取頭像位置
        const rect = secretGameTrigger.getBoundingClientRect();
        tooltip.style.left = `${rect.left + window.scrollX + rect.width / 2}px`;
        tooltip.style.top = `${rect.top + window.scrollY - 40}px`;
        
        // 2秒後移除提示
        setTimeout(() => {
          tooltip.classList.add('fade-out');
          setTimeout(() => {
            document.body.removeChild(tooltip);
          }, 500);
        }, 1500);
      }
      
      // 如果2秒內沒有達到所需點擊次數，則重置計數器
      clickTimer = setTimeout(() => {
        clickCount = 0;
      }, 2000);
      
      // 添加微小動畫反饋
      gsap.to(secretGameTrigger, {
        scale: 1.05,
        duration: 0.1,
        yoyo: true,
        repeat: 1,
        ease: 'power1.inOut'
      });
    });
  }
  
  // 頁面加載後執行動畫
  document.addEventListener('DOMContentLoaded', () => {
    // 打字機效果
    const dynamicName = document.getElementById('dynamic-name');
    const subtitleText = document.getElementById('subtitle-text');
    const descriptionText = document.getElementById('description-text');
    
    if (dynamicName) {
      const nameText = 'KJyang';
      let nameIndex = 0;
      
      function typeName() {
        if (nameIndex < nameText.length) {
          dynamicName.textContent = nameText.slice(0, nameIndex + 1);
          nameIndex++;
          setTimeout(typeName, 150);
        } else {
          // 打字完成後，移除游標
          setTimeout(() => {
            dynamicName.classList.add('typing-complete');
          }, 500);
        }
      }
      
      // 延遲開始打字
      setTimeout(typeName, 500);
    }
    
    // 確保所有元素都是可見的
    gsap.set(['.hero-title', '.hero-subtitle', '.hero-description', '.specialty', '.hero-links a', '.profile-image', '.project-item', '.section-title', '.section-line'], {
      opacity: 1,
      y: 0,
      x: 0,
      clearProps: 'all'
    });
    
    // 首頁的簡單淡入效果
    const mainContent = document.querySelector('main');
    if (mainContent) {
      gsap.fromTo(mainContent, 
        { opacity: 0 }, 
        { opacity: 1, duration: 0.5, ease: 'power1.inOut' }
      );
    }
    
    // 添加滾动觸發動畫
    const scrollElements = document.querySelectorAll('.project-item, .specialty');
    
    const elementInView = (el, dividend = 1) => {
      const elementTop = el.getBoundingClientRect().top;
      return (
        elementTop <= (window.innerHeight || document.documentElement.clientHeight) / dividend
      );
    };

    const elementOutofView = (el) => {
      const elementTop = el.getBoundingClientRect().top;
      return (
        elementTop > (window.innerHeight || document.documentElement.clientHeight)
      );
    };

    const displayScrollElement = (element) => {
      element.classList.add('scrolled');
    };

    const hideScrollElement = (element) => {
      element.classList.remove('scrolled');
    };

    const handleScrollAnimation = () => {
      scrollElements.forEach((el) => {
        if (elementInView(el, 1.25)) {
          displayScrollElement(el);
        } else if (elementOutofView(el)) {
          hideScrollElement(el);
        }
      });
    };

    window.addEventListener('scroll', () => {
      handleScrollAnimation();
    });
  });
</script>

<style>
  .smooth-wrapper {
    position: relative;
    width: 100%;
  }

  .hero-section {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    position: relative;
  }

  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: -1;
  }

  .bg-gradient {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
      radial-gradient(circle at 30% 30%, rgba(102, 126, 234, 0.08) 0%, transparent 60%),
      radial-gradient(circle at 70% 70%, rgba(240, 147, 251, 0.08) 0%, transparent 60%);
  }

  .hero-content {
    width: 100%;
    max-width: 1200px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4rem;
    z-index: 1;
  }

  .hero-text-container {
    flex: 1;
    max-width: 600px;
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 700;
    margin-bottom: 2rem;
    line-height: 1.1;
  }

  .static-text {
    color: var(--text-color);
  }

  .dynamic-text {
    background: var(--primary-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    position: relative;
  }

  .dynamic-text::after {
    content: '';
    position: absolute;
    right: -2px;
    top: 0;
    width: 2px;
    height: 100%;
    background: var(--primary-color);
    animation: blink 1s infinite;
  }

  .hero-subtitle {
    font-size: 2rem;
    font-weight: 500;
    color: var(--text-color);
    margin-bottom: 1.5rem;
    line-height: 1.3;
  }

  .hero-description {
    font-size: 1.2rem;
    color: var(--text-muted);
    margin-bottom: 3rem;
    line-height: 1.6;
  }

  .hero-specialties {
    margin-bottom: 3rem;
  }

  .specialty {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
    position: relative;
    opacity: 0;
    animation: fadeInUp 0.8s ease forwards;
  }

  .specialty:nth-child(1) { animation-delay: 0.2s; }
  .specialty:nth-child(2) { animation-delay: 0.4s; }
  .specialty:nth-child(3) { animation-delay: 0.6s; }

  .specialty::before {
    content: '▹';
    position: absolute;
    left: 0;
    color: var(--primary-color);
    font-size: 1.2rem;
  }

  .hero-links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .hero-visual-container {
    flex: 0 0 35%;
    max-width: 350px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .profile-image {
    width: 250px;
    height: 250px;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(99, 102, 241, 0.2));
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .profile-image:hover {
    transform: scale(1.05);
  }

  .profile-placeholder {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .profile-emoji {
    font-size: 6rem;
  }

  /* 項目區域樣式 */
  .projects-section {
    padding: 5rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-title {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    background: var(--primary-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .section-line {
    width: 80px;
    height: 4px;
    background: var(--primary-gradient);
    margin: 0 auto;
    border-radius: 2px;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
  }

  .project-item {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.6s ease;
  }

  .project-item.scrolled {
    opacity: 1;
    transform: translateY(0);
  }

  .projects-cta {
    text-align: center;
    margin-top: 4rem;
  }

  /* 動畫 */
  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(-10px);
    }
    60% {
      transform: translateY(-5px);
    }
  }

  /* 響應式設計 */
  @media (max-width: 768px) {
    .smooth-wrapper {
      width: 100%;
      max-width: 100vw;
      overflow-x: hidden;
    }

    .hero-section {
      padding: 1rem;
      width: 100%;
      max-width: 100vw;
      box-sizing: border-box;
    }

    .hero-content {
      flex-direction: column;
      text-align: center;
      gap: 3rem;
      width: 100%;
      max-width: 100vw;
      padding: 0 1rem;
      box-sizing: border-box;
    }

    .hero-text-container {
      width: 100%;
      max-width: 100%;
    }

    .hero-title {
      font-size: 2.5rem;
      width: 100%;
      word-wrap: break-word;
    }

    .hero-subtitle {
      font-size: 1.5rem;
      width: 100%;
      word-wrap: break-word;
    }

    .hero-description {
      font-size: 1.1rem;
      width: 100%;
      word-wrap: break-word;
    }

    .hero-specialties {
      width: 100%;
    }

    .specialty {
      width: 100%;
      text-align: center;
      word-wrap: break-word;
    }

    .hero-links {
      justify-content: center;
      width: 100%;
      flex-direction: column;
      align-items: center;
    }

    .hero-visual-container {
      width: 100%;
      max-width: 100%;
    }

    .profile-image {
      width: 200px;
      height: 200px;
      max-width: 90vw;
    }

    .profile-emoji {
      font-size: 4rem;
    }

    .projects-section {
      padding: 3rem 1rem;
      width: 100%;
      max-width: 100vw;
      box-sizing: border-box;
    }

    .projects-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
      width: 100%;
      padding: 0;
    }

    .project-item {
      width: 100%;
      max-width: 100%;
    }

    .section-title {
      font-size: 2rem;
      width: 100%;
      word-wrap: break-word;
    }
  }
</style>
