---
import PortfolioLayout from "../layouts/PortfolioLayout.astro";
import {
  resumeProjects,
  skillLevels,
  experience,
  workflow,
  aiUses,
  evidence,
  remote,
  collaboration,
  availability,
  interests,
} from "../data/resume";
import "../styles/resume.css";
const sections = [
  ["experience", "工作經歷"],
  ["selected-projects", "精選專案"],
  ["open-source", "開源參與"],
  ["skills", "技術能力"],
  ["approach", "工程方法"],
  ["remote", "遠端協作"],
  ["availability", "合作形式"],
  ["education", "教育背景"],
  ["links", "聯絡連結"],
];
---

<PortfolioLayout
  title="KJyang — Software Engineer | 履歷"
  description="KJyang 的軟體工程履歷：正式遠端開發經驗、Web、Backend、Developer Tooling 與 AI 系統整合。Taiwan UTC+8，開放遠端、兼職與專案合作。"
>
  <article class="resume">
    <header class="resume-hero">
      <p class="resume-eyebrow">KJYANG / CURRICULUM VITAE</p>
      <p class="resume-availability">Open to Remote / Contract / Part-time</p>
      <h1>KJyang <span>Software Engineer.</span></h1>
      <p class="resume-disciplines">
        Web · Backend · Developer Tools · AI Systems
      </p>
      <p class="resume-intro">
        專注於實際交付、系統整合與工程驗證的軟體開發者。曾正式任職於雲書苑教育科技有限公司，以完全遠端形式參與教育科技產品開發，並持續投入
        Web、Backend、Developer Tooling、AI-assisted Systems 與 Security
        相關專案。
      </p>
      <div class="resume-status">
        <span class="resume-dot" aria-hidden="true"></span> 開放合作 <span
          >／ Taiwan, UTC+8</span>
      </div>
      <p class="resume-open">
        Remote · Part-time · Contract / Project-based · Internship · Short-term
        Engineering Projects
      </p>
      <div class="resume-actions">
        <a href="mailto:hi@kjyang0114.dev">hi@kjyang0114.dev ↗</a><button
          type="button"
          id="print-resume">列印／另存 PDF ↓</button>
      </div>
      <noscript><p>可使用瀏覽器的「列印」功能，列印或另存 PDF。</p></noscript>
    </header>
    <div class="resume-layout">
      <nav class="resume-index" aria-label="履歷章節">
        <span>ON THIS PAGE</span>{
          sections.map(([id, label], i) => (
            <a href={`#${id}`}>
              <small>{String(i + 1).padStart(2, "0")}</small>
              {label}
            </a>
          ))
        }
      </nav>
      <div class="resume-content">
        <section id="experience">
          <p class="resume-eyebrow">01 / PROFESSIONAL EXPERIENCE</p><h2>
            工作經歷
          </h2>
          <div class="resume-entry">
            <h3>Software Developer</h3><p class="resume-company">
              雲書苑教育科技有限公司
            </p><p class="resume-meta">
              正式任職 · Fully Remote · <time datetime="2025-09">2025/9</time> — 2026 年初
            </p>
            <p>自 2025 年 9 月起正式任職於雲書苑教育科技有限公司，擔任 Software Developer；任職期間採完全遠端工作模式，參與商業產品開發、需求實作、除錯、測試與交付。</p>
            <p>
              由於受到 NDA
              約束，無法公開產品細節、內部架構、客戶資訊與部分技術實作內容。
            </p>
            <h4>可公開描述的工作經驗</h4><ul>
              {experience.map((item) => <li>{item}</li>)}
            </ul>
            <blockquote>
              Specific implementation details are confidential under NDA.
            </blockquote>
          </div>
        </section>
        <section id="selected-projects">
          <p class="resume-eyebrow">02 / SELECTED PROJECTS</p><h2>精選專案</h2>
          {
            resumeProjects.map((project) => (
              <div class="resume-entry">
                <h3><a href={project.href}>{project.name} <span aria-hidden="true">↗</span></a></h3>
                <p class="resume-meta">{project.category}</p>
                <p>{project.description}</p>
                <ul
                  class:list={[{ "resume-columns": project.points.length > 7 }]}
                >
                  {project.points.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
                {project.tech && (
                  <p class="resume-tech">
                    <strong>核心技術</strong>
                    <br />
                    {project.tech}
                  </p>
                )}
                {project.note && <p>{project.note}</p>}
              </div>
            ))
          }
        </section>
        <section id="open-source">
          <p class="resume-eyebrow">03 / OPEN SOURCE</p><h2>開源參與</h2><p>
            持續參與開源專案，並透過實際 contribution 熟悉既有大型
            codebase、repository conventions 與 review workflow。
          </p>
          <div class="resume-entry">
            <h3>lodash</h3><p>
              曾針對既有程式行為與文件一致性進行修改與 contribution。
            </p><ul>
              {
                [
                  "閱讀成熟 JavaScript codebase",
                  "理解既有 API 行為",
                  "修改既有實作",
                  "依照 upstream project 規範提交變更",
                ].map((item) => <li>{item}</li>)
              }
            </ul>
          </div>
          <div class="resume-entry">
            <h3>highlight.js</h3><p>
              曾參與 highlight.js 相關開源 contribution。
            </p>
          </div>
          <div class="resume-entry">
            <h3>Aegis</h3><p>曾參與 AI Agent Security / EDR 相關開源專案。</p>
          </div>
        </section>
        <section id="skills">
          <p class="resume-eyebrow">04 / TECHNICAL SKILLS</p><h2>
            技術能力
          </h2><div>
            {
              skillLevels.map((level) => (
                <div class="resume-skill-level">
                  <h3>{level.name}</h3>
                  <p class="resume-meta">{level.description}</p>
                  <div class="resume-skills">
                    {level.groups.map((group) => (
                      <div>
                        <h4>{group.name}</h4>
                        <ul>{group.items.map(item => <li>{item}</li>)}</ul>
                      </div>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </section>
        <section id="approach">
          <p class="resume-eyebrow">05 / ENGINEERING APPROACH</p><h2>
            用行為與證據，驗證實作。
          </h2><p>
            我的開發流程不是單純依賴 AI 生成程式碼，而是把 AI 作為工程效率工具。
          </p><h3>常見工作流程</h3><ol class="resume-workflow">
            {workflow.map((item) => <li>{item}</li>)}
          </ol><div class="resume-pair">
            <div>
              <h3>AI 主要用於</h3><ul>
                {aiUses.map((item) => <li>{item}</li>)}
              </ul>
            </div><div>
              <h3>最終驗證依據</h3><ul>
                {evidence.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
        </section>
        <section id="remote">
          <p class="resume-eyebrow">06 / REMOTE WORK</p><h2>遠端協作</h2><p>
            曾正式任職於雲書苑教育科技有限公司，任職期間以完全遠端形式進行開發與協作，具備實際商業專案的遠端交付經驗。
          </p><div class="resume-pair">
            <div>
              <h3>熟悉的工作方式</h3><ul>
                {remote.map((item) => <li>{item}</li>)}
              </ul>
            </div><div>
              <h3>可配合</h3><ul>
                {collaboration.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
        </section>
        <section id="availability">
          <p class="resume-eyebrow">07 / AVAILABILITY</p><h2>合作形式</h2><div
            class="resume-pair"
          >
            <div>
              <h3>目前開放</h3><ul>
                {availability.map((item) => <li>{item}</li>)}
              </ul>
            </div><div>
              <h3>偏好工作內容</h3><ul>
                {interests.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
        </section>
        <section id="education">
          <p class="resume-eyebrow">08 / EDUCATION</p><h2>教育背景</h2><h3>
            鶯歌工商 — 資訊科
          </h3><p>
            Currently Senior High School Student<br />Expected Graduation: 2027
          </p><p>
            目前主要投入軟體工程、個人專案、開源 contribution 與實際開發工作。
          </p>
        </section>
        <section id="links">
          <p class="resume-eyebrow">09 / LINKS</p><h2>保持聯絡</h2><dl
            class="resume-links"
          >
            <div>
              <dt>GitHub</dt><dd>
                <a href="https://github.com/KJyang-0114"
                  >github.com/KJyang-0114 ↗</a>
              </dd>
            </div><div>
              <dt>Portfolio</dt><dd>
                <a href="https://kjyang0114.dev">kjyang0114.dev ↗</a>
              </dd>
            </div><div>
              <dt>Email</dt><dd>
                <a href="mailto:hi@kjyang0114.dev">hi@kjyang0114.dev ↗</a>
              </dd>
            </div><div>
              <dt>LinkedIn</dt><dd>
                <a href="https://www.linkedin.com/in/kjyang0114/"
                  >linkedin.com/in/kjyang0114 ↗</a>
              </dd>
            </div>
          </dl>
        </section>
      </div>
    </div>
  </article>
</PortfolioLayout>
<script>
  document
    .querySelector("#print-resume")
    ?.addEventListener("click", () => window.print());
</script>
