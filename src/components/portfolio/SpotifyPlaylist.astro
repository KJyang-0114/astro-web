---
interface Props { title: string; url: string; note?: string }
const { title, url, note } = Astro.props;
const parsed = new URL(url);
const match = parsed.pathname.match(/^\/(?:intl-[a-z-]+\/)?playlist\/([A-Za-z0-9]{22})\/?$/);
if (parsed.protocol !== "https:" || parsed.hostname !== "open.spotify.com" || !match) {
  throw new Error("SpotifyPlaylist requires a public open.spotify.com/playlist link.");
}
const canonical = `https://open.spotify.com/playlist/${match[1]}`;
const embed = `https://open.spotify.com/embed/playlist/${match[1]}?utm_source=generator&theme=0`;
---
<article class="spotify-playlist">
  <span class="playlist-label">SELECTED PLAYLIST / SPOTIFY</span>
  <header><h3>{title}</h3><a href={canonical} target="_blank" rel="noopener noreferrer">在 Spotify 開啟 ↗</a></header>
  {note && <p>{note}</p>}
  <iframe src={embed} title={`${title} — Spotify 歌單播放器`} width="100%" height="352" loading="lazy" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
</article>
<style>
  .spotify-playlist{margin:0;min-width:0;padding:22px;background:var(--panel);border:1px solid var(--line);border-radius:16px}
  .playlist-label{display:block;font-size:10px;letter-spacing:.1em;color:var(--muted);margin-bottom:18px}
  header{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
  h3{font-size:18px;font-weight:500;margin:0}a{font-size:12px;color:var(--accent)}
  p{color:var(--muted);font-size:14px;line-height:1.8}
  iframe{display:block;border:0;border-radius:12px;margin-top:20px;width:100%;height:352px;color-scheme:normal;background:#282828}
  @media(max-width:600px){.spotify-playlist{padding:14px;border-radius:14px}header{gap:10px}a{font-size:11px}}
</style>
