---
const current = Astro.url.pathname.replace(/\/$/, "");
const english = current.startsWith('/studio/en');
const base = english ? '/studio/en' : '/studio';
const links = english ? [["Services", "/studio/en/services"], ["Pricing", "/studio/en/pricing"], ["Demos", "/studio/en/demo"], ["中文", "/studio"]] : [["作品", "/studio/work"], ["價格", "/studio/pricing"], ["流程", "/studio/process"], ["關於我", "/studio/about"]];
---
<header class="navigation">
<a class="wordmark" href={base} aria-label={english?'KJyang Studio home':'KJyang Studio 首頁'}>KJyang<span>studio</span></a>
<span class="nav-note">{english?'Websites for small businesses in Taiwan':'小店網站・預約系統'}</span>
<nav aria-label={english?'Studio navigation':'Studio 主選單'}>{links.map(([label,href])=><a href={href} aria-current={current===href?'page':undefined}>{label}</a>)}<a class="contact-link" href={`${base}/contact`}>{english?'Contact':'LINE 聯絡'} <span>↗</span></a></nav>
<details class="studio-mobile-menu"><summary>{english?'Menu ＋':'選單 ＋'}</summary><nav aria-label={english?'Studio mobile navigation':'Studio 手機選單'}>{links.map(([label,href])=><a href={href}>{label}</a>)}{!english&&<><a href="/studio/services">服務</a><a href="/studio/insights">文章</a></>}<a href={`${base}/contact`}>{english?'Contact':'聯絡'}</a></nav></details>
</header>
