---

<footer class="mt-32 border-t border-zinc-800/30 bg-zinc-950/50 backdrop-blur-sm relative overflow-hidden">
  <!-- Decorative background -->
  <div class="absolute inset-0 bg-grid opacity-20 pointer-events-none"></div>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-3xl h-1 bg-gradient-to-r from-transparent via-brand/50 to-transparent"></div>

  <div class="section-container py-16 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
      <div class="md:col-span-2 space-y-6">
        <a href="/" class="flex items-center gap-2 group">
           <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-brand to-accent flex items-center justify-center text-white text-xs font-bold shadow-lg shadow-brand/20 group-hover:scale-110 transition-transform">KJ</div>
           <span class="text-xl font-bold tracking-tight text-zinc-100">KJyang</span>
        </a>
        <p class="text-zinc-400 max-w-sm leading-relaxed">
          來自鶯歌工商資訊科。<br/>
          致力於將 AI 與現代 Web 技術結合，創造有溫度的數位體驗。
        </p>
        <div class="flex gap-4">
          {links.map(link => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-zinc-400 hover:text-white hover:bg-brand transition-all duration-300 hover:scale-110"
              aria-label={link.name}
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <Fragment set:html={link.icon} />
              </svg>
            </a>
          ))}
        </div>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-zinc-100 uppercase tracking-wider mb-6">探索</h3>
        <ul class="space-y-4" role="list">
          <li><a href="/projects" class="text-zinc-400 hover:text-brand transition-colors flex items-center gap-2 group"><span class="w-1 h-1 rounded-full bg-zinc-600 group-hover:bg-brand transition-colors"></span>作品集</a></li>
          <li><a href="/ai" class="text-zinc-400 hover:text-brand transition-colors flex items-center gap-2 group"><span class="w-1 h-1 rounded-full bg-zinc-600 group-hover:bg-brand transition-colors"></span>AI 探索</a></li>
          <li><a href="/studio" class="text-zinc-400 hover:text-brand transition-colors flex items-center gap-2 group"><span class="w-1 h-1 rounded-full bg-zinc-600 group-hover:bg-brand transition-colors"></span>KJyang Studio</a></li>
          <li><a href="/about" class="text-zinc-400 hover:text-brand transition-colors flex items-center gap-2 group"><span class="w-1 h-1 rounded-full bg-zinc-600 group-hover:bg-brand transition-colors"></span>關於我</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-zinc-100 uppercase tracking-wider mb-6">更多</h3>
        <ul class="space-y-4" role="list">
          <li><a href="/contact" class="text-zinc-400 hover:text-brand transition-colors flex items-center gap-2 group"><span class="w-1 h-1 rounded-full bg-zinc-600 group-hover:bg-brand transition-colors"></span>聯絡我</a></li>
          <li><a href="https://github.com/KJyang-0114" target="_blank" class="text-zinc-400 hover:text-brand transition-colors flex items-center gap-2 group"><span class="w-1 h-1 rounded-full bg-zinc-600 group-hover:bg-brand transition-colors"></span>GitHub</a></li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-white/5 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-sm text-zinc-500">
        &copy; {currentYear} KJyang. All rights reserved.
      </p>
      <div class="flex items-center gap-6 text-sm text-zinc-600">
        <span>Built with Astro & Tailwind</span>
        <span class="w-1 h-1 rounded-full bg-zinc-700"></span>
        <span>Deployed on Docker</span>
      </div>
    </div>
  </div>
</footer>
