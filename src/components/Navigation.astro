---
const pathname = new URL(Astro.request.url).pathname;
// 移除尾部斜槓以便於比較
const currentPath = pathname.replace(/\/$/, "");

// 確保所有導航鏈接沒有尾部斜槓
const navItems = [
  { name: "首頁", path: "/" },
  { name: "關於我", path: "/about" },
  { name: "作品集", path: "/projects" },
  { name: "聯絡我", path: "/contact" },
  { name: "AI 探索", path: "/ai" },
];
---

<header class="site-header" transition:name="main-header">
  <div class="container">
    <div class="logo">
      <a href="/">KJ<span>y</span>ang</a>
    </div>

    <nav class="main-nav">
      <div class="desktop-nav">
        {
          navItems.map(({ name, path }) => (
            <a
              href={path}
              class={`nav-item ${currentPath === path ? "active" : ""}`}
            >
              {name}
            </a>
          ))
        }
      </div>

      <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle menu">
        <i class="fas fa-bars"></i>
      </button>
    </nav>
  </div>

  <div class="mobile-nav" id="mobileNav">
    {
      navItems.map(({ name, path }) => (
        <a
          href={path}
          class={`nav-item ${currentPath === path ? "active" : ""}`}
        >
          {name}
        </a>
      ))
    }
  </div>
</header>

<script>
  function initMobileMenu() {
    const menuToggle = document.getElementById('mobileMenuToggle');
    const mobileNav = document.getElementById('mobileNav');

    if (!menuToggle || !mobileNav) {
      console.error('Mobile menu elements not found');
      return;
    }

    const toggleMenu = (forceClose = false) => {
      const navItems = mobileNav.querySelectorAll('.nav-item');
      const isActive = mobileNav.classList.contains('active');
      const openMenu = !isActive && !forceClose;

      // Toggle active classes for nav and button
      if (forceClose) {
        mobileNav.classList.remove('active');
        menuToggle.classList.remove('active');
      } else {
        mobileNav.classList.toggle('active');
        menuToggle.classList.toggle('active');
      }

      // Update icon
      const icon = menuToggle.querySelector('i');
      if (icon) {
        if (openMenu) {
          icon.classList.remove('fa-bars');
          icon.classList.add('fa-times');
        } else {
          icon.classList.remove('fa-times');
          icon.classList.add('fa-bars');
        }
      }

      // Handle item animations
      if (openMenu) {
        // 1. Reset inline styles to ensure items start from CSS initial state
        navItems.forEach(item => {
          const htmlItem = item as HTMLElement;
          htmlItem.removeAttribute('style'); // Remove any previous inline styles
        });

        // 2. Trigger staggered animation by setting final styles with delay
        // Use setTimeout directly after adding 'active' class (which changes display)
        navItems.forEach((item, index) => {
          const htmlItem = item as HTMLElement;
          setTimeout(() => {
            // Apply final styles directly, relying on CSS transition
            htmlItem.style.opacity = '1';
            htmlItem.style.transform = 'translateY(0)';
          }, 50 + index * 50); // Start first item after 50ms, then stagger
        });
      } else {
        // Reset inline styles when closing
        navItems.forEach(item => {
          const htmlItem = item as HTMLElement;
          htmlItem.removeAttribute('style'); // Reset for next open
        });
      }
    }; // End of toggleMenu function

    // Event listener for the toggle button
    menuToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    // Event listener for clicking nav items inside the mobile menu
    mobileNav.querySelectorAll('.nav-item').forEach(item => {
      item.addEventListener('click', () => {
        if (mobileNav.classList.contains('active')) {
           toggleMenu(true); // Force close
        }
      });
    });

    // Event listener for clicking outside the menu
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest('.mobile-nav') && !target.closest('.mobile-menu-toggle') && mobileNav.classList.contains('active')) {
         toggleMenu(true); // Force close
      }
    });

  } // End of initMobileMenu function

  // Ensure DOM is ready before initializing
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileMenu);
  } else {
    initMobileMenu();
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    padding: 1.5rem 0;
    width: 100%;
    backdrop-filter: blur(10px);
    background: rgba(26, 26, 26, 0.85); /* 使用更明亮的背景色 */
    z-index: 100;
    transition: all var(--transition-normal);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo a {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--text-color);
    text-decoration: none;
  }

  .logo span {
    color: var(--primary-color);
  }

  .main-nav {
    display: flex;
    align-items: center;
  }

  .desktop-nav {
    display: flex;
    gap: 2rem;
  }

  .nav-item {
    font-size: 1.1rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition-normal); /* Only transition color by default */
    position: relative;
  }

  .nav-item:hover {
    color: var(--text-color);
  }

  .nav-item.active {
    color: var(--primary-color);
  }

  .nav-item.active::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--primary-color);
    border-radius: 2px;
  }

  .mobile-menu-toggle {
    display: none; /* 桌面端隱藏 */
    background: var(--glass-bg);
    backdrop-filter: blur(10px);
    border: 1px solid var(--glass-border);
    border-radius: 8px;
    color: var(--text-muted);
    font-size: 1.2rem;
    cursor: pointer;
    transition: all var(--transition-normal);
    padding: 0.5rem;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .mobile-menu-toggle::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(102, 126, 234, 0.1), transparent);
    transition: left 0.5s;
  }

  .mobile-menu-toggle:hover {
    color: var(--text-color);
    border-color: rgba(102, 126, 234, 0.3);
    transform: scale(1.05);
  }

  .mobile-menu-toggle:hover::before {
    left: 100%;
  }

  .mobile-menu-toggle.active {
    color: var(--primary-color);
    border-color: var(--primary-color);
    box-shadow: 0 0 15px rgba(102, 126, 234, 0.3);
  }

  .mobile-nav {
    display: none; /* Initially hidden */
    position: fixed;
    top: 76px; /* Adjust based on header height */
    left: 0;
    right: 0;
    background: var(--card-background);
    padding: 2rem;
    flex-direction: column;
    gap: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
    transform: translateY(-10px); /* Slight initial offset for the container */
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.3s ease; /* Container transition */
    pointer-events: none;
    z-index: 101;
    overflow: hidden; /* Hide overflowing items during transition */
  }

  /* Style for individual items inside mobile nav - Base State & Transition Definition */
  .mobile-nav .nav-item {
    opacity: 0;
    transform: translateY(10px);
    /* Define transition properties here, ensure delay is 0 initially */
    transition: opacity 0.3s ease 0s, transform 0.3s ease 0s;
  }

  .mobile-nav.active {
    display: flex; /* Make it visible when active */
    transform: translateY(0); /* Bring container into view */
    opacity: 1;
    pointer-events: auto;
  }

  /* Remove any rules targeting .mobile-nav.active .nav-item or :nth-child delays */

  @media (max-width: 768px) {
    .container {
      padding: 0 1rem;
    }

    .logo a {
      font-size: 1.5rem;
    }

    .desktop-nav {
      display: none;
    }

    .mobile-menu-toggle {
      display: flex;
      z-index: 102; /* 確保在最上層 */
    }

    .mobile-nav {
      top: 80px; /* 調整頂部間距 */
      left: 1rem;
      right: 1rem;
      margin: 0 auto;
      max-width: calc(100vw - 2rem);
      border-radius: 12px;
    }

    .mobile-nav .nav-item {
      text-align: center;
      padding: 1rem;
      border-radius: 8px;
      transition: all 0.3s ease;
    }

    .mobile-nav .nav-item:hover {
      background: var(--glass-bg);
      transform: translateY(-2px);
    }
  }
</style>
