---
import StudioNav from "@components/StudioNav.astro";
import SiteShell from "@components/SiteShell.astro";
import BookingMock from "./BookingMock.astro";
import { absoluteStudioUrl, founderPerson } from "@data/seo";
import { getRealCase, realCases } from "@data/cases";
import { studioContact } from "@data/studio";

const { slug } = Astro.props;
const item = getRealCase(slug);
const others = realCases.filter((c) => c.slug !== slug);
const pageUrl = absoluteStudioUrl(`/studio/work/${item.slug}`);
const projectUrl = item.projectSlug ? `/projects/${item.projectSlug}` : undefined;
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "@id": `${pageUrl}#work`,
    name: item.name,
    description: item.summary,
    url: pageUrl,
    mainEntityOfPage: pageUrl,
    inLanguage: "zh-Hant",
    genre: item.kind,
    creativeWorkStatus: item.status,
    keywords: item.stack.join(", "),
    author: founderPerson,
    creator: { "@id": founderPerson["@id"] },
    ...(item.url || projectUrl
      ? { sameAs: [item.url, projectUrl && absoluteStudioUrl(projectUrl)].filter(Boolean) }
      : {})
  }
];
---
<SiteShell title={item.seoTitle ? `${item.seoTitle} — KJyang Studio` : `${item.name}｜真實作品 — KJyang Studio`} description={item.seoDescription ?? item.summary.slice(0, 120)} canonicalPath={`/studio/work/${item.slug}`} schema={schema} breadcrumbs={[["KJyang Studio", "/studio"], ["作品", "/studio/work"], [item.name, `/studio/work/${item.slug}`]]}>
  <main class="studio-index s-case">
    <StudioNav />
    <header class="s-wrap s-case-hero">
      <a class="s-back" href="/studio/work">← 所有作品</a>
      <p class="s-eyebrow">真實作品・{item.kind}</p>
      <h1>{item.name}</h1>
      <p class="s-lead">{item.summary}</p>
      <p class="s-status"><b>目前狀態</b>{item.status}</p>
      <p class="s-links">{item.url && <a class="s-link" href={item.url} rel="noopener" target="_blank">打開網站 ↗</a>}{item.links?.map(([label, href]) => <a class="s-link" href={href} rel="noopener" target="_blank">{label} ↗</a>)}{projectUrl && <a class="s-link" href={projectUrl}>個人網站上的作品頁</a>}</p>
      <dl class="s-facts">{item.facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
    </header>
    {item.slug === "spa-booking-system" && (
      <section class="s-wrap s-case-visual" aria-label="預約流程示意">
        <BookingMock />
        <p class="s-note">示意畫面，用示範資料重畫，不是店家的真實預約。</p>
      </section>
    )}
    <div class="s-wrap s-case-body">
      <div>
        {item.sections.map((s) => (
          <section>
            <h2>{s.title}</h2>
            {s.body.map((p) => <p>{p}</p>)}{s.items && <ol class="s-case-items">{s.items.map(([t, text]) => <li><h3>{t}</h3><p>{text}</p></li>)}</ol>}
          </section>
        ))}
      </div>
      <aside class="s-side">
        <h2>這次學到的</h2>
        <ul>{item.lessons.map((l) => <li>{l}</li>)}</ul>
        <h2>用到的工具</h2>
        <p class="s-tags">{item.stack.map((t) => <span>{t}</span>)}</p>
      </aside>
    </div>
    <section class="s-wrap s-cta-band">
      <h2>{item.cta?.title ?? "你的店也有類似的麻煩？"}</h2>
      <p>{item.cta?.text ?? "傳店名或 IG 給我，我先免費看一次，回你 3 個可以馬上改的地方。"}</p>
      <div class="s-actions">
        <a class="s-btn s-btn-primary" href={studioContact.lineUrl} data-cta={`case-${item.slug}-line`}>LINE 傳給我</a>
        <a class="s-btn" href="/studio/pricing">看價格</a>
      </div>
    </section>
    <nav class="s-wrap s-more" aria-label="其他作品">
      {others.map((o) => <a href={`/studio/work/${o.slug}`}><small>{o.kind}</small><b>{o.name} →</b></a>)}
    </nav>
  </main>
</SiteShell>
