---
const { english = false } = Astro.props;
const links = english ? [["Services","/studio/en/services"],["Pricing","/studio/en/pricing"],["Demos","/studio/en/demo"],["Contact","/studio/en/contact"],["中文","/studio"],["About KJyang","/about"]] : [["作品","/studio/work"],["服務","/studio/services"],["價格","/studio/pricing"],["流程","/studio/process"],["設計筆記","/studio/insights"],["關於","/studio/about"],["English","/studio/en"],["楊凱捷 / 個人網站 ↗","/"]];
---
<footer class="atelier-footer">
<span>LET’S MAKE IT YOURS.</span><h2>{english ? 'A place for your next idea.' : '下一個樣子，從你的想法開始。'}</h2>
<a href={english ? '/studio/en/contact' : '/studio/contact'}>{english ? 'Tell me about your website' : '聊聊你的網站'} ↗</a>
<nav class="atelier-footer-links" aria-label="Studio footer">{links.map(([label,href])=><a href={href}>{label}</a>)}</nav>
<div class="footer-meta"><span>© {new Date().getFullYear()} KJyang Studio · Taiwan</span><a href="mailto:hi@kjyang0114.dev">hi@kjyang0114.dev ↗</a></div>
</footer>
