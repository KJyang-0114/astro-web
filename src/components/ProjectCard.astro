---
export interface Props {
  name: string;
  description: string;
  tags: string[];
  github?: string | null;
  demo?: string | null;
}

const { name, description, tags, github, demo } = Astro.props;
---

<div class="project-card">
  <div class="project-header">
    <h3 class="project-title">{name}</h3>
    <div class="project-links">
      {demo && (
        <a href={demo} target="_blank" class="project-link" aria-label="Live demo">
          <i class="fas fa-external-link-alt"></i>
        </a>
      )}
      {github && (
        <a href={github} target="_blank" class="project-link" aria-label="GitHub repository">
          <i class="fab fa-github"></i>
        </a>
      )}
    </div>
  </div>
  <p class="project-description">{description}</p>
  <div class="project-tags">
    {tags.map((tag) => (
      <span class="project-tag">{tag}</span>
    ))}
  </div>
</div>

<style>
  .project-card {
    background: var(--glass-bg);
    backdrop-filter: blur(15px);
    border-radius: 16px;
    padding: 2rem;
    border: 1px solid var(--glass-border);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: var(--glass-shadow);
    position: relative;
    overflow: hidden;
  }

  .project-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--primary-gradient);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .project-card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: var(--hover-shadow);
    border-color: rgba(102, 126, 234, 0.3);
  }

  .project-card:hover::before {
    opacity: 1;
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .project-title {
    font-size: 1.8rem;
    font-weight: 500;
    color: var(--text-color);
    margin: 0;
    background: var(--primary-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .project-links {
    display: flex;
    gap: 0.5rem;
  }

  .project-link {
    color: var(--text-muted);
    font-size: 1.2rem;
    transition: all 0.3s ease;
    padding: 0.4rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
  }

  .project-link:hover {
    color: var(--primary-color);
    background: rgba(102, 126, 234, 0.1);
    border-color: rgba(102, 126, 234, 0.3);
    transform: scale(1.05);
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.2);
  }

  .project-description {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .project-tag {
    padding: 0.5rem 1rem;
    background: var(--glass-bg);
    backdrop-filter: blur(10px);
    border: 1px solid var(--glass-border);
    border-radius: 2rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    transition: all 0.3s ease;
  }

  .project-tag:hover {
    background: var(--primary-gradient);
    color: white;
    transform: translateY(-2px);
    box-shadow: var(--glow-primary);
  }

  /* 手機端響應式設計 */
  @media (max-width: 768px) {
    .project-card {
      padding: 1.5rem;
      margin: 0 auto;
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
    }

    .project-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .project-title {
      font-size: 1.5rem;
      width: 100%;
    }

    .project-links {
      align-self: flex-end;
      margin-top: 0;
    }

    .project-description {
      font-size: 1rem;
      line-height: 1.5;
    }

    .project-tags {
      gap: 0.5rem;
    }

    .project-tag {
      font-size: 0.8rem;
      padding: 0.4rem 0.8rem;
    }
  }
</style>
