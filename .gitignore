# Ignore everything by default
/*

# Keep git metadata and this file
!/.gitignore
!/.gitattributes

# --- Whitelist project files (allow these into git) ---
!/src/
!/public/
!/.github/
!/.dockerignore
!/Dockerfile
!/docker-compose.yml
!/astro.config.mjs
!/package.json
!/package-lock.json
!/pnpm-lock.yaml
!/yarn.lock
!/tsconfig.json
!/vite.config.js
!/README.md
!/rebuild-docker.sh

# --- Ignore generated/editor files inside whitelisted trees ---
**/.DS_Store
/public/_assets/
/src/styles/*.bad.*

# Notes:
# - Everything else in the repo root is ignored unless explicitly whitelisted above.
# - Build outputs, caches, node_modules, logs, editor settings are therefore ignored.
