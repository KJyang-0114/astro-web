# Ignore everything by default
/*

# Keep git metadata and this file
!/.gitignore
!/.gitattributes

# --- Whitelist website files (allow these into git) ---
!/src/
!/public/
!/astro.config.mjs
!/package.json
!/package-lock.json
!/pnpm-lock.yaml
!/yarn.lock
!/vite.config.js
!/README.md

# If you add other config files you need, whitelist them here

# Notes:
# - Everything else in the repo root is ignored unless explicitly whitelisted above.
# - Build outputs, caches, node_modules, logs, editor settings are therefore ignored.